<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="KubernetesCreateIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test kubernetes container command execution with kubernetes client.</description>
  <variables>
    <variable name="podLabel" value="server=hello-netty"/>
    <variable name="serviceLabel" value="service=hello-netty"/>
    <variable name="randomId" value="citrus:randomNumber(10)-citrus:lowerCase(citrus:randomString(4))"/>
  </variables>
  <actions>
    <echo>
      <message>Create new pod from template</message>
    </echo>
    <kubernetes auto-remove="false" client="k8sClient" namespace="${namespace}">
      <create-resource file="classpath:templates/hello-netty.yml"/>
    </kubernetes>
    <echo>
      <message>List pods by '${podLabel}'</message>
    </echo>
    <repeat-on-error auto-sleep="1000" until="@assertThat(greaterThan(9))@">
      <actions>
        <kubernetes client="k8sClient">
          <execute>
            <list-pods label="${podLabel}">
              <validate path="$.result.items.size()" value="1"/>
              <validate path="$..status.phase" value="@assertThat(anyOf(is(Running),is('')))@"/>
            </list-pods>
          </execute>
        </kubernetes>
      </actions>
    </repeat-on-error>
    <echo>
      <message>Create new service from template</message>
    </echo>
    <kubernetes auto-remove="false" client="k8sClient" namespace="${namespace}">
      <create-resource file="classpath:templates/hello-service.yml"/>
    </kubernetes>
    <echo>
      <message>List services by '${serviceLabel}'</message>
    </echo>
    <kubernetes client="k8sClient">
      <execute>
        <list-services label="${serviceLabel}">
          <validate path="$.result.items.size()" value="1"/>
        </list-services>
      </execute>
    </kubernetes>
    <kubernetes client="k8sClient">
      <delete-pod label="server=hello-netty"/>
    </kubernetes>
    <!-- MIGRATION WARNING: The result validation of 'k8s:delete-service' is not supported by the delete action in the plain XML DSL and has been removed -->
    <kubernetes client="k8sClient">
      <delete-service name="hello-netty"/>
    </kubernetes>
    <repeat-on-error auto-sleep="500" until="@assertThat(greaterThan(9))@">
      <actions>
        <kubernetes client="k8sClient">
          <execute>
            <list-pods label="server=hello-netty">
              <validate path="$.result.items.size()" value="0"/>
            </list-pods>
          </execute>
        </kubernetes>
      </actions>
    </repeat-on-error>
  </actions>
</test>
