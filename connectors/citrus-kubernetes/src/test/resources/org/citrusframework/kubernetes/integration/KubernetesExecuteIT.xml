<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="KubernetesExecuteIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test kubernetes container command execution with kubernetes client.</description>
  <variables>
    <variable name="podLabel" value="run=hello-minikube"/>
  </variables>
  <actions>
    <echo>
      <message>Validate kubernetes API version</message>
    </echo>
    <kubernetes client="k8sClient">
      <execute>
        <info result="{&#10;              &quot;result&quot;: {&#10;                &quot;clientVersion&quot;: &quot;@ignore@&quot;,&#10;                &quot;apiVersion&quot;: &quot;${apiVersion}&quot;,&#10;                &quot;kind&quot;:&quot;Info&quot;,&#10;                &quot;masterUrl&quot;: &quot;@matches('http://(kubernetes\\.docker\\.internal|localhost):[0-9]+/')@&quot;,&#10;                &quot;namespace&quot;: &quot;${namespace}&quot;&#10;              }&#10;            }"/>
      </execute>
    </kubernetes>
    <echo>
      <message>List all pods</message>
    </echo>
    <create-variables>
      <variable name="randomId" value="citrus:randomNumber(10)-citrus:lowerCase(citrus:randomString(4))"/>
    </create-variables>
    <kubernetes auto-remove="false" client="k8sClient" namespace="${namespace}">
      <create-resource file="classpath:templates/hello-netty.yml"/>
    </kubernetes>
    <kubernetes client="k8sClient">
      <execute>
        <list-pods result="{&#10;              &quot;result&quot;: {&#10;                &quot;apiVersion&quot;: &quot;v1&quot;,&#10;                &quot;kind&quot;: &quot;PodList&quot;,&#10;                &quot;items&quot;:[&#10;                  citrus:readFile('templates/pod.json')&#10;                ]&#10;              }&#10;            }">
          <validate path="$.result.items.size()" value="1"/>
          <validate path="$..status.phase" value="@assertThat(anyOf(is(Running),is('')))@"/>
          <validate path="$..metadata.name" value="@variable('podName')@"/>
        </list-pods>
      </execute>
    </kubernetes>
    <echo>
      <message>List all services</message>
    </echo>
    <kubernetes auto-remove="false" client="k8sClient" namespace="${namespace}">
      <create-resource file="classpath:templates/hello-service.yml"/>
    </kubernetes>
    <kubernetes client="k8sClient">
      <execute>
        <list-services result="{&#10;              &quot;result&quot;: {&#10;                &quot;apiVersion&quot;: &quot;v1&quot;,&#10;                &quot;kind&quot;: &quot;ServiceList&quot;,&#10;                &quot;items&quot;:[&#10;                  citrus:readFile('templates/service.json')&#10;                ]&#10;              }&#10;            }">
          <validate path="$.result.items.size()" value="1"/>
        </list-services>
      </execute>
    </kubernetes>
    <echo>
      <message>Get service by name</message>
    </echo>
    <kubernetes client="k8sClient">
      <execute>
        <get-service name="hello-netty" result="{&#10;              &quot;result&quot;: citrus:readFile('templates/service.json')&#10;            }"/>
      </execute>
    </kubernetes>
    <echo>
      <message>List all endpoints</message>
    </echo>
    <kubernetes client="k8sClient">
      <execute>
        <list-endpoints result="{&#10;              &quot;result&quot;: {&#10;                &quot;apiVersion&quot;: &quot;v1&quot;,&#10;                &quot;kind&quot;: &quot;EndpointsList&quot;,&#10;                &quot;items&quot;: []&#10;              }&#10;            }"/>
      </execute>
    </kubernetes>
    <kubernetes>
      <execute>
        <list-events/>
      </execute>
    </kubernetes>
    <echo>
      <message>Get pod by name '${podName}'</message>
    </echo>
    <kubernetes client="k8sClient">
      <execute>
        <get-pod name="${podName}" result="{&#10;              &quot;result&quot;: citrus:readFile('templates/pod.json')&#10;            }">
          <validate path="$..status.phase" value="@assertThat(anyOf(is(Running),is('')))@"/>
        </get-pod>
      </execute>
    </kubernetes>
  </actions>
</test>
