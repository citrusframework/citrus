<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="KubernetesSendReceiveIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test kubernetes container command execution with kubernetes client.</description>
  <variables>
    <variable name="podLabel" value="server=hello-netty"/>
  </variables>
  <actions>
    <echo>
      <message>Validate kubernetes API version</message>
    </echo>
    <send endpoint="k8sClient">
      <message>
        <body>
          <data>{ "command": "info" }</data>
        </body>
      </message>
    </send>
    <receive endpoint="k8sClient">
      <message type="json">
        <body>
          <data>{
            "command": "info",
            "result": {
                "clientVersion": "@ignore@",
                "apiVersion": "${apiVersion}",
                "kind":"Info",
                "masterUrl": "@matches('http://(kubernetes\\.docker\\.internal|localhost):[0-9]+/')@",
                "namespace": "${namespace}"
              }
            }</data>
        </body>
      </message>
    </receive>
    <echo>
      <message>List all pods</message>
    </echo>
    <create-variables>
      <variable name="randomId" value="citrus:randomNumber(10)-citrus:lowerCase(citrus:randomString(4))"/>
    </create-variables>
    <kubernetes auto-remove="false" client="k8sClient" namespace="${namespace}">
      <create-resource file="classpath:templates/hello-netty.yml"/>
    </kubernetes>
    <repeat-on-error auto-sleep="1000" until="@assertThat(greaterThan(9))@">
      <actions>
        <send endpoint="k8sClient">
          <message>
            <body>
              <data>{ "command": "list-pods" }</data>
            </body>
          </message>
        </send>
        <receive endpoint="k8sClient">
          <message type="json">
            <body>
              <data>{
                "command": "list-pods",
                "result": {
                  "apiVersion": "v1",
                  "kind": "PodList",
                  "items": [
                    citrus:readFile('templates/pod.json')
                  ]
                }
              }</data>
            </body>
          </message>
          <validate path="$.result.items.size()" value="1"/>
          <validate path="$..status.phase" value="@assertThat(anyOf(is(Running),is('')))@"/>
          <validate path="$..metadata.name" value="@variable('podName')@"/>
        </receive>
      </actions>
    </repeat-on-error>
    <echo>
      <message>List all services</message>
    </echo>
    <kubernetes auto-remove="false" client="k8sClient" namespace="${namespace}">
      <create-resource file="classpath:templates/hello-service.yml"/>
    </kubernetes>
    <repeat-on-error auto-sleep="1000" until="@assertThat(greaterThan(9))@">
      <actions>
        <send endpoint="k8sClient">
          <message>
            <body>
              <data>{ "command": "list-services" }</data>
            </body>
          </message>
        </send>
        <receive endpoint="k8sClient">
          <message type="json">
            <body>
              <data>{
                "command": "list-services",
                "result": {
                  "apiVersion": "v1",
                  "kind": "ServiceList",
                  "items": [
                    citrus:readFile('templates/service.json')
                  ]
                }
              }</data>
            </body>
          </message>
          <validate path="$.result.items.size()" value="1"/>
        </receive>
      </actions>
    </repeat-on-error>
    <echo>
      <message>Get hello-minikube service by name</message>
    </echo>
    <send endpoint="k8sClient">
      <message>
        <body>
          <data>{
              "command": "get-service",
              "name": "hello-netty"
            }</data>
        </body>
      </message>
    </send>
    <receive endpoint="k8sClient">
      <message type="json">
        <body>
          <data>{
              "command": "get-service",
              "result": citrus:readFile('templates/service.json')
            }</data>
        </body>
      </message>
    </receive>
    <echo>
      <message>List all endpoints</message>
    </echo>
    <send endpoint="k8sClient">
      <message>
        <body>
          <data>{ "command": "list-endpoints" }</data>
        </body>
      </message>
    </send>
    <receive endpoint="k8sClient">
      <message type="json">
        <body>
          <data>{
              "command": "list-endpoints",
              "result": {
                "apiVersion": "v1",
                "kind": "EndpointsList",
                "items": []
              }
            }</data>
        </body>
      </message>
      <validate path="$.result.items.size()" value="0"/>
    </receive>
    <echo>
      <message>Get pod by name '${podName}'</message>
    </echo>
    <send endpoint="k8sClient">
      <message>
        <body>
          <data>{
              "command": "get-pod",
              "name": "${podName}"
            }</data>
        </body>
      </message>
    </send>
    <receive endpoint="k8sClient">
      <message type="json">
        <body>
          <data>{
              "command": "get-pod",
              "result": citrus:readFile('templates/pod.json')
            }</data>
        </body>
      </message>
      <validate path="$..status.phase" value="@assertThat(anyOf(is(Running),is('')))@"/>
    </receive>
  </actions>
</test>
