<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="ExecuteSQLTransactionIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <actions>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException">
      <when>
        <sql datasource="testDataSource">
          <transaction manager="testTransactionManager"/>
          <statements>
            <statement>insert into ERRORS (ERROR_ID, DESCRIPTION) VALUES (citrus:randomNumber(4), 'ERROR_citrus:randomString(4)')</statement>
            <statement>insert into ERRORS VALUES (1, 'ERROR', 99)</statement>
          </statements>
        </sql>
      </when>
    </assert>
    <sql datasource="testDataSource">
      <transaction isolation-level="ISOLATION_READ_COMMITTED" manager="testTransactionManager"/>
      <statements>
        <statement>select COUNT(1) as error_cnt from ERRORS</statement>
      </statements>
      <validate column="ERROR_CNT" value="0"/>
    </sql>
    <parallel>
      <actions>
        <sql datasource="testDataSource">
          <transaction manager="testTransactionManager"/>
          <statements>
            <statement>insert into ERRORS (ERROR_ID, DESCRIPTION) VALUES (citrus:randomNumber(4), 'ERROR_citrus:randomString(4)')</statement>
            <statement>insert into ERRORS (ERROR_ID, DESCRIPTION) VALUES (citrus:randomNumber(4), 'ERROR_citrus:randomString(4)')</statement>
            <statement>insert into ERRORS (ERROR_ID, DESCRIPTION) VALUES (citrus:randomNumber(4), 'ERROR_citrus:randomString(4)')</statement>
            <statement>insert into ERRORS (ERROR_ID, DESCRIPTION) VALUES (citrus:randomNumber(4), 'ERROR_citrus:randomString(4)')</statement>
          </statements>
        </sql>
        <sequential>
          <actions>
            <sleep milliseconds="50"/>
            <sql datasource="testDataSource">
              <transaction isolation-level="ISOLATION_READ_COMMITTED" manager="testTransactionManager"/>
              <statements>
                <statement>select COUNT(1) as error_cnt from ERRORS</statement>
              </statements>
              <validate column="ERROR_CNT" value="4"/>
            </sql>
          </actions>
        </sequential>
      </actions>
    </parallel>
  </actions>
  <finally>
    <sql datasource="testDataSource">
      <statements>
        <statement>delete from ERRORS</statement>
      </statements>
    </sql>
  </finally>
</test>
