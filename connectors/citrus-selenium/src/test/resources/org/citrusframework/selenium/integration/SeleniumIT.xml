<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="SeleniumIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test selenium command execution with browser client.</description>
  <actions>
    <echo>
      <message>Validate Selenium browser commands</message>
    </echo>
    <selenium browser="webBrowser">
      <start/>
    </selenium>
    <selenium>
      <navigate page="http://localhost:19090"/>
    </selenium>
    <selenium>
      <find>
        <element tag-name="h1"/>
        <validate text="Welcome!">
          <styles>
            <style name="font-size" value="40px"/>
          </styles>
        </validate>
      </find>
    </selenium>
    <selenium>
      <find>
        <element id="hello-text"/>
        <validate text="Hello!">
          <styles>
            <style name="background-color" value="rgba(0, 0, 0, 0)"/>
            <style name="color" value="rgba(0, 0, 0, 1)"/>
          </styles>
        </validate>
      </find>
    </selenium>
    <selenium>
      <hover>
        <element id="hello-text"/>
      </hover>
    </selenium>
    <selenium>
      <find>
        <element id="hello-text"/>
        <validate>
          <styles>
            <style name="background-color" value="rgba(0, 153, 0, 1)"/>
            <style name="color" value="rgba(255, 255, 255, 1)"/>
          </styles>
        </validate>
      </find>
    </selenium>
    <selenium>
      <click>
        <element id="open-alert"/>
      </click>
    </selenium>
    <sleep milliseconds="500"/>
    <selenium>
      <alert accept="true">
        <text>Hello</text>
      </alert>
    </selenium>
    <selenium>
      <click>
        <element link-text="Say Hello!"/>
      </click>
    </selenium>
    <sleep milliseconds="500"/>
    <selenium>
      <alert accept="true"/>
    </selenium>
    <selenium>
      <navigate page="form"/>
    </selenium>
    <create-variables>
      <variable name="username" value="Selenium"/>
    </create-variables>
    <selenium>
      <page action="setUserName" name="userForm">
        <arguments>
          <argument>${username}</argument>
        </arguments>
      </page>
    </selenium>
    <selenium>
      <page action="validate" name="userForm"/>
    </selenium>
    <sleep milliseconds="300"/>
    <selenium>
      <set-input value="Citrus">
        <element id="username"/>
      </set-input>
    </selenium>
    <selenium>
      <dropdown-select option="adult">
        <element id="age"/>
      </dropdown-select>
    </selenium>
    <selenium>
      <screenshot output-dir="target"/>
    </selenium>
    <sleep milliseconds="500"/>
    <selenium>
      <click>
        <element xpath="//button[@type = 'submit']"/>
      </click>
    </selenium>
    <sleep milliseconds="500"/>
    <selenium browser="webBrowser">
      <stop/>
    </selenium>
  </actions>
</test>
