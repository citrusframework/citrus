<test name="SeleniumInteractionIT" author="Christoph" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Integration test for double click, right click, drag and drop, press keys plus extended wait and select support</description>
  <actions>
    <selenium>
      <start browser="webBrowser"/>
    </selenium>

    <selenium>
      <navigate page="http://localhost:19090/interaction"/>
    </selenium>

    <selenium>
      <wait until="url" expected="interaction"/>
    </selenium>

    <selenium>
      <wait until="title" expected="Interaction Test"/>
    </selenium>

    <selenium>
      <double-click>
        <element id="double-click-target"/>
      </double-click>
    </selenium>

    <selenium>
      <wait until="text" expected="double-clicked">
        <element id="double-click-result"/>
      </wait>
    </selenium>

    <selenium>
      <right-click>
        <element id="right-click-target"/>
      </right-click>
    </selenium>

    <selenium>
      <wait until="text" expected="right-clicked">
        <element id="right-click-result"/>
      </wait>
    </selenium>

    <selenium>
      <drag-and-drop>
        <element id="drag-source"/>
        <target id="drop-target"/>
      </drag-and-drop>
    </selenium>

    <selenium>
      <wait until="text" expected="dropped">
        <element id="drag-result"/>
      </wait>
    </selenium>

    <selenium>
      <press keys="ENTER">
        <element id="press-input"/>
      </press>
    </selenium>

    <selenium>
      <wait until="text" expected="ENTER pressed">
        <element id="press-result"/>
      </wait>
    </selenium>

    <selenium>
      <click>
        <element id="create-button"/>
      </click>
    </selenium>

    <selenium>
      <wait until="present">
        <element id="created-element"/>
      </wait>
    </selenium>

    <selenium>
      <click>
        <element id="enable-button"/>
      </click>
    </selenium>

    <selenium>
      <wait until="clickable">
        <element id="click-me"/>
      </wait>
    </selenium>

    <selenium>
      <click>
        <element id="click-me"/>
      </click>
    </selenium>

    <selenium>
      <wait until="text" expected="clicked">
        <element id="click-result"/>
      </wait>
    </selenium>

    <selenium>
      <dropdown-select option="Germany" by="text">
        <element id="countries"/>
      </dropdown-select>
    </selenium>

    <selenium>
      <dropdown-select option="1" by="index">
        <element id="countries"/>
      </dropdown-select>
    </selenium>

    <selenium>
      <dropdown-select option="German" by="text">
        <element id="languages"/>
      </dropdown-select>
    </selenium>

    <selenium>
      <dropdown-select deselect-all="true">
        <element id="languages"/>
      </dropdown-select>
    </selenium>

    <selenium>
      <dropdown-select option="German" by="text">
        <element id="languages"/>
      </dropdown-select>
    </selenium>

    <selenium>
      <dropdown-select by="text">
        <element id="languages"/>
        <deselect-options>
          <option>German</option>
        </deselect-options>
      </dropdown-select>
    </selenium>

    <selenium>
      <stop browser="webBrowser"/>
    </selenium>
  </actions>
</test>
