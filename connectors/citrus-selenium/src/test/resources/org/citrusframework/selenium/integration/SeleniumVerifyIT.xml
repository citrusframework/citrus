<test name="SeleniumVerifyIT" author="Christoph" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Integration test for the Selenium verify and extract actions</description>
  <actions>
    <selenium>
      <start browser="webBrowser"/>
    </selenium>

    <selenium>
      <navigate page="http://localhost:19090/parity"/>
    </selenium>

    <selenium>
      <wait until="title" expected="Parity Test"/>
    </selenium>

    <selenium>
      <verify check="title" expected="Parity Test"/>
    </selenium>

    <selenium>
      <verify check="url" expected="@endsWith('/parity')@"/>
    </selenium>

    <selenium>
      <verify check="displayed">
        <element id="greeting"/>
      </verify>
    </selenium>

    <selenium>
      <verify check="enabled">
        <element id="greeting"/>
      </verify>
    </selenium>

    <selenium>
      <verify check="text" expected="Hello Citrus">
        <element id="greeting"/>
      </verify>
    </selenium>

    <selenium>
      <verify check="count" expected="3">
        <element class-name="order"/>
      </verify>
    </selenium>

    <selenium>
      <verify check="attribute" attribute="href" expected="https://citrusframework.org">
        <element id="docs"/>
      </verify>
    </selenium>

    <selenium>
      <verify check="hidden">
        <element id="hidden-element"/>
      </verify>
    </selenium>

    <selenium>
      <verify check="absent">
        <element id="missing"/>
      </verify>
    </selenium>

    <selenium>
      <verify check="disabled">
        <element id="submit"/>
      </verify>
    </selenium>

    <selenium>
      <extract value="title" variable="pageTitle"/>
    </selenium>

    <selenium>
      <extract value="text" variable="greetingText">
        <element id="greeting"/>
      </extract>
    </selenium>

    <selenium>
      <extract value="count" variable="orderCount">
        <element class-name="order"/>
      </extract>
    </selenium>

    <selenium>
      <extract value="attribute" attribute="href" variable="docsHref">
        <element id="docs"/>
      </extract>
    </selenium>

    <echo>
      <message>Extracted title: ${pageTitle}, greeting: ${greetingText}, order count: ${orderCount}, docs href: ${docsHref}</message>
    </echo>

    <selenium>
      <verify check="title" expected="${pageTitle}"/>
    </selenium>

    <selenium>
      <verify check="count" expected="${orderCount}">
        <element class-name="order"/>
      </verify>
    </selenium>

    <selenium>
      <verify check="attribute" attribute="href" expected="${docsHref}">
        <element id="docs"/>
      </verify>
    </selenium>

    <selenium>
      <click>
        <element id="redirect"/>
      </click>
    </selenium>

    <selenium>
      <wait until="url" expected="form"/>
    </selenium>

    <selenium>
      <verify check="url" expected="@endsWith('/form')@"/>
    </selenium>

    <selenium>
      <stop browser="webBrowser"/>
    </selenium>
  </actions>
</test>
