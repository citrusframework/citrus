<test name="DockerCreateTest" author="Christoph" status="FINAL"
      xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <actions>
    <docker client="myDockerClient">
      <description>Create a container from an image</description>
      <create image="citrus:latest" name="myContainer" attach-stdout="true" attach-stderr="true"
              capability-add="NET_ADMIN,SYS_ADMIN" capability-drop="MKNOD"
              cmd="sleep 5;echo done" env="JAVA_HOME=/opt/java;PATH=/usr/bin"
              hostname="citrusHost" domain-name="citrusframework.org" working-dir="/tmp"
              entrypoint="/bin/sh" port-specs="8080;9090" exposed-ports="8080,9090"
              port-bindings="80:8080,90:9090" volumes="/tmp:/tmp,/var:/var"/>
    </docker>
  </actions>
</test>
