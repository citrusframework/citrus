<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="CreateVariablesIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <variables>
    <variable name="myVariable">
      <value>
        <script type="groovy">
            10000 + 2345
          </script>
      </value>
    </variable>
    <variable name="newValue" value="54321"/>
  </variables>
  <actions>
    <create-variables>
      <variable name="scriptVariable">
        <value>
          <script type="groovy">
              ${newValue} + 5
            </script>
        </value>
      </variable>
    </create-variables>
    <groovy>
      <script>
        assert ${myVariable} == 12345
        assert ${scriptVariable} == 54326
      </script>
    </groovy>
  </actions>
</test>
