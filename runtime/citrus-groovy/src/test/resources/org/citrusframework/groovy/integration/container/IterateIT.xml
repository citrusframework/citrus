<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Unknown" name="IterateIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <actions>
    <create-variables>
      <variable name="outerLoop" value="0"/>
      <variable name="innerLoop" value="0"/>
    </create-variables>
    <iterate condition="i lt= 5" index="i">
      <actions>
        <create-variables>
          <variable name="outerLoop">
            <value>
              <script type="groovy">(${outerLoop} + 1)</script>
            </value>
          </variable>
        </create-variables>
        <iterate condition="j lt= 3" index="j">
          <actions>
            <create-variables>
              <variable name="innerLoop">
                <value>
                  <script type="groovy">(${innerLoop} + 1)</script>
                </value>
              </variable>
            </create-variables>
            <echo>
              <message>i=${i} j=${j}</message>
            </echo>
          </actions>
        </iterate>
      </actions>
    </iterate>
    <groovy>
      <script>
        assert context.getVariable("outerLoop").equals("5")
        assert context.getVariable("innerLoop").equals("15")
      </script>
    </groovy>
  </actions>
</test>
