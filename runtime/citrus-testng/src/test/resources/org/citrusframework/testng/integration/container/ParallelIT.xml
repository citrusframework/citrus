<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="ParallelIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test of action sequence in parallel container</description>
  <actions>
    <parallel>
      <actions>
        <sleep seconds="1.5"/>
        <sequential>
          <actions>
            <sleep milliseconds="1000"/>
            <echo>
              <message>1</message>
            </echo>
          </actions>
        </sequential>
        <echo>
          <message>2</message>
        </echo>
        <echo>
          <message>3</message>
        </echo>
        <iterate condition="i lt= 5" index="i">
          <actions>
            <echo>
              <message>10</message>
            </echo>
          </actions>
        </iterate>
      </actions>
    </parallel>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException">
      <when>
        <parallel>
          <actions>
            <sleep seconds="1.5"/>
            <sequential>
              <actions>
                <sleep milliseconds="1000"/>
                <fail message="This went wrong too"/>
                <echo>
                  <message>1</message>
                </echo>
              </actions>
            </sequential>
            <fail message="This went wrong"/>
            <echo>
              <message>2</message>
            </echo>
            <echo>
              <message>3</message>
            </echo>
            <iterate condition="i lt= 5" index="i">
              <actions>
                <echo>
                  <message>10</message>
                </echo>
              </actions>
            </iterate>
          </actions>
        </parallel>
      </when>
    </assert>
  </actions>
</test>
