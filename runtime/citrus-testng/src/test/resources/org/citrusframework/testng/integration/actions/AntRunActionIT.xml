<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="AntRunActionIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test calls Apache Ant build targets from test action.</description>
  <variables>
    <variable name="welcomeText" value="Hello Citrus today is citrus:currentDate()!"/>
    <variable name="checked" value="true"/>
  </variables>
  <actions>
    <ant build-file="classpath:org/citrusframework/testng/integration/actions/build.xml">
      <execute target="sayHello"/>
    </ant>
    <ant build-file="classpath:org/citrusframework/testng/integration/actions/build.xml">
      <execute targets="sayHello,sayGoodbye"/>
    </ant>
    <ant build-file="classpath:org/citrusframework/testng/integration/actions/build.xml">
      <execute target="sayHello"/>
      <properties>
        <property name="welcomeText" value="${welcomeText}"/>
        <property name="goodbyeText" value="Goodbye!"/>
      </properties>
    </ant>
    <ant build-file="classpath:org/citrusframework/testng/integration/actions/build.xml">
      <execute target="checkMe"/>
      <properties file="classpath:org/citrusframework/testng/integration/actions/build.properties"/>
    </ant>
  </actions>
</test>
