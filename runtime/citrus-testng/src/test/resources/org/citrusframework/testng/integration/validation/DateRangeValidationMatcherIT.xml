<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Martin Maher" name="DateRangeValidationMatcherIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Tests the @dateRange()@ validator</description>
  <variables>
    <variable name="withinRangeTimestamp" value="2015-01-31"/>
    <variable name="outsideRangeTimestamp" value="2015-01-28"/>
    <variable name="rangeFrom" value="2015-01-30"/>
    <variable name="rangeTo" value="2015-02-01"/>
  </variables>
  <actions>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="time" value="${withinRangeTimestamp}"/>
        </headers>
        <body>
          <data>Hello Citrus!</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message type="plaintext">
        <headers>
          <header name="time" value="@dateRange('${rangeFrom}','${rangeTo}')@"/>
        </headers>
        <body>
          <data>Hello Citrus!</data>
        </body>
      </message>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="time" value="${outsideRangeTimestamp}"/>
        </headers>
        <body>
          <data>Hello Citrus!</data>
        </body>
      </message>
    </send>
    <assert exception="org.citrusframework.exceptions.ValidationException" message="DateRangeValidationMatcher failed for field 'time'. Date '${outsideRangeTimestamp}' not in range: ${rangeFrom} - ${rangeTo}">
      <when>
        <receive endpoint="helloEndpoint">
          <message type="plaintext">
            <headers>
              <header name="time" value="@dateRange('${rangeFrom}','${rangeTo}')@"/>
            </headers>
            <body>
              <data>Hello Citrus!</data>
            </body>
          </message>
        </receive>
      </when>
    </assert>
  </actions>
</test>
