<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="AssertIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Asserting excpetions</description>
  <variables>
    <variable name="failMessage" value="Something went wrong!"/>
  </variables>
  <actions>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException">
      <when>
        <fail message="Fail once"/>
      </when>
    </assert>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException" message="Fail again">
      <when>
        <fail message="Fail again"/>
      </when>
    </assert>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException" message="${failMessage}">
      <when>
        <fail message="${failMessage}"/>
      </when>
    </assert>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException" message="@contains('wrong')@">
      <when>
        <fail message="${failMessage}"/>
      </when>
    </assert>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <assert exception="java.io.IOException">
          <when>
            <fail message="Fail another time"/>
          </when>
        </assert>
      </when>
    </assert>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <assert exception="org.citrusframework.exceptions.CitrusRuntimeException" message="Fail again">
          <when>
            <fail message="Fail with nice error message"/>
          </when>
        </assert>
      </when>
    </assert>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <assert exception="org.citrusframework.exceptions.CitrusRuntimeException">
          <when>
            <echo>
              <message>Nothing fails here</message>
            </echo>
          </when>
        </assert>
      </when>
    </assert>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <assert exception="org.citrusframework.exceptions.CitrusRuntimeException" message="Must be failing">
          <when>
            <echo>
              <message>Nothing fails here either</message>
            </echo>
          </when>
        </assert>
      </when>
    </assert>
  </actions>
</test>
