<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Philipp Komninos" name="GlobalVariablesIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test the use of property loader with global variables and general variable support.
		Global variables are loaded in advance to this test. Variables are printed within this test
        to show that global property loader works fine.</description>
  <variables>
    <variable name="checkDate" value="citrus:currentDate('yyyy-MM-dd')"/>
  </variables>
  <actions>
    <echo>
      <message>Value of global variable "globalGreeting": ${globalGreeting}</message>
    </echo>
    <echo>
      <message>Value of global variable "globalWelcomingText": ${globalWelcomingText}</message>
    </echo>
    <echo>
      <message>Value of global variable "globalDate": ${globalDate}</message>
    </echo>
    <echo>
      <message>Value of global sum variables: ${globalSum1}, ${globalSum2}</message>
    </echo>
  </actions>
</test>
