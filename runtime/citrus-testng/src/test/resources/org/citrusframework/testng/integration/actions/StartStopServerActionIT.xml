<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="StartStopServerActionIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test calls starts and stops server instance during test runtime.</description>
  <actions>
    <echo>
      <message>Test 1: Start server instance</message>
    </echo>
    <start>
      <servers>
        <server name="simpleServer"/>
      </servers>
    </start>
    <echo>
      <message>Receive server start event</message>
    </echo>
    <receive endpoint="statusEndpoint">
      <message type="plaintext">
        <body>
          <data>SERVER STARTED</data>
        </body>
      </message>
    </receive>
    <echo>
      <message>Test 1: Stop server instance</message>
    </echo>
    <stop>
      <servers>
        <server name="simpleServer"/>
      </servers>
    </stop>
    <echo>
      <message>Receive server stop event</message>
    </echo>
    <receive endpoint="statusEndpoint">
      <message type="plaintext">
        <body>
          <data>SERVER STOPPED</data>
        </body>
      </message>
    </receive>
    <echo>
      <message>Test 2: Start server instance</message>
    </echo>
    <start server="simpleServer"/>
    <echo>
      <message>Receive server start event</message>
    </echo>
    <receive endpoint="statusEndpoint">
      <message type="plaintext">
        <body>
          <data>SERVER STARTED</data>
        </body>
      </message>
    </receive>
    <echo>
      <message>Test 2: Stop server instance</message>
    </echo>
    <stop server="simpleServer"/>
    <echo>
      <message>Receive server stop event</message>
    </echo>
    <receive endpoint="statusEndpoint">
      <message type="plaintext">
        <body>
          <data>SERVER STOPPED</data>
        </body>
      </message>
    </receive>
  </actions>
</test>
