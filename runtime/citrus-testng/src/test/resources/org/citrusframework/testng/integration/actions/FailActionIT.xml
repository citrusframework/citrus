<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="FailActionIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Failing test for purpose. Asserting exception to be thrown</description>
  <actions>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException">
      <when>
        <fail message="Failing IT"/>
      </when>
    </assert>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException">
      <when>
        <assert exception="org.citrusframework.exceptions.CitrusRuntimeException">
          <when>
            <sleep milliseconds="500"/>
          </when>
        </assert>
      </when>
    </assert>
  </actions>
</test>
