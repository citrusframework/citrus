<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Unknown" name="IterateIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test of iterating loops</description>
  <variables>
    <variable name="max" value="3"/>
  </variables>
  <actions>
    <iterate condition="i lt= citrus:randomNumber(1)" index="i">
      <actions>
        <echo>
          <message>index is: ${i}</message>
        </echo>
      </actions>
    </iterate>
    <iterate condition="i lt 20" index="i">
      <actions>
        <echo>
          <message>index is: ${i}</message>
        </echo>
      </actions>
    </iterate>
    <iterate condition="(i lt 5) or (i = 5)" index="i">
      <actions>
        <echo>
          <message>index is: ${i}</message>
        </echo>
      </actions>
    </iterate>
    <iterate condition="(i lt 5) and (i lt 3)" index="i">
      <actions>
        <echo>
          <message>index is: ${i}</message>
        </echo>
      </actions>
    </iterate>
    <iterate condition="i = 0" index="i">
      <actions>
        <echo>
          <message>index is: ${i}</message>
        </echo>
      </actions>
    </iterate>
    <iterate condition="${max} gt= i" index="i">
      <actions>
        <echo>
          <message>index is: ${i}</message>
        </echo>
      </actions>
    </iterate>
    <iterate condition="i lt= 50" index="i" startsWith="0" step="5">
      <actions>
        <echo>
          <message>index is: ${i}</message>
        </echo>
      </actions>
    </iterate>
    <iterate condition="i lt= 60" index="i" startsWith="10" step="10">
      <actions>
        <iterate condition="k lt= 6" index="k" startsWith="0" step="2">
          <actions>
            <echo>
              <message>index is: ${i}, ${k}</message>
            </echo>
          </actions>
        </iterate>
      </actions>
    </iterate>
  </actions>
</test>
