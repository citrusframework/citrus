<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="AsyncIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Async container with nested actions that get executed in separate Thread.</description>
  <actions>
    <async>
      <actions>
        <sleep milliseconds="100"/>
        <echo>
          <message>In async container!</message>
        </echo>
      </actions>
      <error>
        <echo>
          <message>Failed!</message>
        </echo>
      </error>
      <success>
        <echo>
          <message>Success!</message>
        </echo>
      </success>
    </async>
  </actions>
</test>
