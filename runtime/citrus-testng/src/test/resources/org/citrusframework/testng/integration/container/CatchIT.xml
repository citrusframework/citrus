<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="CatchIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Catching excpetions</description>
  <actions>
    <catch>
      <when>
        <fail message="Fail!"/>
      </when>
    </catch>
    <catch exception="org.citrusframework.exceptions.CitrusRuntimeException">
      <when>
        <fail message="Fail!"/>
      </when>
    </catch>
  </actions>
</test>
