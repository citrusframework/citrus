<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="VariablesOrderIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Testing that variables should be stored in natural order.</description>
  <variables>
    <variable name="variable" value="1"/>
    <variable name="first" value="${variable}"/>
    <variable name="second" value="${first}"/>
    <variable name="a" value="${variable}"/>
    <variable name="one" value="1"/>
    <variable name="two" value="2"/>
    <variable name="twelfe" value="${one}${two}"/>
  </variables>
  <actions>
    <create-variables>
      <variable name="z" value="success"/>
      <variable name="anotherVariable" value="${z}"/>
    </create-variables>
    <trace-variables/>
    <echo>
      <message>${a}</message>
    </echo>
    <echo>
      <message>${twelfe}</message>
    </echo>
    <echo>
      <message>${anotherVariable}</message>
    </echo>
  </actions>
</test>
