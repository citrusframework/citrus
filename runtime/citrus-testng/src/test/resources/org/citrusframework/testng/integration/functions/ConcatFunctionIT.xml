<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Unknown" name="ConcatFunctionIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>CONCAT function test</description>
  <variables>
    <variable name="date" value="citrus:currentDate('yyyy-MM-dd')"/>
    <variable name="right" value="Is that right?!"/>
    <variable name="str1" value="citrus:concat('Hallo', ' Test', ' Framework!')"/>
    <variable name="str2" value="citrus:concat('Hallo', ' Test', ' Framework!')"/>
  </variables>
  <actions>
    <create-variables>
      <variable name="str3" value="citrus:concat(${str2})"/>
      <variable name="str4" value="citrus:concat(${date}, ': Hallo', ' Test', ' Framework! ', ${right})"/>
      <variable name="str5" value="citrus:concat('Hallo ', ${date}, ' Test', ' Framework! ', ${right})"/>
    </create-variables>
    <echo>
      <message>citrus:concat('Today is: ', ${date}, ' ', ${right})</message>
    </echo>
    <echo>
      <message>citrus:concat(${str2})</message>
    </echo>
    <echo>
      <message>citrus:concat(${date}, ': Hallo', ' Test', ' Framework! ', ${right})</message>
    </echo>
    <echo>
      <message>citrus:concat('Hallo ', ${date}, ' Test', ' Framework! ', ${right})</message>
    </echo>
    <echo>
      <message>citrus:concat('Today is: ', ${date}, ' ', ${right})</message>
    </echo>
    <trace-variables/>
  </actions>
</test>
