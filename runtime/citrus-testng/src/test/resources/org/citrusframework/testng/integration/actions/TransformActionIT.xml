<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Philipp Komninos" name="TransformActionIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test will transform a XML document to a HTML document with XSLT.</description>
  <actions>
    <transform variable="result">
      <source><![CDATA[
            		
						<TestRequest>
	    					<Message>Hello World!</Message>
						</TestRequest>
            		
            	]]></source>
      <xslt><![CDATA[
            		
	            		<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
						<xsl:template match="/">
						<html>
							<body>
								<h2>Test Request</h2>
								<p>Message: <xsl:value-of select="TestRequest/Message"/></p>
							</body>
						</html>
						</xsl:template>
						</xsl:stylesheet>
            		
            	]]></xslt>
    </transform>
    <echo>
      <message>${result}</message>
    </echo>
    <transform variable="result">
      <source file="classpath:org/citrusframework/testng/integration/actions/transform-source.xml"/>
      <xslt file="classpath:org/citrusframework/testng/integration/actions/transform.xslt"/>
    </transform>
    <echo>
      <message>${result}</message>
    </echo>
  </actions>
</test>
