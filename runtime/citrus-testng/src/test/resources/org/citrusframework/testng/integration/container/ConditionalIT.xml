<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="ConditionalIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Execute test actions based on some condition</description>
  <variables>
    <variable name="failMessage" value="Something went wrong!"/>
    <variable name="shouldExecute" value="true"/>
    <variable name="shouldNotExecute" value="false"/>
    <variable name="number" value="10"/>
  </variables>
  <actions>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException">
      <when>
        <conditional when="${shouldExecute}">
          <actions>
            <fail message="${failMessage}"/>
          </actions>
        </conditional>
      </when>
    </assert>
    <conditional when="${shouldNotExecute}">
      <actions>
        <fail message="${failMessage}"/>
      </actions>
    </conditional>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException">
      <when>
        <conditional when="${number} = 10">
          <actions>
            <fail message="${failMessage}"/>
          </actions>
        </conditional>
      </when>
    </assert>
    <conditional when="${number} lt 10">
      <actions>
        <fail message="${failMessage}"/>
      </actions>
    </conditional>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException">
      <when>
        <conditional when="${shouldExecute} = true">
          <actions>
            <fail message="${failMessage}"/>
          </actions>
        </conditional>
      </when>
    </assert>
    <conditional when="${shouldNotExecute} = true">
      <actions>
        <fail message="${failMessage}"/>
      </actions>
    </conditional>
  </actions>
</test>
