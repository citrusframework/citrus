<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="bbortt" name="UuidV4ValidationMatcherIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Tests the @isUUIDv4()@ validator</description>
  <variables>
    <variable name="validUuid" value="653ce6fd-dca4-4672-bbc0-16e2b74b8b81"/>
    <variable name="invalidUuid" value="019314e4-1eab-70a2-84cc-1b1328b36cdb"/>
  </variables>
  <actions>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="message-id" value="${validUuid}"/>
        </headers>
        <body>
          <data>Hello Citrus!</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message type="plaintext">
        <headers>
          <header name="message-id" value="@isUUIDv4()@"/>
        </headers>
        <body>
          <data>Hello Citrus!</data>
        </body>
      </message>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="message-id" value="${invalidUuid}"/>
        </headers>
        <body>
          <data>Hello Citrus!</data>
        </body>
      </message>
    </send>
    <assert exception="org.citrusframework.exceptions.ValidationException" message="UuidV4ValidationMatcher failed for field 'message-id'. Received value '${invalidUuid}' is not a uuid v4.">
      <when>
        <receive endpoint="helloEndpoint">
          <message type="plaintext">
            <headers>
              <header name="message-id" value="@isUUIDv4()@"/>
            </headers>
            <body>
              <data>Hello Citrus!</data>
            </body>
          </message>
        </receive>
      </when>
    </assert>
  </actions>
</test>
