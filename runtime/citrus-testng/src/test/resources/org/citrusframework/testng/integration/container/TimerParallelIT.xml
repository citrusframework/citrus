<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Unknown" name="TimerParallelIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test of action timer</description>
  <actions>
    <parallel>
      <actions>
        <timer id="parallelTimer1" interval="100" repeatCount="5">
          <actions>
            <echo>
              <message>parallelTimer1: Doing iteration # ${parallelTimer1-index}</message>
            </echo>
          </actions>
        </timer>
        <sequential>
          <actions>
            <echo>
              <message>Waiting for parallelTimer1 to complete</message>
            </echo>
          </actions>
        </sequential>
      </actions>
    </parallel>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException" message="Error outside timer">
      <when>
        <parallel>
          <actions>
            <timer id="parallelTimer2" interval="100" repeatCount="5">
              <actions>
                <echo>
                  <message>parallelTimer2: Doing iteration # ${parallelTimer2-index}</message>
                </echo>
              </actions>
            </timer>
            <sequential>
              <actions>
                <sleep milliseconds="200"/>
                <fail message="Error outside timer"/>
              </actions>
            </sequential>
          </actions>
        </parallel>
      </when>
    </assert>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException" message="Error inside timer">
      <when>
        <parallel>
          <actions>
            <timer id="parallelTimer3" interval="100" repeatCount="5">
              <actions>
                <echo>
                  <message>parallelTimer3: Doing iteration # ${parallelTimer3-index}</message>
                </echo>
                <fail message="Error inside timer"/>
              </actions>
            </timer>
            <sequential>
              <actions>
                <sleep milliseconds="500"/>
              </actions>
            </sequential>
          </actions>
        </parallel>
      </when>
    </assert>
  </actions>
</test>
