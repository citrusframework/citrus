<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Unknown" name="TimerIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test of action timer</description>
  <actions>
    <timer fork="true" id="forkedTimer" interval="100">
      <actions>
        <echo>
          <message>Cool, I've been forked - ${forkedTimer-index}</message>
        </echo>
        <sleep milliseconds="50"/>
      </actions>
    </timer>
    <timer interval="100" repeatCount="3">
      <actions>
        <sleep milliseconds="50"/>
        <echo>
          <message>I'm just a boring timer</message>
        </echo>
      </actions>
    </timer>
    <timer delay="50" interval="100" repeatCount="2">
      <actions>
        <echo>
          <message>The nested actions take longer than the timer interval - this should still work!</message>
        </echo>
        <sleep milliseconds="200"/>
      </actions>
    </timer>
  </actions>
  <finally>
    <stop-timer id="forkedTimer"/>
  </finally>
</test>
