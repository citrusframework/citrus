<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="AsyncFailIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Async container with failed actions should raise test case error.</description>
  <actions>
    <async>
      <actions>
        <fail message="Fail!"/>
      </actions>
      <error>
        <echo>
          <message>Failed!</message>
        </echo>
      </error>
      <success>
        <echo>
          <message>Success!</message>
        </echo>
      </success>
    </async>
  </actions>
</test>
