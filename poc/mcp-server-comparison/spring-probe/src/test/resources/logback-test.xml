<configuration>
  <!-- Stdio children must keep protocol-only stdout: everything logs to stderr. -->
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{HH:mm:ss} %-5level %logger{36} : %msg%n</pattern>
    </encoder>
  </appender>
  <root level="WARN">
    <appender-ref ref="STDERR"/>
  </root>
  <logger name="org.citrusframework.poc" level="INFO"/>
</configuration>
