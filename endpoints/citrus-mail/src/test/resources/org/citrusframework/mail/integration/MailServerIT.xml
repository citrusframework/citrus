<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="MailServerIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test mail SMTP communication.</description>
  <variables>
    <variable name="from" value="christoph@citrusframework.com"/>
    <variable name="to" value="citrus@citrusframework.com"/>
    <variable name="subject" value="This is a test mail message"/>
  </variables>
  <actions>
    <echo>
      <message>Test 1: Send mail to Citrus smtp server and receive mail via mail message channel</message>
    </echo>
    <send endpoint="simpleMailClient">
      <description>Send mail: Citrus -&gt; Citrus SMTP server</description>
      <message>
        <headers>
          <header name="citrus_mail_content_type" value="text/plain"/>
        </headers>
        <body>
          <data><![CDATA[<mail-message xmlns="http://www.citrusframework.org/schema/mail/message">
                <from>${from}</from>
                <to>${to}</to>
                <subject>${subject}</subject>
                <body>
                  <contentType>text/plain; charset=utf-8</contentType>
                  <content>Hello Citrus mail server!</content>
                </body>
              </mail-message>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="simpleMailServer">
      <description>Receive mail message: Citrus SMTP server channel -&gt; Citrus</description>
      <message>
        <headers>
          <header name="citrus_mail_from" value="${from}"/>
          <header name="citrus_mail_to" value="${to}"/>
          <header name="citrus_mail_subject" value="${subject}"/>
          <header name="citrus_mail_content_type" value="text/plain; charset=utf-8"/>
        </headers>
        <body>
          <data><![CDATA[<mail-message xmlns="http://www.citrusframework.org/schema/mail/message">
                <from>${from}</from>
                <to>${to}</to>
                <subject>${subject}</subject>
                <body>
                  <contentType>text/plain; charset=utf-8</contentType>
                  <content>Hello Citrus mail server!</content>
                </body>
              </mail-message>]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
