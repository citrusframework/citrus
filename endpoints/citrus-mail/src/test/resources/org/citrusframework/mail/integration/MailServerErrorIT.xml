<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="MailServerErrorIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test mail SMTP communication with error simulated on smtp server.</description>
  <variables>
    <variable name="from" value="christoph@citrusframework.com"/>
    <variable name="to" value="citrus@citrusframework.com"/>
    <variable name="subject" value="This is a test mail message"/>
  </variables>
  <actions>
    <echo>
      <message>Test 1: Simulate error on smtp server</message>
    </echo>
    <parallel>
      <actions>
        <assert exception="org.citrusframework.exceptions.CitrusRuntimeException">
          <when>
            <send endpoint="advancedMailClient">
              <description>Send mail: Citrus -&gt; Citrus SMTP server</description>
              <message>
                <headers>
                  <header name="citrus_mail_content_type" value="text/plain"/>
                </headers>
                <body>
                  <data><![CDATA[<mail-message xmlns="http://www.citrusframework.org/schema/mail/message">
                      <from>${from}</from>
                      <to>${to}</to>
                      <subject>${subject}</subject>
                      <body>
                        <contentType>text/plain; charset=utf-8</contentType>
                        <content>Hello Citrus mail server!</content>
                      </body>
                    </mail-message>]]></data>
                </body>
              </message>
            </send>
          </when>
        </assert>
        <sequential>
          <actions>
            <receive endpoint="advancedMailServer">
              <description>Receive accept request for incoming mail</description>
              <message>
                <body>
                  <data><![CDATA[<accept-request xmlns="http://www.citrusframework.org/schema/mail/message">
                    <from>${from}</from>
                    <to>${to}</to>
                  </accept-request>]]></data>
                </body>
              </message>
            </receive>
            <send endpoint="advancedMailServer">
              <description>Send accept response and accept incoming mail.</description>
              <message>
                <body>
                  <data><![CDATA[<accept-response xmlns="http://www.citrusframework.org/schema/mail/message">
                    <accept>true</accept>
                  </accept-response>]]></data>
                </body>
              </message>
            </send>
            <receive endpoint="advancedMailServer">
              <description>Receive mail message: Citrus SMTP server channel -&gt; Citrus</description>
              <message>
                <headers>
                  <header name="citrus_mail_from" value="${from}"/>
                  <header name="citrus_mail_to" value="${to}"/>
                  <header name="citrus_mail_subject" value="${subject}"/>
                  <header name="citrus_mail_content_type" value="text/plain; charset=utf-8"/>
                </headers>
                <body>
                  <data><![CDATA[<mail-message xmlns="http://www.citrusframework.org/schema/mail/message">
                    <from>${from}</from>
                    <to>${to}</to>
                    <subject>${subject}</subject>
                    <body>
                      <contentType>text/plain; charset=utf-8</contentType>
                      <content>Hello Citrus mail server!</content>
                    </body>
                  </mail-message>]]></data>
                </body>
              </message>
            </receive>
            <send endpoint="advancedMailServer">
              <description>Send mail response OK</description>
              <message>
                <body>
                  <data><![CDATA[<mail-response xmlns="http://www.citrusframework.org/schema/mail/message">
                    <code>443</code>
                    <message>Failed!</message>
                  </mail-response>]]></data>
                </body>
              </message>
            </send>
          </actions>
        </sequential>
      </actions>
    </parallel>
  </actions>
</test>
