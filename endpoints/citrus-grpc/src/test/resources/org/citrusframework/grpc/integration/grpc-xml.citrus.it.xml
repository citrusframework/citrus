<test name="GrpcXmlIT" author="Citrus" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <actions>
    <grpc client="client">
      <send>
        <call>helloworld.Greeter/SayHello</call>
        <message>
          <body><data>{"name": "Ada"}</data></body>
        </message>
      </send>
    </grpc>

    <grpc server="simulator">
      <receive>
        <call>helloworld.Greeter/SayHello</call>
        <message>
          <body><data>{"name": "Ada", "userId": 0}</data></body>
        </message>
      </receive>
    </grpc>

    <grpc server="simulator">
      <send>
        <response status="OK"/>
        <message>
          <body><data>{"message": "Hello Ada"}</data></body>
        </message>
      </send>
    </grpc>

    <grpc client="client">
      <receive>
        <response status="OK"/>
        <message>
          <body><data>{"message": "Hello Ada"}</data></body>
        </message>
      </receive>
    </grpc>

    <grpc client="client">
      <send>
        <call>helloworld.Greeter/GetUser</call>
        <message>
          <body><data>{"id": "unknown"}</data></body>
        </message>
      </send>
    </grpc>

    <grpc server="simulator">
      <receive>
        <call>helloworld.Greeter/GetUser</call>
        <message>
          <body><data>{"id": "unknown"}</data></body>
        </message>
      </receive>
    </grpc>

    <grpc server="simulator">
      <send>
        <response status="NOT_FOUND"/>
        <status-description>unknown user</status-description>
      </send>
    </grpc>

    <grpc client="client">
      <receive>
        <response status="NOT_FOUND"/>
        <status-description>@contains('unknown')@</status-description>
      </receive>
    </grpc>

    <grpc client="client">
      <send>
        <call>market.Prices/Subscribe</call>
        <message>
          <body><data>{"symbol": "ACME"}</data></body>
        </message>
      </send>
    </grpc>

    <grpc server="simulator">
      <receive>
        <call>market.Prices/Subscribe</call>
        <message>
          <body><data>{"symbol": "ACME"}</data></body>
        </message>
      </receive>
    </grpc>

    <grpc server="simulator">
      <send>
        <stream-message/>
        <message>
          <body><data>{"symbol": "ACME", "amount": {"currency": "EUR", "amount": "0"}}</data></body>
        </message>
      </send>
    </grpc>

    <grpc server="simulator">
      <send>
        <stream-completed status="OK"/>
      </send>
    </grpc>

    <grpc client="client">
      <receive>
        <stream-message/>
        <message>
          <body><data>{"symbol": "ACME", "amount": {"currency": "EUR", "amount": "0"}}</data></body>
        </message>
      </receive>
    </grpc>

    <grpc client="client">
      <receive>
        <stream-completed status="OK"/>
      </receive>
    </grpc>

    <!-- client streaming: StoreUsers -->
    <grpc client="client">
      <send>
        <call>grpc2grpc.PetStoreService/StoreUsers</call>
        <message>
          <body><data>{"id": 1, "username": "ada", "email": "ada@example.com", "phone": "555-1"}</data></body>
        </message>
      </send>
    </grpc>

    <grpc client="client">
      <send>
        <stream-message/>
        <message>
          <body><data>{"id": 2, "username": "bob", "email": "bob@example.com", "phone": "555-2"}</data></body>
        </message>
      </send>
    </grpc>

    <grpc client="client">
      <send>
        <stream-completed/>
      </send>
    </grpc>

    <grpc server="simulator">
      <receive>
        <call>grpc2grpc.PetStoreService/StoreUsers</call>
        <message>
          <body><data>{"id": 1, "username": "ada", "email": "ada@example.com", "phone": "555-1"}</data></body>
        </message>
      </receive>
    </grpc>

    <grpc server="simulator">
      <receive>
        <stream-message/>
        <message>
          <body><data>{"id": 2, "username": "bob", "email": "bob@example.com", "phone": "555-2"}</data></body>
        </message>
      </receive>
    </grpc>

    <grpc server="simulator">
      <receive>
        <stream-completed/>
      </receive>
    </grpc>

    <grpc server="simulator">
      <send>
        <response status="OK"/>
        <message>
          <body><data>{"msg": "received 2"}</data></body>
        </message>
      </send>
    </grpc>

    <grpc client="client">
      <receive>
        <response status="OK"/>
        <message>
          <body><data>{"msg": "received 2"}</data></body>
        </message>
      </receive>
    </grpc>

    <!-- bidirectional streaming: BulkUsers -->
    <grpc client="client">
      <send>
        <call>grpc2grpc.PetStoreService/BulkUsers</call>
        <message>
          <body><data>{"id": 1, "username": "ada", "email": "ada@example.com", "phone": "555-1"}</data></body>
        </message>
      </send>
    </grpc>

    <grpc server="simulator">
      <receive>
        <call>grpc2grpc.PetStoreService/BulkUsers</call>
        <message>
          <body><data>{"id": 1, "username": "ada", "email": "ada@example.com", "phone": "555-1"}</data></body>
        </message>
      </receive>
    </grpc>

    <grpc server="simulator">
      <send>
        <stream-message/>
        <message>
          <body><data>{"id": 10, "username": "echo", "email": "echo@example.com", "phone": "555-10"}</data></body>
        </message>
      </send>
    </grpc>

    <grpc client="client">
      <receive>
        <stream-message/>
        <message>
          <body><data>{"id": 10, "username": "echo", "email": "echo@example.com", "phone": "555-10"}</data></body>
        </message>
      </receive>
    </grpc>

    <grpc client="client">
      <send>
        <stream-message/>
        <message>
          <body><data>{"id": 2, "username": "bob", "email": "bob@example.com", "phone": "555-2"}</data></body>
        </message>
      </send>
    </grpc>

    <grpc server="simulator">
      <receive>
        <stream-message/>
        <message>
          <body><data>{"id": 2, "username": "bob", "email": "bob@example.com", "phone": "555-2"}</data></body>
        </message>
      </receive>
    </grpc>

    <grpc client="client">
      <send>
        <stream-completed/>
      </send>
    </grpc>

    <grpc server="simulator">
      <receive>
        <stream-completed/>
      </receive>
    </grpc>

    <grpc server="simulator">
      <send>
        <stream-completed status="OK"/>
      </send>
    </grpc>

    <grpc client="client">
      <receive>
        <stream-completed status="OK"/>
      </receive>
    </grpc>
  </actions>
</test>
