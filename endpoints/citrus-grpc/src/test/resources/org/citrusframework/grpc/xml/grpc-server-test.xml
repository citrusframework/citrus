<test name="GrpcServerTest" author="Citrus" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <actions>
    <grpc server="grpcServer">
      <receive>
        <call>helloworld.Greeter/SayHello</call>
        <metadata name="authorization">Bearer token</metadata>
        <message>
          <body><data>{"name": "Ada"}</data></body>
        </message>
      </receive>
    </grpc>

    <grpc server="grpcServer">
      <receive>
        <stream-message/>
        <message>
          <body><data>{"id": 2}</data></body>
        </message>
      </receive>
    </grpc>

    <grpc server="grpcServer">
      <receive>
        <stream-completed/>
      </receive>
    </grpc>

    <grpc server="grpcServer">
      <send>
        <response status="OK"/>
        <trailer name="x-trailer">42</trailer>
        <message>
          <body><data>{"message": "Hello Ada"}</data></body>
        </message>
      </send>
    </grpc>

    <grpc server="grpcServer">
      <send>
        <stream-message/>
        <message>
          <body><data>{"symbol": "ACME"}</data></body>
        </message>
      </send>
    </grpc>

    <grpc server="grpcServer">
      <send>
        <stream-completed status="OK"/>
      </send>
    </grpc>
  </actions>
</test>
