<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="VertxSyncEndpointIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test synchronously sends and receives messages to/from Vert.x event bus.</description>
  <actions>
    <echo>
      <message>Test: Send Vert.x message on event bus and receive synchronous reply</message>
    </echo>
    <send endpoint="vertxHelloEndpoint" fork="true">
      <message type="plaintext">
        <body>
          <data>Hello from Citrus!</data>
        </body>
      </message>
    </send>
    <receive endpoint="vertxReplyEndpoint">
      <message type="plaintext">
        <headers>
          <header name="citrus_vertx_address" value="hello"/>
        </headers>
        <body>
          <data>Hello from Citrus!</data>
        </body>
      </message>
    </receive>
    <send endpoint="vertxReplyEndpoint">
      <message type="plaintext">
        <body>
          <data>Hello from Vert.x!</data>
        </body>
      </message>
    </send>
    <receive endpoint="vertxHelloEndpoint">
      <message type="plaintext">
        <body>
          <data>Hello from Vert.x!</data>
        </body>
      </message>
    </receive>
  </actions>
</test>
