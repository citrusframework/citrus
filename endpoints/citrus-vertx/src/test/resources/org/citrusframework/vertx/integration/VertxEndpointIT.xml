<?xml version="1.0" encoding="UTF-8"?>
<spring:beans xmlns="http://www.citrusframework.org/schema/testcase"
              xmlns:spring="http://www.springframework.org/schema/beans"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
                                  http://www.citrusframework.org/schema/testcase http://www.citrusframework.org/schema/testcase/citrus-testcase.xsd">

  <testcase name="VertxEndpointIT">
    <meta-info>
      <author>Christoph Deppisch</author>
      <creationdate>2014-05-14</creationdate>
      <status>FINAL</status>
      <last-updated-by>Christoph Deppisch</last-updated-by>
      <last-updated-on>2014-05-14T00:00:00</last-updated-on>
    </meta-info>

    <description>Test sends and receives messages to/from Vert.x event bus.</description>

    <actions>
      <echo>
        <message>Test: Send Vert.x message on event bus</message>
      </echo>

      <!--
        The endpoint publishes (pub/sub), so only consumers registered at publish time get the message.
        Start the shared clustered Vert.x instance up front, so that its startup time does not overlap
        with the consumer registration below.
      -->
      <assert exception="org.citrusframework.exceptions.MessageTimeoutException">
        <when>
          <receive endpoint="vertxNewsEndpoint" timeout="100">
            <message type="plaintext"/>
          </receive>
        </when>
      </assert>

      <parallel>
        <receive endpoint="vertxNewsEndpoint" timeout="5000">
          <message type="plaintext">
            <data>News from Citrus! Today is citrus:currentDate()</data>
          </message>
          <header>
            <element name="citrus_vertx_address" value="news"/>
          </header>
        </receive>

        <sequential>
          <!-- Give the consumer time to register on the event bus before publishing -->
          <sleep milliseconds="500"/>

          <send endpoint="vertxNewsEndpoint">
            <message type="plaintext">
              <data>News from Citrus! Today is citrus:currentDate()</data>
            </message>
          </send>
        </sequential>
      </parallel>

    </actions>
  </testcase>
</spring:beans>
