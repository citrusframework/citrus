<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="VertxEndpointIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test sends and receives messages to/from Vert.x event bus.</description>
  <actions>
    <echo>
      <message>Test: Send Vert.x message on event bus</message>
    </echo>
    <assert exception="org.citrusframework.exceptions.MessageTimeoutException">
      <when>
        <receive endpoint="vertxNewsEndpoint" timeout="100">
          <message type="plaintext"/>
        </receive>
      </when>
    </assert>
    <parallel>
      <actions>
        <receive endpoint="vertxNewsEndpoint" timeout="5000">
          <message type="plaintext">
            <headers>
              <header name="citrus_vertx_address" value="news"/>
            </headers>
            <body>
              <data>News from Citrus! Today is citrus:currentDate()</data>
            </body>
          </message>
        </receive>
        <sequential>
          <actions>
            <sleep milliseconds="500"/>
            <send endpoint="vertxNewsEndpoint">
              <message type="plaintext">
                <body>
                  <data>News from Citrus! Today is citrus:currentDate()</data>
                </body>
              </message>
            </send>
          </actions>
        </sequential>
      </actions>
    </parallel>
  </actions>
</test>
