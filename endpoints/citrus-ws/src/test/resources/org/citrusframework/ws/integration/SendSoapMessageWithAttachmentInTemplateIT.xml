<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Reinhard Steiner" name="SendSoapMessageWithAttachmentInTemplateIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <!-- MIGRATION WARNING: Template 'upload-image-file' defined in the Spring XML test source has been migrated to a separate template file - please make it available to the apply-template action -->
  <description>Sending SOAP messages with mtom attachments</description>
  <variables>
    <variable name="test" value="This string should not be inserted into binary SOAP attachments"/>
    <variable name="imageFile" value="classpath:org/citrusframework/ws/soapImage.txt"/>
    <variable name="iconFile" value="classpath:org/citrusframework/ws/soapIcon.txt"/>
  </variables>
  <actions>
    <echo>
      <message>Test: Upload file 1 using upload template, validate that correct file was sent</message>
    </echo>
    <parallel>
      <actions>
        <apply-template name="upload-image-file" file="classpath:org/citrusframework/ws/integration/SendSoapMessageWithAttachmentInTemplateIT-upload-image-file.xml">
          <parameters>
            <parameter name="paramImageFile" value="${imageFile}"/>
          </parameters>
        </apply-template>
        <sequential>
          <actions>
            <soap endpoint="echoSoapServer">
              <receive-response>
                <message schema-validation="false">
                  <body>
                    <data><![CDATA[<image:addImage xmlns:image="http://citrusframework.org/imageService/">
                    <isbn>1234</isbn>
                    <image><xop:Include xmlns:xop="http://www.w3.org/2004/08/xop/include" href="cid:IMAGE"/></image>
                    <icon></icon>
                  </image:addImage>]]></data>
                  </body>
                  <attachment content-id="IMAGE" content-type="application/octet-stream">
                    <resource file="${imageFile}"/>
                  </attachment>
                </message>
              </receive-response>
            </soap>
            <soap endpoint="echoSoapServer">
              <send-request>
                <message>
                  <body>
                    <data><![CDATA[<image:addImageResponse xmlns:image="http://citrusframework.org/imageService/">
                    <success>true</success>
                  </image:addImageResponse>]]></data>
                  </body>
                </message>
              </send-request>
            </soap>
          </actions>
        </sequential>
      </actions>
    </parallel>
    <echo>
      <message>Test: Upload file 2 using upload template, validate that correct file was sent</message>
    </echo>
    <parallel>
      <actions>
        <apply-template name="upload-image-file" file="classpath:org/citrusframework/ws/integration/SendSoapMessageWithAttachmentInTemplateIT-upload-image-file.xml">
          <parameters>
            <parameter name="paramImageFile" value="${iconFile}"/>
          </parameters>
        </apply-template>
        <sequential>
          <actions>
            <soap endpoint="echoSoapServer">
              <receive-response>
                <message schema-validation="false">
                  <body>
                    <data><![CDATA[<image:addImage xmlns:image="http://citrusframework.org/imageService/">
                    <isbn>1234</isbn>
                    <image><xop:Include xmlns:xop="http://www.w3.org/2004/08/xop/include" href="cid:IMAGE"/></image>
                    <icon></icon>
                  </image:addImage>]]></data>
                  </body>
                  <attachment content-id="IMAGE" content-type="application/octet-stream">
                    <resource file="${iconFile}"/>
                  </attachment>
                </message>
              </receive-response>
            </soap>
            <soap endpoint="echoSoapServer">
              <send-request>
                <message>
                  <body>
                    <data><![CDATA[<image:addImageResponse xmlns:image="http://citrusframework.org/imageService/">
                    <success>true</success>
                  </image:addImageResponse>]]></data>
                  </body>
                </message>
              </send-request>
            </soap>
          </actions>
        </sequential>
      </actions>
    </parallel>
  </actions>
</test>
