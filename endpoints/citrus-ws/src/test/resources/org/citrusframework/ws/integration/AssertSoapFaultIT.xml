<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="AssertSoapFaultIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Asserting SOAP faults</description>
  <variables>
    <variable name="soapFaultCode" value="TEC-1001"/>
    <variable name="soapFaultString" value="Invalid request"/>
  </variables>
  <actions>
    <soap client="helloSoapClient">
      <assert-fault fault-code="{http://citrusframework.org/faults}TEC-1001" fault-string="Invalid request">
        <when>
          <send endpoint="helloSoapClient">
            <message>
              <body>
                <data><![CDATA[<ns0:SoapFaultForcingRequest xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                      <ns0:Message>This is invalid</ns0:Message>
                    </ns0:SoapFaultForcingRequest>]]></data>
              </body>
            </message>
          </send>
        </when>
      </assert-fault>
    </soap>
    <soap client="helloSoapClient">
      <assert-fault fault-code="{http://citrusframework.org/faults}TEC-1001" fault-string="@ignore@">
        <when>
          <send endpoint="helloSoapClient">
            <message>
              <body>
                <data><![CDATA[<ns0:SoapFaultForcingRequest xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                      <ns0:Message>This is invalid</ns0:Message>
                    </ns0:SoapFaultForcingRequest>]]></data>
              </body>
            </message>
          </send>
        </when>
      </assert-fault>
    </soap>
    <soap client="helloSoapClient">
      <assert-fault fault-code="{http://citrusframework.org/faults}${soapFaultCode}" fault-string="${soapFaultString}">
        <when>
          <send endpoint="helloSoapClient">
            <message>
              <body>
                <data><![CDATA[<ns0:SoapFaultForcingRequest xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                      <ns0:Message>This is invalid</ns0:Message>
                    </ns0:SoapFaultForcingRequest>]]></data>
              </body>
            </message>
          </send>
        </when>
      </assert-fault>
    </soap>
  </actions>
</test>
