<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="SendSoapMessageWithAttachmentIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Sending SOAP messages with attachments</description>
  <actions>
    <parallel>
      <actions>
        <soap endpoint="helloSoapClient">
          <send-request>
            <message>
              <body>
                <data><![CDATA[<ns0:SoapMessageWithAttachmentRequest xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                  <ns0:Operation>Read the attachment</ns0:Operation>
                </ns0:SoapMessageWithAttachmentRequest>]]></data>
              </body>
              <attachment content-id="MySoapAttachment" content-type="text/plain">
                <resource file="classpath:org/citrusframework/ws/soapAttachment.txt"/>
              </attachment>
            </message>
          </send-request>
        </soap>
        <sequential>
          <actions>
            <soap endpoint="soapRequestEndpoint">
              <receive-response>
                <message schema-validation="false">
                  <body>
                    <data><![CDATA[<ns0:SoapMessageWithAttachmentRequest xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                    <ns0:Operation>Read the attachment</ns0:Operation>
                  </ns0:SoapMessageWithAttachmentRequest>]]></data>
                  </body>
                  <attachment content-id="MySoapAttachment" content-type="text/plain">
                    <resource file="classpath:org/citrusframework/ws/soapAttachment.txt"/>
                  </attachment>
                </message>
                <extract>
                  <header name="citrus_jms_messageId" variable="internal_correlation_id"/>
                </extract>
              </receive-response>
            </soap>
            <send endpoint="soapResponseEndpoint">
              <message>
                <headers>
                  <header name="citrus_jms_correlationId" value="${internal_correlation_id}"/>
                </headers>
                <body>
                  <data><![CDATA[<ns0:SoapMessageWithAttachmentResponse xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                    <ns0:Operation>Read the attachment</ns0:Operation>
                    <ns0:Success>true</ns0:Success>
                  </ns0:SoapMessageWithAttachmentResponse>]]></data>
                </body>
              </message>
            </send>
          </actions>
        </sequential>
      </actions>
    </parallel>
    <receive endpoint="helloSoapClient">
      <message schema-validation="false">
        <body>
          <data><![CDATA[<ns0:SoapMessageWithAttachmentResponse xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <ns0:Operation>Read the attachment</ns0:Operation>
                <ns0:Success>true</ns0:Success>
              </ns0:SoapMessageWithAttachmentResponse>]]></data>
        </body>
      </message>
    </receive>
    <parallel>
      <actions>
        <soap endpoint="helloSoapClient">
          <send-request>
            <message>
              <body>
                <data><![CDATA[<ns0:SoapMessageWithAttachmentRequest xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                  <ns0:Operation>Read the attachment</ns0:Operation>
                </ns0:SoapMessageWithAttachmentRequest>]]></data>
              </body>
              <attachment content-id="MySoapAttachment" content-type="text/plain">
                <content>This is an attachment!</content>
              </attachment>
            </message>
          </send-request>
        </soap>
        <sequential>
          <actions>
            <soap endpoint="soapRequestEndpoint">
              <receive-response>
                <message schema-validation="false">
                  <body>
                    <data><![CDATA[<ns0:SoapMessageWithAttachmentRequest xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                    <ns0:Operation>Read the attachment</ns0:Operation>
                  </ns0:SoapMessageWithAttachmentRequest>]]></data>
                  </body>
                  <attachment content-id="MySoapAttachment" content-type="text/plain">
                    <content>This is an attachment!</content>
                  </attachment>
                </message>
                <extract>
                  <header name="citrus_jms_messageId" variable="internal_correlation_id"/>
                </extract>
              </receive-response>
            </soap>
            <send endpoint="soapResponseEndpoint">
              <message>
                <headers>
                  <header name="citrus_jms_correlationId" value="${internal_correlation_id}"/>
                </headers>
                <body>
                  <data><![CDATA[<ns0:SoapMessageWithAttachmentResponse xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                    <ns0:Operation>Read the attachment</ns0:Operation>
                    <ns0:Success>true</ns0:Success>
                  </ns0:SoapMessageWithAttachmentResponse>]]></data>
                </body>
              </message>
            </send>
          </actions>
        </sequential>
      </actions>
    </parallel>
    <receive endpoint="helloSoapClient">
      <message schema-validation="false">
        <body>
          <data><![CDATA[<ns0:SoapMessageWithAttachmentResponse xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <ns0:Operation>Read the attachment</ns0:Operation>
                <ns0:Success>true</ns0:Success>
              </ns0:SoapMessageWithAttachmentResponse>]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
