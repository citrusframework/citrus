<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="SoapSchemaValidationNamespaceDiffIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Validating SOAP message with special WSDL using imports. The WSDL schema and local XSD schema names are different.</description>
  <actions>
    <echo>
      <message>Test: Sending valid SOAP message</message>
    </echo>
    <parallel>
      <actions>
        <send endpoint="echoSoapClient">
          <message>
            <body>
              <data><![CDATA[<sample:sampleMessage xmlns:sample="http://citrusframework.org/SampleService/Commands/">
                  <command>hello</command>
                  <message>FOO</message>
                </sample:sampleMessage>]]></data>
            </body>
          </message>
        </send>
        <sequential>
          <actions>
            <receive endpoint="echoSoapServer">
              <message schema-repository="sampleServiceSchemaNamespaceDiffRepository">
                <body>
                  <data><![CDATA[<sample:sampleMessage xmlns:sample="http://citrusframework.org/SampleService/Commands/">
                    <command>hello</command>
                    <message>FOO</message>
                  </sample:sampleMessage>]]></data>
                </body>
              </message>
            </receive>
            <send endpoint="echoSoapServer">
              <message>
                <body>
                  <data><![CDATA[<sample:sampleMessageResponse xmlns:sample="http://citrusframework.org/SampleService/Commands/">
                    <response>success</response>
                    <message>BAR</message>
                  </sample:sampleMessageResponse>]]></data>
                </body>
              </message>
            </send>
          </actions>
        </sequential>
      </actions>
    </parallel>
    <receive endpoint="echoSoapClient">
      <message schema-repository="sampleServiceSchemaNamespaceDiffRepository">
        <body>
          <data><![CDATA[<sample:sampleMessageResponse xmlns:sample="http://citrusframework.org/SampleService/Commands/">
                <response>success</response>
                <message>BAR</message>
              </sample:sampleMessageResponse>]]></data>
        </body>
      </message>
    </receive>
    <echo>
      <message>Test: Sending invalid SOAP message</message>
    </echo>
    <parallel>
      <actions>
        <send endpoint="echoSoapClient">
          <message>
            <body>
              <data><![CDATA[<sample:sampleMessage xmlns:sample="http://citrusframework.org/SampleService/Commands/">
                  <command>hello</command>
                  <message>FOO-wrong</message>
                </sample:sampleMessage>]]></data>
            </body>
          </message>
        </send>
        <sequential>
          <actions>
            <assert exception="org.citrusframework.exceptions.ValidationException">
              <when>
                <receive endpoint="echoSoapServer">
                  <message schema-repository="sampleServiceSchemaNamespaceDiffRepository">
                    <body>
                      <data><![CDATA[<sample:sampleMessage xmlns:sample="http://citrusframework.org/SampleService/Commands/">
                        <command>hello</command>
                        <message>FOO-wrong</message>
                      </sample:sampleMessage>]]></data>
                    </body>
                  </message>
                </receive>
              </when>
            </assert>
            <send endpoint="echoSoapServer">
              <message>
                <body>
                  <data><![CDATA[<sample:sampleMessageResponse xmlns:sample="http://citrusframework.org/SampleService/Commands/">
                    <response>success</response>
                    <message>BAR-wrong</message>
                  </sample:sampleMessageResponse>]]></data>
                </body>
              </message>
            </send>
          </actions>
        </sequential>
      </actions>
    </parallel>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <receive endpoint="echoSoapClient">
          <message schema-repository="sampleServiceSchemaNamespaceDiffRepository">
            <body>
              <data><![CDATA[<sample:sampleMessageResponse xmlns:sample="http://citrusframework.org/SampleService/Commands/">
                    <response>success</response>
                    <message>BAR-wrong</message>
                  </sample:sampleMessageResponse>]]></data>
            </body>
          </message>
        </receive>
      </when>
    </assert>
  </actions>
</test>
