<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="WebServiceServer_2_IT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test receives SOAP messages as Http server instance and sends proper SOAP response back to client.</description>
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Christoph"/>
  </variables>
  <actions>
    <echo>
      <message>Test: Receive Http SOAP request via server instance and send back SOAP response.</message>
    </echo>
    <send endpoint="echoSoapClient" fork="true">
      <message>
        <headers>
          <header name="{http://citrusframework.org/test}Operation" value="sayHello"/>
          <header name="{http://citrusframework.org/test}CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageId}</MessageId>
                <CorrelationId>${correlationId}</CorrelationId>
                <User>${user}</User>
                <Text>Hello Citrus</Text>
              </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="echoSoapServer">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageId}</MessageId>
                <CorrelationId>${correlationId}</CorrelationId>
                <User>${user}</User>
                <Text>Hello Citrus</Text>
              </HelloRequest>]]></data>
        </body>
      </message>
    </receive>
    <send endpoint="echoSoapServer">
      <message>
        <headers>
          <header name="{http://citrusframework.org/test}Operation" value="sayHello"/>
          <header name="{http://citrusframework.org/test}CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageId}</MessageId>
                <CorrelationId>${correlationId}</CorrelationId>
                <User>HelloService</User>
                <Text>Hello ${user}</Text>
              </HelloResponse>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="echoSoapClient">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageId}</MessageId>
                <CorrelationId>${correlationId}</CorrelationId>
                <User>HelloService</User>
                <Text>Hello ${user}</Text>
              </HelloResponse>]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
