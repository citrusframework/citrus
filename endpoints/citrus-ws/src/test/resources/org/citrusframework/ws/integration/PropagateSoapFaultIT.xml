<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="PropagateSoapFaultIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <variables>
    <variable name="soapFaultCode" value="TEC-1001"/>
    <variable name="soapFaultString" value="Invalid request"/>
  </variables>
  <actions>
    <send endpoint="helloSoapFaultClient">
      <message>
        <body>
          <data><![CDATA[<ns0:SoapFaultForcingRequest xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <ns0:Message>This is invalid</ns0:Message>
              </ns0:SoapFaultForcingRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloSoapFaultClient" timeout="5000">
      <message schema-validation="false">
        <body>
          <data><![CDATA[<SOAP-ENV:Fault xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/">
                <faultcode xmlns:CITRUS="http://citrusframework.org/faults">CITRUS:${soapFaultCode}</faultcode>
                <faultstring xml:lang="en">${soapFaultString}</faultstring>
              </SOAP-ENV:Fault>]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
