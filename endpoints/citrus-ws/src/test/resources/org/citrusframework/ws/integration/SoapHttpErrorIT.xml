<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="SoapHttpErrorIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Christoph"/>
  </variables>
  <actions>
    <parallel>
      <actions>
        <assert exception="org.springframework.ws.client.WebServiceTransportException" message="Server Error [500]">
          <when>
            <soap endpoint="helloSoapClient">
              <send-request>
                <message soap-action="sayHello">
                  <headers>
                    <header name="{http://citrusframework.org/test}Operation" value="sayHello"/>
                    <header name="citrus_http_operation" value="sayHello"/>
                  </headers>
                  <body>
                    <data><![CDATA[<ns0:HelloRequest xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                      <ns0:MessageId>${messageId}</ns0:MessageId>
                      <ns0:CorrelationId>${correlationId}</ns0:CorrelationId>
                      <ns0:User>${user}</ns0:User>
                      <ns0:Text>Hello WebServer</ns0:Text>
                    </ns0:HelloRequest>]]></data>
                  </body>
                </message>
              </send-request>
            </soap>
          </when>
        </assert>
        <sequential>
          <actions>
            <!-- MIGRATION WARNING: The 'soap-action' and 'accept' attributes are not supported by the SOAP response in the plain XML DSL and have been removed -->
            <soap endpoint="soapRequestEndpoint">
              <receive-response>
                <message schema-validation="false">
                  <headers>
                    <header name="Operation" value="sayHello"/>
                    <header name="operation" value="sayHello"/>
                  </headers>
                  <body>
                    <data><![CDATA[<ns0:HelloRequest xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
    								<ns0:MessageId>${messageId}</ns0:MessageId>
    								<ns0:CorrelationId>${correlationId}</ns0:CorrelationId>
    								<ns0:User>${user}</ns0:User>
    								<ns0:Text>Hello WebServer</ns0:Text>
    							</ns0:HelloRequest>]]></data>
                  </body>
                </message>
                <extract>
                  <header name="citrus_jms_messageId" variable="internal_correlation_id"/>
                </extract>
              </receive-response>
            </soap>
            <send endpoint="soapResponseEndpoint">
              <message>
                <headers>
                  <header name="citrus_http_status_code" value="500"/>
                  <header name="citrus_jms_correlationId" value="${internal_correlation_id}"/>
                </headers>
                <body>
                  <data/>
                </body>
              </message>
            </send>
          </actions>
        </sequential>
      </actions>
    </parallel>
  </actions>
</test>
