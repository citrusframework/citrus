<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="WebServiceServer_5_IT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test receives SOAP messages as Http server instance and sends proper SOAP response back to client.</description>
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Christoph"/>
  </variables>
  <actions>
    <echo>
      <message>Test: Receive Http SOAP request via server instance and send back SOAP response.</message>
    </echo>
    <send endpoint="echoHttpClient" fork="true">
      <message>
        <headers>
          <header name="SOAPAction" value="HelloService/sayHello"/>
          <header name="Content-Type" value="text/xml;charset=utf-8"/>
        </headers>
        <body>
          <data><![CDATA[<SOAP-ENV:Envelope xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/"
                                  xmlns:hello="http://citrusframework.org/schemas/samples/HelloService.xsd"
                                  xmlns:header="http://citrusframework.org/header"
                                  xmlns:types="http://citrusframework.org/schemas/types"
                                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <SOAP-ENV:Header>
                  <header:Operation>sayHello</header:Operation>
                  <header:CorrelationId>${correlationId}</header:CorrelationId>
                </SOAP-ENV:Header>
                <SOAP-ENV:Body>
                  <hello:HelloRequest>
                    <hello:MessageId>${messageId}</hello:MessageId>
                    <hello:CorrelationId>${correlationId}</hello:CorrelationId>
                    <hello:User>${user}</hello:User>
                    <hello:Text>Hello Citrus</hello:Text>
                    <hello:Type xsi:type="types:HelloType"/>
                  </hello:HelloRequest>
                </SOAP-ENV:Body>
              </SOAP-ENV:Envelope>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="echoSoapServer">
      <message>
        <headers>
          <header name="citrus_soap_action" value="HelloService/sayHello"/>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<hello:HelloRequest xmlns:hello="http://citrusframework.org/schemas/samples/HelloService.xsd"
                                  xmlns:types="http://citrusframework.org/schemas/types"
                                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <hello:MessageId>${messageId}</hello:MessageId>
                <hello:CorrelationId>${correlationId}</hello:CorrelationId>
                <hello:User>${user}</hello:User>
                <hello:Text>Hello Citrus</hello:Text>
                <hello:Type xsi:type="types:HelloType"/>
              </hello:HelloRequest>]]></data>
        </body>
      </message>
    </receive>
    <send endpoint="echoSoapServer">
      <message>
        <headers>
          <header name="citrus_soap_action" value="HelloService/sayHello"/>
          <header name="{http://citrusframework.org/test}Operation" value="sayHello"/>
          <header name="{http://citrusframework.org/test}CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageId}</MessageId>
                <CorrelationId>${correlationId}</CorrelationId>
                <User>HelloService</User>
                <Text>Hello ${user}</Text>
              </HelloResponse>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="echoHttpClient">
      <message>
        <headers>
          <header name="SOAPAction" value="&quot;HelloService/sayHello&quot;"/>
          <header name="Content-Type" value="text/xml;charset=utf-8"/>
        </headers>
        <body>
          <data><![CDATA[<SOAP-ENV:Envelope xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/">
                <SOAP-ENV:Header>
                  <Operation xmlns="http://citrusframework.org/test">sayHello</Operation>
                  <CorrelationId xmlns="http://citrusframework.org/test">${correlationId}</CorrelationId>
                </SOAP-ENV:Header>
                <SOAP-ENV:Body>
                  <HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                    <MessageId>${messageId}</MessageId>
                    <CorrelationId>${correlationId}</CorrelationId>
                    <User>HelloService</User>
                    <Text>Hello ${user}</Text>
                  </HelloResponse>
                </SOAP-ENV:Body>
              </SOAP-ENV:Envelope>]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
