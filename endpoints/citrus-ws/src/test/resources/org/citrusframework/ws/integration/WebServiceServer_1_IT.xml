<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="WebServiceServer_1_IT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Christoph"/>
  </variables>
  <actions>
    <parallel>
      <actions>
        <send endpoint="helloSoapClient">
          <message>
            <headers>
              <header name="{http://citrusframework.org/test}Operation" value="sayHello"/>
            </headers>
            <body>
              <data><![CDATA[<ns0:HelloRequest xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                  <ns0:MessageId>${messageId}</ns0:MessageId>
                  <ns0:CorrelationId>${correlationId}</ns0:CorrelationId>
                  <ns0:User>${user}</ns0:User>
                  <ns0:Text>Hello WebServer</ns0:Text>
                </ns0:HelloRequest>]]></data>
            </body>
          </message>
        </send>
        <sequential>
          <actions>
            <receive endpoint="soapRequestEndpoint">
              <message schema-validation="false">
                <headers>
                  <header name="Operation" value="sayHello"/>
                </headers>
                <body>
                  <data><![CDATA[<ns0:HelloRequest xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                    <ns0:MessageId>${messageId}</ns0:MessageId>
                    <ns0:CorrelationId>${correlationId}</ns0:CorrelationId>
                    <ns0:User>${user}</ns0:User>
                    <ns0:Text>Hello WebServer</ns0:Text>
                  </ns0:HelloRequest>]]></data>
                </body>
              </message>
              <extract>
                <header name="citrus_jms_messageId" variable="internal_correlation_id"/>
              </extract>
            </receive>
            <send endpoint="soapResponseEndpoint">
              <message>
                <headers>
                  <header name="citrus_jms_correlationId" value="${internal_correlation_id}"/>
                </headers>
                <body>
                  <data><![CDATA[<ns0:HelloResponse xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                    <ns0:MessageId>${messageId}</ns0:MessageId>
                    <ns0:CorrelationId>${correlationId}</ns0:CorrelationId>
                    <ns0:User>WebServer</ns0:User>
                    <ns0:Text>Hello ${user}</ns0:Text>
                  </ns0:HelloResponse>]]></data>
                </body>
              </message>
            </send>
          </actions>
        </sequential>
      </actions>
    </parallel>
    <receive endpoint="helloSoapClient">
      <message schema-validation="false">
        <body>
          <data><![CDATA[<ns0:HelloResponse xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <ns0:MessageId>${messageId}</ns0:MessageId>
                <ns0:CorrelationId>${correlationId}</ns0:CorrelationId>
                <ns0:User>WebServer</ns0:User>
                <ns0:Text>Hello ${user}</ns0:Text>
              </ns0:HelloResponse>]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
