<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="ServerSoapFaultIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Christoph"/>
  </variables>
  <actions>
    <parallel>
      <actions>
        <soap client="helloSoapClient">
          <assert-fault fault-code="{http://citrusframework.org/faults}TEC-1000" fault-string="Invalid request">
            <when>
              <send endpoint="helloSoapClient">
                <message>
                  <body>
                    <data><![CDATA[<ns0:HelloRequest xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                        <ns0:MessageId>${messageId}</ns0:MessageId>
                        <ns0:CorrelationId>${correlationId}</ns0:CorrelationId>
                        <ns0:User>${user}</ns0:User>
                        <ns0:Text>Hello WebServer</ns0:Text>
                      </ns0:HelloRequest>]]></data>
                  </body>
                </message>
              </send>
            </when>
          </assert-fault>
        </soap>
        <sequential>
          <actions>
            <receive endpoint="soapRequestEndpoint">
              <message schema-validation="false">
                <body>
                  <data><![CDATA[<ns0:HelloRequest xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                    <ns0:MessageId>${messageId}</ns0:MessageId>
                    <ns0:CorrelationId>${correlationId}</ns0:CorrelationId>
                    <ns0:User>${user}</ns0:User>
                    <ns0:Text>Hello WebServer</ns0:Text>
                  </ns0:HelloRequest>]]></data>
                </body>
              </message>
              <extract>
                <header name="citrus_jms_messageId" variable="internal_correlation_id"/>
              </extract>
            </receive>
            <soap server="soapResponseEndpoint">
              <send-fault>
                <message fault-code="{http://citrusframework.org/faults}citrus-ns:TEC-1000" fault-string="Invalid request">
                  <headers>
                    <header name="citrus_jms_correlationId" value="${internal_correlation_id}"/>
                  </headers>
                  <fault-detail>
                    <content><![CDATA[<ns0:FaultDetail xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                    <ns0:MessageId>${messageId}</ns0:MessageId>
                    <ns0:CorrelationId>${correlationId}</ns0:CorrelationId>
                    <ns0:ErrorCode>TEC-1000</ns0:ErrorCode>
                    <ns0:Text>Invalid request</ns0:Text>
                  </ns0:FaultDetail>]]></content>
                  </fault-detail>
                </message>
              </send-fault>
            </soap>
          </actions>
        </sequential>
      </actions>
