<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="WsAddressingIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <variables>
    <variable name="messageId" value="123456789"/>
    <variable name="correlationId" value="CORR123456789"/>
  </variables>
  <actions>
    <soap client="helloWsAddressingSoapClient">
      <assert-fault fault-code="{http://schemas.xmlsoap.org/soap/envelope/}SOAP-ENV:MustUnderstand" fault-string="One or more mandatory SOAP header blocks not understood">
        <when>
          <send endpoint="helloWsAddressingSoapClient">
            <message>
              <headers>
                <header name="{http://citrusframework.org/schemas/samples/HelloService.xsd}ns0:Request" value="HelloRequest"/>
                <header name="{http://citrusframework.org/schemas/samples/HelloService.xsd}ns0:Operation" value="sayHello"/>
              </headers>
              <body>
                <data><![CDATA[<ns0:HelloStandaloneRequest xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                      <ns0:MessageId>${messageId}</ns0:MessageId>
                      <ns0:CorrelationId>${correlationId}</ns0:CorrelationId>
                      <ns0:User>User</ns0:User>
                      <ns0:Text>Hello WebServer</ns0:Text>
                    </ns0:HelloStandaloneRequest>]]></data>
              </body>
            </message>
          </send>
        </when>
      </assert-fault>
    </soap>
  </actions>
</test>
