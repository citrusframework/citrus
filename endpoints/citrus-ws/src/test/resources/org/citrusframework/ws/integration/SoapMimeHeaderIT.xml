<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="SoapMimeHeaderIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Christoph"/>
  </variables>
  <actions>
    <soap endpoint="helloSoapClient">
      <send-request fork="true">
        <message soap-action="sayHello">
          <headers>
            <header name="citrus_endpoint_uri" value="http://localhost:13080/hello/endpoint?timeout=1000"/>
            <header name="{http://citrusframework.org/test}Operation" value="sayHello"/>
            <header name="citrus_http_operation" value="sayHello"/>
          </headers>
          <body>
            <data><![CDATA[<ns0:HelloRequest xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <ns0:MessageId>${messageId}</ns0:MessageId>
                <ns0:CorrelationId>${correlationId}</ns0:CorrelationId>
                <ns0:User>${user}</ns0:User>
                <ns0:Text>Hello WebServer</ns0:Text>
              </ns0:HelloRequest>]]></data>
          </body>
        </message>
      </send-request>
    </soap>
    <!-- MIGRATION WARNING: The 'soap-action' and 'accept' attributes are not supported by the SOAP response in the plain XML DSL and have been removed -->
    <soap endpoint="soapRequestEndpoint">
      <receive-response>
        <message schema-validation="false">
          <headers>
            <header name="Operation" value="sayHello"/>
            <header name="operation" value="sayHello"/>
            <header name="citrus_http_request_uri" value="/hello/endpoint"/>
            <header name="citrus_http_method" value="POST"/>
            <header name="citrus_http_context_path" value=""/>
            <header name="citrus_http_query_params" value="timeout=1000"/>
          </headers>
          <body>
            <data><![CDATA[<ns0:HelloRequest xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
								<ns0:MessageId>${messageId}</ns0:MessageId>
								<ns0:CorrelationId>${correlationId}</ns0:CorrelationId>
								<ns0:User>${user}</ns0:User>
								<ns0:Text>Hello WebServer</ns0:Text>
							</ns0:HelloRequest>]]></data>
          </body>
        </message>
        <extract>
          <header name="citrus_jms_messageId" variable="internal_correlation_id"/>
        </extract>
      </receive-response>
    </soap>
    <send endpoint="soapResponseEndpoint">
      <message>
        <headers>
          <header name="{http://citrusframework.org/test}Operation" value="answerHello"/>
          <header name="citrus_http_operation" value="answerHello"/>
          <header name="citrus_jms_correlationId" value="${internal_correlation_id}"/>
        </headers>
        <body>
          <data><![CDATA[<ns0:HelloResponse xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
								<ns0:MessageId>${messageId}</ns0:MessageId>
								<ns0:CorrelationId>${correlationId}</ns0:CorrelationId>
								<ns0:User>WebServer</ns0:User>
								<ns0:Text>Hello ${user}</ns0:Text>
							</ns0:HelloResponse>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloSoapClient" timeout="5000">
      <message schema-validation="false">
        <headers>
          <header name="Operation" value="answerHello"/>
          <header name="operation" value="answerHello"/>
        </headers>
        <body>
          <data><![CDATA[<ns0:HelloResponse xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <ns0:MessageId>${messageId}</ns0:MessageId>
                <ns0:CorrelationId>${correlationId}</ns0:CorrelationId>
                <ns0:User>WebServer</ns0:User>
                <ns0:Text>Hello ${user}</ns0:Text>
              </ns0:HelloResponse>]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
