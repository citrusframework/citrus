<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Martin Maher" name="ZooExecuteIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test zookeeper container command execution with zookeeper client.</description>
  <variables>
    <variable name="randomString" value="citrus:randomString(10)"/>
  </variables>
  <actions>
    <echo>
      <message>Validate zookeeper API version</message>
    </echo>
    <zookeeper client="zookeeperClient" result="{&#10;                &quot;responseData&quot;:{&#10;                    &quot;state&quot;:&quot;@ignore@&quot;,&#10;                    &quot;sessionPwd&quot;:&quot;@ignore@&quot;,&#10;                    &quot;sessionTimeout&quot;:&quot;@ignore@&quot;,&#10;                    &quot;sessionId&quot;:&quot;@ignore@&quot;&#10;                }&#10;              }">
      <info/>
      <validate path="$.responseData.state" value="CONNECTED"/>
      <extract path="$.responseData.sessionId" variable="sessionId"/>
    </zookeeper>
    <zookeeper client="zookeeperClient" result="{&#10;                &quot;responseData&quot;:{&#10;                    &quot;state&quot;:&quot;@ignore@&quot;,&#10;                    &quot;sessionPwd&quot;:&quot;@ignore@&quot;,&#10;                    &quot;sessionTimeout&quot;:&quot;@ignore@&quot;,&#10;                    &quot;sessionId&quot;:${sessionId}&#10;                }&#10;              }">
      <info/>
    </zookeeper>
    <zookeeper client="zookeeperClient" result="{&#10;                &quot;responseData&quot;:{&#10;                    &quot;path&quot;:&quot;/${randomString}&quot;&#10;                }&#10;              }">
      <create acl="OPEN_ACL_UNSAFE" data="Some Data" mode="PERSISTENT" path="/${randomString}"/>
    </zookeeper>
    <zookeeper client="zookeeperClient" result="{&#10;              &quot;responseData&quot;:{&#10;                &quot;aversion&quot;:0,&#10;                &quot;czxid&quot;:&quot;@ignore@&quot;,&#10;                &quot;dataLength&quot;:9,&#10;                &quot;numChildren&quot;:0,&#10;                &quot;ctime&quot;:&quot;@ignore@&quot;,&#10;                &quot;ephemeralOwner&quot;:&quot;@ignore@&quot;,&#10;                &quot;pzxid&quot;:&quot;@ignore@&quot;,&#10;                &quot;cversion&quot;:0,&#10;                &quot;mtime&quot;:&quot;@ignore@&quot;,&#10;                &quot;version&quot;:0,&#10;                &quot;mzxid&quot;:&quot;@ignore@&quot;&#10;              }&#10;            }">
      <exists path="/${randomString}"/>
    </zookeeper>
    <zookeeper client="zookeeperClient" result="{&#10;              &quot;responseData&quot;:{&#10;                &quot;data&quot;:&quot;Some Data&quot;&#10;              }&#10;            }">
      <get path="/${randomString}"/>
    </zookeeper>
    <zookeeper client="zookeeperClient">
      <set data="overwrite data with this" path="/${randomString}"/>
    </zookeeper>
    <zookeeper client="zookeeperClient" result="{&#10;                &quot;responseData&quot;:{&#10;                    &quot;path&quot;:&quot;/${randomString}/child1&quot;&#10;                }&#10;              }">
      <create acl="OPEN_ACL_UNSAFE" data="" mode="EPHEMERAL" path="/${randomString}/child1"/>
    </zookeeper>
    <zookeeper client="zookeeperClient" result="{&#10;                &quot;responseData&quot;:{&#10;                    &quot;path&quot;:&quot;/${randomString}/child2&quot;&#10;                }&#10;              }">
      <create acl="OPEN_ACL_UNSAFE" data="" mode="EPHEMERAL" path="/${randomString}/child2"/>
    </zookeeper>
    <zookeeper client="zookeeperClient" result="{&#10;                &quot;responseData&quot;:{&#10;                    &quot;children&quot;:[&quot;child1&quot;,&quot;child2&quot;]&#10;                }&#10;              }">
      <children path="/${randomString}"/>
    </zookeeper>
    <zookeeper client="zookeeperClient" result="{&#10;              &quot;responseData&quot;:{&#10;                &quot;path&quot;:&quot;/${randomString}&quot;,&#10;                &quot;responseCode&quot;:-111&#10;              }&#10;            }">
      <delete path="/${randomString}" version="1"/>
    </zookeeper>
  </actions>
</test>
