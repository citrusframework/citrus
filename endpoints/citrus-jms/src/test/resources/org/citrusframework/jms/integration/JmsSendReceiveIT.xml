<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="JmsSendReceiveIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test asynchronous JMS communication.</description>
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="correlationIdA" value="citrus:randomNumber(10)"/>
    <variable name="correlationIdB" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="messageIdA" value="citrus:randomNumber(10)"/>
    <variable name="messageIdB" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Christoph"/>
  </variables>
  <actions>
    <echo>
      <message>Test 1: Send JMS request and receive async JMS response (inline CDATA payload)</message>
    </echo>
    <send endpoint="helloServiceJmsEndpoint">
      <description>Send asynchronous JMS request: Citrus -&gt; HelloService JmsDemo</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                 <MessageId>${messageId}</MessageId>
                 <CorrelationId>${correlationId}</CorrelationId>
                 <User>${user}</User>
                 <Text>Hello Citrus</Text>
               </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloServiceResponseJmsEndpoint">
      <description>Receive asynchronous JMS response: HelloService JmsDemo -&gt; Citrus</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageId}</MessageId>
                <CorrelationId>${correlationId}</CorrelationId>
                <User>HelloService</User>
                <Text>Hello ${user}</Text>
              </HelloResponse>]]></data>
        </body>
      </message>
    </receive>
    <echo>
      <message>Test 2: Send JMS request and receive async JMS response (file resource payload)</message>
    </echo>
    <send endpoint="helloServiceJmsEndpoint">
      <description>Send asynchronous JMS request: Citrus -&gt; HelloService JmsDemo</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <resource file="classpath:org/citrusframework/jms/integration/helloRequest.xml"/>
        </body>
      </message>
    </send>
    <receive endpoint="helloServiceResponseJmsEndpoint">
      <description>Receive asynchronous JMS response: HelloService JmsDemo -&gt; Citrus</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <resource file="classpath:org/citrusframework/jms/integration/helloResponse.xml"/>
        </body>
      </message>
    </receive>
    <echo>
      <message>Test 3: Send JMS request and receive async JMS response (JMS message selector)</message>
    </echo>
    <send endpoint="helloServiceJmsEndpoint">
      <description>Send asynchronous JMS request: Citrus -&gt; HelloService JmsDemo</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationIdA}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageIdA}</MessageId>
                <CorrelationId>${correlationIdA}</CorrelationId>
                <User>${user}</User>
                <Text>Hello Citrus first time</Text>
              </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <send endpoint="helloServiceJmsEndpoint">
      <description>Send asynchronous JMS request: Citrus -&gt; HelloService JmsDemo</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationIdB}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageIdB}</MessageId>
                <CorrelationId>${correlationIdB}</CorrelationId>
                <User>${user}</User>
                <Text>Hello Citrus second time</Text>
              </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloServiceResponseJmsEndpoint" timeout="500">
      <description>Receive second JMS response first: HelloService JmsDemo -&gt; Citrus</description>
      <selector>
        <element name="CorrelationId" value="${correlationIdB}"/>
      </selector>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationIdB}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageIdB}</MessageId>
                <CorrelationId>${correlationIdB}</CorrelationId>
                <User>HelloService</User>
                <Text>Hello ${user}</Text>
              </HelloResponse>]]></data>
        </body>
      </message>
    </receive>
    <receive endpoint="helloServiceResponseJmsEndpoint" timeout="500">
      <description>Receive first JMS response: HelloService JmsDemo -&gt; Citrus</description>
      <selector>
        <element name="CorrelationId" value="${correlationIdA}"/>
      </selector>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationIdA}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageIdA}</MessageId>
                <CorrelationId>${correlationIdA}</CorrelationId>
                <User>HelloService</User>
                <Text>Hello ${user}</Text>
              </HelloResponse>]]></data>
        </body>
      </message>
    </receive>
    <echo>
      <message>Test 4: Receive JMS message timeout response</message>
    </echo>
    <assert exception="org.citrusframework.exceptions.ActionTimeoutException">
      <when>
        <receive endpoint="helloServiceResponseJmsEndpoint" timeout="300">
          <description>Receive second JMS response first: HelloService JmsDemo -&gt; Citrus</description>
          <selector>
            <element name="CorrelationId" value="doesNotExist"/>
          </selector>
          <message>
            <headers>
              <header name="Operation" value="sayHello"/>
            </headers>
            <body>
              <data><![CDATA[<HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                    <MessageId>?</MessageId>
                    <CorrelationId>?</CorrelationId>
                    <User>HelloService</User>
                    <Text>Hello ?</Text>
                  </HelloResponse>]]></data>
            </body>
          </message>
        </receive>
      </when>
    </assert>
  </actions>
</test>
