<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="JmsTopic2IT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Christoph"/>
  </variables>
  <actions>
    <parallel>
      <actions>
        <receive endpoint="helloTopicRequestReceiver" timeout="5000">
          <description>Receive asynchronous hello response: HelloService -&gt; TestFramework</description>
          <message>
            <headers>
              <header name="Operation" value="sayHello"/>
              <header name="CorrelationId" value="${correlationId}"/>
            </headers>
            <body>
              <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                           <MessageId>${messageId}</MessageId>
                           <CorrelationId>${correlationId}</CorrelationId>
                           <User>${user}</User>
                           <Text>Hello TestFramework</Text>
                        </HelloRequest>]]></data>
            </body>
          </message>
        </receive>
        <receive endpoint="helloTopicRequestReceiver" timeout="5000">
          <description>Receive asynchronous hello response: HelloService -&gt; TestFramework</description>
          <message>
            <headers>
              <header name="Operation" value="sayHello"/>
              <header name="CorrelationId" value="${correlationId}"/>
            </headers>
            <body>
              <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                           <MessageId>${messageId}</MessageId>
                           <CorrelationId>${correlationId}</CorrelationId>
                           <User>${user}</User>
                           <Text>Hello TestFramework</Text>
                        </HelloRequest>]]></data>
            </body>
          </message>
        </receive>
        <sequential>
          <actions>
            <sleep milliseconds="1000"/>
            <send endpoint="helloTopicRequestSender">
              <description>Send asynchronous hello request: TestFramework -&gt; HelloService</description>
              <message>
                <headers>
                  <header name="Operation" value="sayHello"/>
                  <header name="CorrelationId" value="${correlationId}"/>
                </headers>
                <body>
                  <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                                 <MessageId>${messageId}</MessageId>
                                 <CorrelationId>${correlationId}</CorrelationId>
                                 <User>${user}</User>
                                 <Text>Hello TestFramework</Text>
                             </HelloRequest>]]></data>
                </body>
              </message>
            </send>
          </actions>
        </sequential>
      </actions>
    </parallel>
  </actions>
</test>
