<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="SyncJmsTopicCommunicationIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>JMS topic support in synchronous JMS communication.</description>
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Christoph"/>
  </variables>
  <actions>
    <parallel>
      <actions>
        <sequential>
          <actions>
            <sleep seconds="2"/>
            <send endpoint="syncJmsTopicEndpoint">
              <description>Send synchronous hello request to jms topic</description>
              <message>
                <headers>
                  <header name="Operation" value="sayHello"/>
                  <header name="CorrelationId" value="${correlationId}"/>
                </headers>
                <body>
                  <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                                    <MessageId>${messageId}</MessageId>
                                    <CorrelationId>${correlationId}</CorrelationId>
                                    <User>${user}</User>
                                    <Text>Hello TestFramework</Text>
                                </HelloRequest>]]></data>
                </body>
              </message>
            </send>
          </actions>
        </sequential>
        <sequential>
          <actions>
            <parallel>
              <actions>
                <receive endpoint="syncJmsTopicSubscriberEndpoint">
                  <description>Receive sync hello request from jms topic</description>
                  <message>
                    <headers>
                      <header name="Operation" value="sayHello"/>
                      <header name="CorrelationId" value="${correlationId}"/>
                    </headers>
                    <body>
                      <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                                          <MessageId>${messageId}</MessageId>
                                          <CorrelationId>${correlationId}</CorrelationId>
                                          <User>${user}</User>
                                          <Text>Hello TestFramework</Text>
                                      </HelloRequest>]]></data>
                    </body>
                  </message>
                </receive>
              </actions>
            </parallel>
            <send endpoint="syncJmsTopicSubscriberEndpoint">
              <description>Send synchronous hello response to jms reply destination</description>
              <message>
                <headers>
                  <header name="Operation" value="sayHello"/>
                  <header name="CorrelationId" value="${correlationId}"/>
                </headers>
                <body>
                  <data><![CDATA[<HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                                      <MessageId>${messageId}</MessageId>
                                      <CorrelationId>${correlationId}</CorrelationId>
                                      <User>HelloService</User>
                                      <Text>Hello ${user}</Text>
                                  </HelloResponse>]]></data>
                </body>
              </message>
            </send>
          </actions>
        </sequential>
      </actions>
    </parallel>
    <receive endpoint="syncJmsTopicEndpoint">
      <description>Receive sync hello response from jms reply destination</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                            <MessageId>${messageId}</MessageId>
                            <CorrelationId>${correlationId}</CorrelationId>
                            <User>HelloService</User>
                            <Text>Hello ${user}</Text>
                        </HelloResponse>]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
