<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="JmsMessageHeadersIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test sends and receives messages on an asynchronous JMS queue endpoint.</description>
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Christoph"/>
  </variables>
  <actions>
    <echo>
      <message>Send JMS request and receive same message validating JMS message header mapping</message>
    </echo>
    <send endpoint="jms:queue:headers">
      <description>Send JMS message</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="citrus_jms_correlationId" value="${correlationId}"/>
          <header name="citrus_jms_priority" value="4"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                 <MessageId>${messageId}</MessageId>
                 <CorrelationId>${correlationId}</CorrelationId>
                 <User>${user}</User>
                 <Text>Hello Citrus</Text>
               </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="jms:queue:headers">
      <description>Receive JMS message</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="citrus_jms_correlationId" value="${correlationId}"/>
          <header name="citrus_jms_messageId" value="@assertThat(notNullValue())@"/>
          <header name="citrus_jms_timestamp" value="@assertThat(greaterThan(0))@"/>
          <header name="citrus_jms_deliveryMode" value="2"/>
          <header name="citrus_jms_expiration" value="0"/>
          <header name="citrus_jms_destination" value="ActiveMQQueue[headers]"/>
          <header name="citrus_jms_priority" value="4"/>
          <header name="citrus_jms_redelivered" value="false"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                 <MessageId>${messageId}</MessageId>
                 <CorrelationId>${correlationId}</CorrelationId>
                 <User>${user}</User>
                 <Text>Hello Citrus</Text>
              </HelloRequest>]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
