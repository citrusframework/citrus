<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="JmsSoapIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test sends and receives SOAP messages on an asynchronous JMS queue endpoint.</description>
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Christoph"/>
  </variables>
  <actions>
    <echo>
      <message>Test 1: Send JMS request and receive async JMS response (inline CDATA payload)</message>
    </echo>
    <send endpoint="helloSoapServiceJmsEndpoint">
      <description>Send asynchronous JMS request: Citrus -&gt; HelloService</description>
      <message>
        <headers>
          <header name="SOAPJMS_soapAction" value="sayHello"/>
        </headers>
        <body>
          <data><![CDATA[<SOAP-ENV:Envelope xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/">
                <SOAP-ENV:Header/>
                <SOAP-ENV:Body>
                  <HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                    <MessageId>${messageId}</MessageId>
                    <CorrelationId>${correlationId}</CorrelationId>
                    <User>${user}</User>
                    <Text>Hello Citrus</Text>
                  </HelloRequest>
                </SOAP-ENV:Body>
              </SOAP-ENV:Envelope>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloSoapServiceResponseJmsEndpoint">
      <description>Receive asynchronous JMS response: HelloService -&gt; Citrus</description>
      <message>
        <headers>
          <header name="SOAPJMS_soapAction" value="sayHello"/>
        </headers>
        <body>
          <data><![CDATA[<SOAP-ENV:Envelope xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/">
                <SOAP-ENV:Header/>
                <SOAP-ENV:Body>
                  <HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                    <MessageId>${messageId}</MessageId>
                    <CorrelationId>${correlationId}</CorrelationId>
                    <User>HelloSoapService</User>
                    <Text>Hello ${user}</Text>
                  </HelloResponse>
                </SOAP-ENV:Body>
              </SOAP-ENV:Envelope>]]></data>
        </body>
      </message>
    </receive>
    <echo>
      <message>Test 2: Test automatic Soap envelope handling</message>
    </echo>
    <send endpoint="helloServiceSoapJmsEndpoint">
      <description>Send asynchronous JMS request: Citrus -&gt; HelloService</description>
      <message>
        <headers>
          <header name="citrus_soap_action" value="sayHello"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageId}</MessageId>
                <CorrelationId>${correlationId}</CorrelationId>
                <User>${user}</User>
                <Text>Hello Citrus</Text>
              </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloServiceResponseSoapJmsEndpoint">
      <description>Receive asynchronous JMS response: HelloService -&gt; Citrus</description>
      <message>
        <headers>
          <header name="citrus_soap_action" value="sayHello"/>
        </headers>
        <body>
          <data><![CDATA[<HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageId}</MessageId>
                <CorrelationId>${correlationId}</CorrelationId>
                <User>HelloSoapService</User>
                <Text>Hello ${user}</Text>
              </HelloResponse>]]></data>
        </body>
      </message>
    </receive>
    <echo>
      <message>Test 3: Test header fragment handling</message>
    </echo>
    <send endpoint="helloServiceSoapJmsEndpoint">
      <description>Send asynchronous JMS request: Citrus -&gt; HelloService</description>
      <message>
        <headers>
          <header>
            <data><![CDATA[<RequestHeader xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <Service>HelloService</Service>
                <Operation>sayHello</Operation>
              </RequestHeader>]]></data>
          </header>
          <header name="citrus_soap_action" value="sayHello"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageId}</MessageId>
                <CorrelationId>${correlationId}</CorrelationId>
                <User>${user}</User>
                <Text>Hello Citrus</Text>
              </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloServiceResponseSoapJmsEndpoint">
      <description>Receive asynchronous JMS response: HelloService -&gt; Citrus</description>
      <message>
        <headers>
          <header>
            <data><![CDATA[<SOAP-ENV:Header xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/">
                <ResponseHeader xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                  <Service>HelloService</Service>
                  <Operation>sayHello</Operation>
                  <Acknowledge>true</Acknowledge>
                </ResponseHeader>
              </SOAP-ENV:Header>]]></data>
          </header>
          <header name="citrus_soap_action" value="sayHello"/>
        </headers>
        <body>
          <data><![CDATA[<HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageId}</MessageId>
                <CorrelationId>${correlationId}</CorrelationId>
                <User>HelloSoapService</User>
                <Text>Hello ${user}</Text>
              </HelloResponse>]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
