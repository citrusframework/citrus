<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="JmsSyncSendReceiveIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test synchronous JMS communication with temporary and static reply queues.</description>
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Christoph"/>
  </variables>
  <actions>
    <echo>
      <message>Test 1: Send JMS request and receive sync JMS response (inline CDATA payload)</message>
    </echo>
    <send endpoint="helloServiceJmsSyncEndpoint">
      <description>Send synchronous JMS request: Citrus -&gt; HelloService JmsDemo</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                               <MessageId>${messageId}</MessageId>
                               <CorrelationId>${correlationId}</CorrelationId>
                               <User>${user}</User>
                               <Text>Hello Citrus</Text>
                           </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloServiceJmsSyncEndpoint">
      <description>Receive synchronous JMS response: HelloService JmsDemo -&gt; Citrus</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                                <MessageId>${messageId}</MessageId>
                                <CorrelationId>${correlationId}</CorrelationId>
                                <User>HelloService</User>
                                <Text>Hello ${user}</Text>
                            </HelloResponse>]]></data>
        </body>
      </message>
    </receive>
    <echo>
      <message>Test 2: Send JMS request and receive sync JMS response (file resource payload)</message>
    </echo>
    <send endpoint="helloServiceJmsSyncEndpoint">
      <description>Send synchronous JMS request: Citrus -&gt; HelloService JmsDemo</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <resource file="classpath:org/citrusframework/jms/integration/helloRequest.xml"/>
        </body>
      </message>
    </send>
    <receive endpoint="helloServiceJmsSyncEndpoint">
      <description>Receive synchronous JMS response: HelloService JmsDemo -&gt; Citrus</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <resource file="classpath:org/citrusframework/jms/integration/helloResponse.xml"/>
        </body>
      </message>
    </receive>
  </actions>
</test>
