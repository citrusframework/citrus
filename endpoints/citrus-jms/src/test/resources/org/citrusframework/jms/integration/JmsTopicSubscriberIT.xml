<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="JmsTopicSubscriberIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Christoph"/>
  </variables>
  <actions>
    <iterate condition="@assertThat(lessThanOrEqualTo(3))@">
      <actions>
        <send endpoint="helloServiceJmsTopicSubscriberEndpoint">
          <description>Send asynchronous hello request: TestFramework -&gt; HelloService</description>
          <message>
            <headers>
              <header name="Operation" value="sayHello"/>
              <header name="CorrelationId" value="${correlationId}"/>
            </headers>
            <body>
              <data><![CDATA[<HelloRequest>
                       <MessageId>${messageId}</MessageId>
                       <CorrelationId>${correlationId}_${i}</CorrelationId>
                       <User>${user}</User>
                       <Text>Hello TestFramework</Text>
                   </HelloRequest>]]></data>
            </body>
          </message>
        </send>
      </actions>
    </iterate>
    <iterate condition="@assertThat(lessThanOrEqualTo(3))@">
      <actions>
        <receive endpoint="helloServiceJmsTopicSubscriberEndpoint" timeout="5000">
          <description>Receive asynchronous hello response: HelloService -&gt; TestFramework</description>
          <message>
            <headers>
              <header name="Operation" value="sayHello"/>
              <header name="CorrelationId" value="${correlationId}"/>
            </headers>
            <body>
              <data><![CDATA[<HelloRequest>
                     <MessageId>${messageId}</MessageId>
                     <CorrelationId>${correlationId}_${i}</CorrelationId>
                     <User>${user}</User>
                     <Text>Hello TestFramework</Text>
                  </HelloRequest>]]></data>
            </body>
          </message>
        </receive>
      </actions>
    </iterate>
    <parallel>
      <actions>
        <iterate condition="@assertThat(lessThanOrEqualTo(10))@" startsWith="5">
          <actions>
            <send endpoint="helloServiceJmsTopicSubscriberEndpoint">
              <description>Send asynchronous hello request: TestFramework -&gt; HelloService</description>
              <message>
                <headers>
                  <header name="Operation" value="sayHello"/>
                  <header name="CorrelationId" value="${correlationId}"/>
                </headers>
                <body>
                  <data><![CDATA[<HelloRequest>
                         <MessageId>${messageId}</MessageId>
                         <CorrelationId>${correlationId}_${i}</CorrelationId>
                         <User>${user}</User>
                         <Text>Hello TestFramework</Text>
                     </HelloRequest>]]></data>
                </body>
              </message>
            </send>
          </actions>
        </iterate>
        <sequential>
          <actions>
            <sleep milliseconds="500"/>
            <iterate condition="@assertThat(lessThanOrEqualTo(10))@" startsWith="5">
              <actions>
                <receive endpoint="helloServiceJmsTopicSubscriberEndpoint" timeout="5000">
                  <description>Receive asynchronous hello response: HelloService -&gt; TestFramework</description>
                  <message>
                    <headers>
                      <header name="Operation" value="sayHello"/>
                      <header name="CorrelationId" value="${correlationId}"/>
                    </headers>
                    <body>
                      <data><![CDATA[<HelloRequest>
                         <MessageId>${messageId}</MessageId>
                         <CorrelationId>${correlationId}_${i}</CorrelationId>
                         <User>${user}</User>
                         <Text>Hello TestFramework</Text>
                      </HelloRequest>]]></data>
                    </body>
                  </message>
                </receive>
              </actions>
            </iterate>
          </actions>
        </sequential>
      </actions>
    </parallel>
    <parallel>
      <actions>
        <receive endpoint="helloServiceJmsTopicSubscriberEndpoint" timeout="5000">
          <description>Receive asynchronous hello response: HelloService -&gt; TestFramework</description>
          <message>
            <headers>
              <header name="Operation" value="sayHello"/>
              <header name="CorrelationId" value="${correlationId}"/>
            </headers>
            <body>
              <data><![CDATA[<HelloRequest>
                   <MessageId>${messageId}</MessageId>
                   <CorrelationId>${correlationId}_3</CorrelationId>
                   <User>${user}</User>
                   <Text>Hello TestFramework</Text>
                </HelloRequest>]]></data>
            </body>
          </message>
        </receive>
        <sequential>
          <actions>
            <sleep milliseconds="1000"/>
            <send endpoint="helloServiceJmsTopicSubscriberEndpoint">
              <description>Send asynchronous hello request: TestFramework -&gt; HelloService</description>
              <message>
                <headers>
                  <header name="Operation" value="sayHello"/>
                  <header name="CorrelationId" value="${correlationId}"/>
                </headers>
                <body>
                  <data><![CDATA[<HelloRequest>
                       <MessageId>${messageId}</MessageId>
                       <CorrelationId>${correlationId}_3</CorrelationId>
                       <User>${user}</User>
                       <Text>Hello TestFramework</Text>
                   </HelloRequest>]]></data>
                </body>
              </message>
            </send>
          </actions>
        </sequential>
      </actions>
    </parallel>
  </actions>
</test>
