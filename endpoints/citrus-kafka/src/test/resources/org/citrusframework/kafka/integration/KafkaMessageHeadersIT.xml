<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="KafkaMessageHeadersIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test sends and receives messages on an asynchronous Kafka queue endpoint.</description>
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Christoph"/>
  </variables>
  <actions>
    <echo>
      <message>Send Kafka request and receive same message validating Kafka message header mapping</message>
    </echo>
    <send endpoint="helloKafkaEndpoint">
      <description>Send Kafka message</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="citrus_kafka_messageKey" value="1"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                 <MessageId>${messageId}</MessageId>
                 <CorrelationId>${correlationId}</CorrelationId>
                 <User>${user}</User>
                 <Text>Hello Citrus</Text>
               </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloKafkaEndpoint">
      <description>Receive Kafka message</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="citrus_kafka_timestamp" value="@assertThat(greaterThan(0))@"/>
          <header name="citrus_kafka_messageKey" value="1"/>
          <header name="citrus_kafka_topic" value="hello"/>
          <header name="citrus_kafka_partition" value="0"/>
          <header name="citrus_kafka_offset" value="@assertThat(greaterThanOrEqualTo(0))@"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                 <MessageId>${messageId}</MessageId>
                 <CorrelationId>${correlationId}</CorrelationId>
                 <User>${user}</User>
                 <Text>Hello Citrus</Text>
              </HelloRequest>]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
