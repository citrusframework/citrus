<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="RmiServerIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test RMI client server communication.</description>
  <variables>
    <variable name="randomCount" value="citrus:randomNumber(4)"/>
  </variables>
  <actions>
    <echo>
      <message>Test 1: Receive RMI service call as server and return null result</message>
    </echo>
    <send endpoint="rmiHelloClient2499" fork="true">
      <message>
        <body>
          <payload>
            <rmi:service-invocation xmlns:rmi="http://www.citrusframework.org/schema/rmi/message">
              <rmi:remote>org.citrusframework.rmi.remote.HelloService</rmi:remote>
              <rmi:method>sayHello</rmi:method>
              <rmi:args>
                <rmi:arg value="Hello RMI this is cool!"/>
              </rmi:args>
            </rmi:service-invocation>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="rmiHelloServer2499">
      <message>
        <body>
          <payload>
            <rmi:service-invocation xmlns:rmi="http://www.citrusframework.org/schema/rmi/message">
              <rmi:remote>org.citrusframework.rmi.remote.HelloService</rmi:remote>
              <rmi:method>sayHello</rmi:method>
              <rmi:args>
                <rmi:arg type="java.lang.String" value="Hello RMI this is cool!"/>
              </rmi:args>
            </rmi:service-invocation>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="rmiHelloServer2499">
      <message>
        <body>
          <payload>
            <rmi:service-result xmlns:rmi="http://www.citrusframework.org/schema/rmi/message"/>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="rmiHelloClient2499">
      <message>
        <body>
          <payload>
            <rmi:service-result xmlns:rmi="http://www.citrusframework.org/schema/rmi/message"/>
          </payload>
        </body>
      </message>
    </receive>
    <echo>
      <message>Test 2: Receive RMI service call return some result object</message>
    </echo>
    <send endpoint="rmiHelloClient2499" fork="true">
      <message>
        <body>
          <payload>
            <rmi:service-invocation xmlns:rmi="http://www.citrusframework.org/schema/rmi/message">
              <rmi:remote>org.citrusframework.rmi.remote.HelloService</rmi:remote>
              <rmi:method>getHelloCount</rmi:method>
            </rmi:service-invocation>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="rmiHelloServer2499">
      <message>
        <body>
          <payload>
            <rmi:service-invocation xmlns:rmi="http://www.citrusframework.org/schema/rmi/message">
              <rmi:remote>org.citrusframework.rmi.remote.HelloService</rmi:remote>
              <rmi:method>getHelloCount</rmi:method>
            </rmi:service-invocation>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="rmiHelloServer2499">
      <message>
        <body>
          <payload>
            <rmi:service-result xmlns:rmi="http://www.citrusframework.org/schema/rmi/message">
              <rmi:object type="java.lang.Integer" value="${randomCount}"/>
            </rmi:service-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="rmiHelloClient2499">
      <message>
        <body>
          <payload>
            <rmi:service-result xmlns:rmi="http://www.citrusframework.org/schema/rmi/message">
              <rmi:object type="java.lang.Integer" value="${randomCount}"/>
            </rmi:service-result>
          </payload>
        </body>
      </message>
    </receive>
  </actions>
</test>
