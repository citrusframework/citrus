<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="RmiDynamicEndpointIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test sends and receives messages as RMI client and server where client is a dynamic endpoint.</description>
  <actions>
    <echo>
      <message>Test: Receive RMI request via server instance and send back response.</message>
    </echo>
    <send endpoint="rmi://localhost:2599/newsService" fork="true">
      <message>
        <body>
          <payload>
            <rmi:service-invocation xmlns:rmi="http://www.citrusframework.org/schema/rmi/message">
              <rmi:remote>org.citrusframework.rmi.remote.NewsService</rmi:remote>
              <rmi:method>getNews</rmi:method>
            </rmi:service-invocation>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="rmiNewsServer2599">
      <message>
        <body>
          <payload>
            <rmi:service-invocation xmlns:rmi="http://www.citrusframework.org/schema/rmi/message">
              <rmi:remote>org.citrusframework.rmi.remote.NewsService</rmi:remote>
              <rmi:method>getNews</rmi:method>
            </rmi:service-invocation>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="rmiNewsServer2599">
      <message>
        <body>
          <payload>
            <rmi:service-result xmlns:rmi="http://www.citrusframework.org/schema/rmi/message">
              <rmi:object type="java.lang.String" value="This is news from RMI!"/>
            </rmi:service-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="rmi://localhost:2599/newsService">
      <message>
        <body>
          <payload>
            <rmi:service-result xmlns:rmi="http://www.citrusframework.org/schema/rmi/message">
              <rmi:object type="java.lang.String" value="This is news from RMI!"/>
            </rmi:service-result>
          </payload>
        </body>
      </message>
    </receive>
  </actions>
</test>
