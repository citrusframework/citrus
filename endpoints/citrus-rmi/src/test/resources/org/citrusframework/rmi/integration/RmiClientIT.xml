<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="RmiClientIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test RMI client server communication.</description>
  <actions>
    <echo>
      <message>Test 1: Call RMI service as client and receive result</message>
    </echo>
    <send endpoint="rmiNewsClient2499" fork="true">
      <message>
        <body>
          <payload>
            <rmi:service-invocation xmlns:rmi="http://www.citrusframework.org/schema/rmi/message">
              <rmi:remote>org.citrusframework.rmi.remote.NewsService</rmi:remote>
              <rmi:method>getNews</rmi:method>
            </rmi:service-invocation>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="rmiNewsServer2499">
      <message>
        <body>
          <payload>
            <rmi:service-invocation xmlns:rmi="http://www.citrusframework.org/schema/rmi/message">
              <rmi:remote>org.citrusframework.rmi.remote.NewsService</rmi:remote>
              <rmi:method>getNews</rmi:method>
            </rmi:service-invocation>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="rmiNewsServer2499">
      <message>
        <body>
          <payload>
            <rmi:service-result xmlns:rmi="http://www.citrusframework.org/schema/rmi/message">
              <rmi:object type="java.lang.String" value="This is news from RMI!"/>
            </rmi:service-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="rmiNewsClient2499">
      <message>
        <body>
          <payload>
            <rmi:service-result xmlns:rmi="http://www.citrusframework.org/schema/rmi/message">
              <rmi:object type="java.lang.String" value="This is news from RMI!"/>
            </rmi:service-result>
          </payload>
        </body>
      </message>
    </receive>
    <echo>
      <message>Test 2: Call RMI service with method argument and receive null result</message>
    </echo>
    <send endpoint="rmiNewsClient2499" fork="true">
      <message>
        <body>
          <payload>
            <rmi:service-invocation xmlns:rmi="http://www.citrusframework.org/schema/rmi/message">
              <rmi:remote>org.citrusframework.rmi.remote.NewsService</rmi:remote>
              <rmi:method>setNews</rmi:method>
              <rmi:args>
                <rmi:arg value="This is breaking news!"/>
              </rmi:args>
            </rmi:service-invocation>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="rmiNewsServer2499">
      <message>
        <body>
          <payload>
            <rmi:service-invocation xmlns:rmi="http://www.citrusframework.org/schema/rmi/message">
              <rmi:remote>org.citrusframework.rmi.remote.NewsService</rmi:remote>
              <rmi:method>setNews</rmi:method>
              <rmi:args>
                <rmi:arg type="java.lang.String" value="This is breaking news!"/>
              </rmi:args>
            </rmi:service-invocation>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="rmiNewsServer2499">
      <message>
        <body>
          <payload>
            <rmi:service-result xmlns:rmi="http://www.citrusframework.org/schema/rmi/message"/>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="rmiNewsClient2499">
      <message>
        <body>
          <payload>
            <rmi:service-result xmlns:rmi="http://www.citrusframework.org/schema/rmi/message"/>
          </payload>
        </body>
      </message>
    </receive>
  </actions>
</test>
