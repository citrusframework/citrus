<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Roland" name="SshServerErrorIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>SSH test with a wrong private key</description>
  <actions>
    <echo>
      <message>Contact the SSH server with a wrong private key</message>
    </echo>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException" message="Cannot connect via SSH: com.jcraft.jsch.JSchException: Auth fail">
      <when>
        <send endpoint="sshClientWithWrongKey">
          <message>
            <body>
              <payload>
                <ssh-request xmlns="http://www.citrusframework.org/schema/ssh/message">
                  <command>shutdown</command>
                  <stdin>input</stdin>
                </ssh-request>
              </payload>
            </body>
          </message>
        </send>
      </when>
    </assert>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException" message="Cannot connect via SSH: com.jcraft.jsch.JSchException: Auth fail">
      <when>
        <send endpoint="sshClientWithWrongUser">
          <message>
            <body>
              <payload>
                <ssh-request xmlns="http://www.citrusframework.org/schema/ssh/message">
                  <command>shutdown</command>
                  <stdin>input</stdin>
                </ssh-request>
              </payload>
            </body>
          </message>
        </send>
      </when>
    </assert>
  </actions>
</test>
