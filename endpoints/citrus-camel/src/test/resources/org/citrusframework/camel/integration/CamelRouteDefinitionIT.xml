<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="CamelRouteDefinitionIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test creates Camel routes on the fly and uses them in test.</description>
  <actions>
    <echo>
      <message>Create Camel news route</message>
    </echo>
    <camel camel-context="camelContext">
      <create-routes>
        <routeContext xmlns="http://camel.apache.org/schema/spring">
          <route id="myRoute">
            <from uri="direct:dynamic-news"/>
            <to uri="log:org.citrusframework.camel?level=INFO"/>
            <setHeader name="headline">
              <simple>This is BIG news!</simple>
            </setHeader>
            <to uri="seda:big-news"/>
          </route>
        </routeContext>
      </create-routes>
    </camel>
    <echo>
      <message>Invoke Camel news route with some message</message>
    </echo>
    <send endpoint="camel:direct:dynamic-news">
      <message type="plaintext">
        <body>
          <data>News from Citrus! Today is citrus:currentDate()</data>
        </body>
      </message>
    </send>
    <echo>
      <message>Receive Camel route out message</message>
    </echo>
    <receive endpoint="camel:seda:big-news">
      <message type="plaintext">
        <headers>
          <header name="headline" value="This is BIG news!"/>
        </headers>
        <body>
          <data>News from Citrus! Today is citrus:currentDate()</data>
        </body>
      </message>
    </receive>
  </actions>
  <finally>
    <echo>
      <message>Stop Camel route</message>
    </echo>
    <camel camel-context="camelContext">
      <stop-routes>
        <route id="myRoute"/>
      </stop-routes>
    </camel>
    <echo>
      <message>Validate that route was stopped</message>
    </echo>
    <camel camel-context="camelContext">
      <control-bus>
        <route action="status" id="myRoute"/>
        <result>Stopped</result>
      </control-bus>
    </camel>
    <camel camel-context="camelContext">
      <control-bus>
        <language type="simple">${camelContext.getRouteStatus('myRoute')}</language>
        <result>Stopped</result>
      </control-bus>
    </camel>
    <echo>
      <message>Remove Camel route</message>
    </echo>
    <camel camel-context="camelContext">
      <remove-routes>
        <route id="myRoute"/>
      </remove-routes>
    </camel>
  </finally>
</test>
