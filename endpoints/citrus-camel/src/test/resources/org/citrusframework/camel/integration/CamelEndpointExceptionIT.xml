<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="CamelEndpointExceptionIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test receives synchronous message as Camel endpoint and simulates exception on Camel exchange.</description>
  <actions>
    <echo>
      <message>Test: Send message to Camel endpoint and receive synchronous response</message>
    </echo>
    <send endpoint="camel:sync:direct:hello" fork="true">
      <message type="plaintext">
        <body>
          <data>Hello Camel!</data>
        </body>
      </message>
    </send>
    <receive endpoint="camelHelloEndpoint">
      <message type="plaintext">
        <body>
          <data>Hello Camel!</data>
        </body>
      </message>
    </receive>
    <sleep milliseconds="1000"/>
    <send endpoint="camelHelloEndpoint">
      <message type="plaintext">
        <headers>
          <header name="citrus_camel_exchange_exception" value="org.citrusframework.exceptions.CitrusRuntimeException"/>
          <header name="citrus_camel_exchange_exception_message" value="Something went wrong!"/>
        </headers>
        <body>
          <data>Something went wrong!</data>
        </body>
      </message>
    </send>
    <receive endpoint="camel:sync:seda:exceptions">
      <message type="plaintext">
        <body>
          <data>Something went wrong!</data>
        </body>
      </message>
    </receive>
    <send endpoint="camel:sync:seda:exceptions">
      <message type="plaintext">
        <body>
          <data>Hello after error!</data>
        </body>
      </message>
    </send>
    <receive endpoint="camel:sync:direct:hello">
      <message type="plaintext">
        <body>
          <data>Hello after error!</data>
        </body>
      </message>
    </receive>
  </actions>
</test>
