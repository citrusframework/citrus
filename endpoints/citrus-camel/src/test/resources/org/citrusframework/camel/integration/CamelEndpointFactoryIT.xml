<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="CamelEndpointFactoryIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test sends and receives messages to/from Camel endpoints using the endpoint factory.</description>
  <actions>
    <echo>
      <message>Test: Send message to Camel endpoint</message>
    </echo>
    <send endpoint="camel:direct:news">
      <message type="plaintext">
        <body>
          <data>News from Citrus! Today is citrus:currentDate()</data>
        </body>
      </message>
    </send>
    <receive endpoint="camel:seda:newsFeed">
      <message type="plaintext">
        <body>
          <data>News from Citrus! Today is citrus:currentDate()</data>
        </body>
      </message>
    </receive>
    <send endpoint="camel:sync:controlbus:route?routeId=helloRoute&amp;action=status">
      <message type="plaintext">
        <body>
          <data/>
        </body>
      </message>
    </send>
    <receive endpoint="camel:sync:controlbus:route?routeId=helloRoute&amp;action=status">
      <message type="plaintext">
        <body>
          <data>Started</data>
        </body>
      </message>
    </receive>
    <camel camel-context="camelContext">
      <control-bus>
        <route action="status" id="helloRoute"/>
        <result>Started</result>
      </control-bus>
    </camel>
  </actions>
</test>
