<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="CamelEndpointIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test sends and receives messages to/from Camel endpoints.</description>
  <actions>
    <echo>
      <message>Test: Send message to Camel endpoint</message>
    </echo>
    <send endpoint="camelNewsEndpoint">
      <message type="plaintext">
        <body>
          <data>News from Citrus! Today is citrus:currentDate()</data>
        </body>
      </message>
    </send>
    <receive endpoint="camelNewsFeedEndpoint">
      <message type="plaintext">
        <headers>
          <header name="citrus_camel_route_id" value="newsRoute"/>
          <header name="citrus_camel_exchange_failed" value="false"/>
          <header name="citrus_camel_exchange_pattern" value="InOnly"/>
        </headers>
        <body>
          <data>News from Citrus! Today is citrus:currentDate()</data>
        </body>
      </message>
    </receive>
  </actions>
</test>
