<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Martin Maher" name="WebSocketEndpoint_2_IT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test sends and receives messages via web socket connection. This time messages are sliced into pieces and aggregated on web socket server.</description>
  <actions>
    <echo>
      <message>Test: Send multiple WebSocket requests via client and aggregate messages on server until last message was sent</message>
    </echo>
    <send endpoint="webSocketClient1">
      <message type="json">
        <headers>
          <header name="citrus_websocket_is_last" value="false"/>
        </headers>
        <body>
          <data>[
            {
            "event" : "client_message_1",
            "timestamp" : "citrus:currentDate()"
            },</data>
        </body>
      </message>
    </send>
    <expect-timeout endpoint="webSocketEndpoint1"/>
    <send endpoint="webSocketClient1">
      <message type="json">
        <headers>
          <header name="citrus_websocket_is_last" value="true"/>
        </headers>
        <body>
          <data>{
            "event" : "client_message_2",
            "timestamp" : "citrus:currentDate()"
            }
            ]</data>
        </body>
      </message>
    </send>
    <receive endpoint="webSocketEndpoint1">
      <message type="json">
        <body>
          <data>[
              {
              "event" : "client_message_1",
              "timestamp" : "@ignore@"
              },
              {
              "event" : "client_message_2",
              "timestamp" : "@ignore@"
              }
            ]</data>
        </body>
      </message>
    </receive>
  </actions>
</test>
