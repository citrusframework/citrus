<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="ChannelSyncEndpointIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test sends and receives messages on an synchronous channel endpoint with reply message handling.</description>
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Christoph"/>
  </variables>
  <actions>
    <echo>
      <message>Test 1: Send message channel request and receive sync response (inline CDATA payload)</message>
    </echo>
    <send endpoint="helloServiceChannelSyncEndpoint">
      <description>Send synchronous message channel request: Citrus -&gt; HelloService</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                 <MessageId>${messageId}</MessageId>
                 <CorrelationId>${correlationId}</CorrelationId>
                 <User>${user}</User>
                 <Text>Hello Citrus</Text>
               </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloServiceChannelSyncEndpoint">
      <description>Receive synchronous message channel response: HelloService -&gt; Citrus</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageId}</MessageId>
                <CorrelationId>${correlationId}</CorrelationId>
                <User>HelloService</User>
                <Text>Hello ${user}</Text>
              </HelloResponse>]]></data>
        </body>
      </message>
    </receive>
    <echo>
      <message>Test 2: Send message channel request and receive sync response (file resource payload)</message>
    </echo>
    <send endpoint="helloServiceChannelSyncEndpoint">
      <description>Send synchronous channel request: Citrus -&gt; HelloService</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <resource file="classpath:org/citrusframework/templates/HelloRequest.xml"/>
        </body>
      </message>
    </send>
    <receive endpoint="helloServiceChannelSyncEndpoint">
      <description>Receive synchronous channel response: HelloService -&gt; Citrus</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <resource file="classpath:org/citrusframework/templates/HelloResponse.xml"/>
        </body>
      </message>
    </receive>
    <echo>
      <message>Test 3: Receive channel message timeout response</message>
    </echo>
    <assert exception="org.citrusframework.exceptions.ActionTimeoutException" message="Action timeout after 300 milliseconds. Failed to receive message on endpoint: 'helloSyncRequests'">
      <when>
        <receive endpoint="helloServiceChannelSyncEndpoint" timeout="300">
          <description>Receive channel timeout: HelloService -&gt; Citrus</description>
          <selector>
            <element name="CorrelationId" value="doesNotExist"/>
          </selector>
          <message>
            <headers>
              <header name="Operation" value="sayHello"/>
            </headers>
            <body>
              <data><![CDATA[<HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                      <MessageId>?</MessageId>
                      <CorrelationId>?</CorrelationId>
                      <User>HelloService</User>
                      <Text>Hello ?</Text>
                    </HelloResponse>]]></data>
            </body>
          </message>
        </receive>
      </when>
    </assert>
  </actions>
</test>
