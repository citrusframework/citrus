<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="JmxClientIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test jmx client and server endpoints.</description>
  <actions>
    <echo>
      <message>Call JMX mbean server</message>
    </echo>
    <send endpoint="jmxClient">
      <message>
        <body>
          <payload>
            <mbean-invocation xmlns="http://www.citrusframework.org/schema/jmx/message">
              <mbean>java.lang:type=Memory</mbean>
              <attribute name="Verbose"/>
            </mbean-invocation>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="jmxClient">
      <message>
        <body>
          <payload>
            <mbean-result xmlns="http://www.citrusframework.org/schema/jmx/message">
              <object type="java.lang.Boolean" value="false"/>
            </mbean-result>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="jmxClient">
      <message>
        <body>
          <payload>
            <mbean-invocation xmlns="http://www.citrusframework.org/schema/jmx/message">
              <mbean>java.lang:type=Memory</mbean>
              <attribute name="Verbose" type="java.lang.Boolean" value="true"/>
            </mbean-invocation>
          </payload>
        </body>
      </message>
    </send>
    <send endpoint="jmxClient">
      <message>
        <body>
          <payload>
            <mbean-invocation xmlns="http://www.citrusframework.org/schema/jmx/message">
              <mbean>java.lang:type=Memory</mbean>
              <attribute name="Verbose"/>
            </mbean-invocation>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="jmxClient">
      <message>
        <body>
          <payload>
            <mbean-result xmlns="http://www.citrusframework.org/schema/jmx/message">
              <object type="java.lang.Boolean" value="true"/>
            </mbean-result>
          </payload>
        </body>
      </message>
    </receive>
  </actions>
  <finally>
    <send endpoint="jmxClient">
      <message>
        <body>
          <payload>
            <mbean-invocation xmlns="http://www.citrusframework.org/schema/jmx/message">
              <mbean>java.lang:type=Memory</mbean>
              <attribute name="Verbose" type="java.lang.Boolean" value="false"/>
            </mbean-invocation>
          </payload>
        </body>
      </message>
    </send>
  </finally>
</test>
