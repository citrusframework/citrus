<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="JmxDynamicEndpointIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test jmx client dynamic endpoints.</description>
  <actions>
    <echo>
      <message>Call JMX mbean server</message>
    </echo>
    <send endpoint="jmx:platform">
      <message>
        <body>
          <payload>
            <mbean-invocation xmlns="http://www.citrusframework.org/schema/jmx/message">
              <mbean>java.lang:type=Memory</mbean>
              <attribute inner-path="used" name="HeapMemoryUsage"/>
            </mbean-invocation>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="jmx:platform">
      <message>
        <body>
          <payload>
            <mbean-result xmlns="http://www.citrusframework.org/schema/jmx/message">
              <object type="java.lang.Long" value="@greaterThan(1000)@"/>
            </mbean-result>
          </payload>
        </body>
      </message>
    </receive>
  </actions>
</test>
