<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="JmxServerIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test JMX client server communication.</description>
  <actions>
    <echo>
      <message>Test 1: Receive JMX mbean call as server and return null result</message>
    </echo>
    <send endpoint="jmxHelloClient" fork="true">
      <message>
        <body>
          <payload>
            <mbean-invocation xmlns="http://www.citrusframework.org/schema/jmx/message">
              <mbean>org.citrusframework.jmx.mbean:type=HelloBean</mbean>
              <operation name="hello">
                <parameter>
                  <param type="java.lang.String" value="JMX"/>
                </parameter>
              </operation>
            </mbean-invocation>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="jmxHelloServer">
      <message>
        <body>
          <payload>
            <mbean-invocation xmlns="http://www.citrusframework.org/schema/jmx/message">
              <mbean>org.citrusframework.jmx.mbean:type=HelloBean</mbean>
              <operation name="hello">
                <parameter>
                  <param type="java.lang.String" value="JMX"/>
                </parameter>
              </operation>
            </mbean-invocation>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="jmxHelloServer">
      <message>
        <body>
          <payload>
            <mbean-result xmlns="http://www.citrusframework.org/schema/jmx/message">
              <object type="java.lang.String" value="Hello JMX this is cool!"/>
            </mbean-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="jmxHelloClient">
      <message>
        <body>
          <payload>
            <mbean-result xmlns="http://www.citrusframework.org/schema/jmx/message">
              <object type="java.lang.String" value="Hello JMX this is cool!"/>
            </mbean-result>
          </payload>
        </body>
      </message>
    </receive>
    <echo>
      <message>Test 2: Receive JMX mbean call return some result object</message>
    </echo>
    <send endpoint="jmxHelloClient" fork="true">
      <message>
        <body>
          <payload>
            <mbean-invocation xmlns="http://www.citrusframework.org/schema/jmx/message">
              <mbean>org.citrusframework.jmx.mbean:type=HelloBean</mbean>
              <attribute name="helloMessage" type="java.lang.String"/>
            </mbean-invocation>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="jmxHelloServer">
      <message>
        <body>
          <payload>
            <mbean-invocation xmlns="http://www.citrusframework.org/schema/jmx/message">
              <mbean>org.citrusframework.jmx.mbean:type=HelloBean</mbean>
              <attribute name="helloMessage" type="java.lang.String"/>
            </mbean-invocation>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="jmxHelloServer">
      <message>
        <body>
          <payload>
            <mbean-result xmlns="http://www.citrusframework.org/schema/jmx/message">
              <object type="java.lang.String" value="Hello %s this is cool!"/>
            </mbean-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="jmxHelloClient">
      <message>
        <body>
          <payload>
            <mbean-result xmlns="http://www.citrusframework.org/schema/jmx/message">
              <object type="java.lang.String" value="Hello %s this is cool!"/>
            </mbean-result>
          </payload>
        </body>
      </message>
    </receive>
    <echo>
      <message>Test 3: Identify mbean by its name</message>
    </echo>
    <send endpoint="jmxHelloClient" fork="true">
      <message>
        <body>
          <payload>
            <mbean-invocation xmlns="http://www.citrusframework.org/schema/jmx/message">
              <mbean>news:name=NewsBean</mbean>
              <operation name="getNews"/>
            </mbean-invocation>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="jmxHelloServer">
      <message>
        <body>
          <payload>
            <mbean-invocation xmlns="http://www.citrusframework.org/schema/jmx/message">
              <mbean>news:name=NewsBean</mbean>
              <operation name="getNews"/>
            </mbean-invocation>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="jmxHelloServer">
      <message>
        <body>
          <payload>
            <mbean-result xmlns="http://www.citrusframework.org/schema/jmx/message">
              <object type="java.lang.String" value="News from JMX!"/>
            </mbean-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="jmxHelloClient">
      <message>
        <body>
          <payload>
            <mbean-result xmlns="http://www.citrusframework.org/schema/jmx/message">
              <object type="java.lang.String" value="News from JMX!"/>
            </mbean-result>
          </payload>
        </body>
      </message>
    </receive>
    <echo>
      <message>Test 4: Unknown mbean exception</message>
    </echo>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException" message="Failed to execute MBean operation">
      <when>
        <send endpoint="jmxHelloClient">
          <message>
            <body>
              <payload>
                <mbean-invocation xmlns="http://www.citrusframework.org/schema/jmx/message">
                  <mbean>org.citrusframework.jmx.mbean:type=NewsBean</mbean>
                  <operation name="getNews"/>
                </mbean-invocation>
              </payload>
            </body>
          </message>
        </send>
      </when>
    </assert>
  </actions>
</test>
