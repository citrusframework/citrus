<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Citrus" name="HttpFormUrlEncodedIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>This test sends a x-www-form-urlencoded HTML form data content to Http server for validation.
      The form data is validated using plain text validation</description>
  <variables>
    <variable name="username" value="test"/>
    <variable name="password" value="s!cr!t"/>
  </variables>
  <actions>
    <echo>
      <message>Send Http client form data request</message>
    </echo>
    <http client="echoHttpClient">
      <send-request fork="true">
        <POST content-type="application/x-www-form-urlencoded">
          <body>
            <data><![CDATA[password=${password}&username=${username}]]></data>
          </body>
        </POST>
      </send-request>
    </http>
    <echo>
      <message>Receive form data as plain text</message>
    </echo>
    <http server="echoHttpServer">
      <receive-request>
        <POST path="/echo" type="plaintext">
          <headers>
            <header name="Content-Type" value="application/x-www-form-urlencoded"/>
          </headers>
          <body>
            <data>{password=[${password}], username=[${username}]}</data>
          </body>
        </POST>
      </receive-request>
    </http>
    <http server="echoHttpServer">
      <send-response>
        <response reason-phrase="OK" status="200">
          <headers>
            <header name="Content-Type" value="text/html"/>
          </headers>
          <body>
            <data/>
          </body>
        </response>
      </send-response>
    </http>
  </actions>
</test>
