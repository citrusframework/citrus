<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Unknown" name="HttpServerStandaloneIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>The simple HttpServer implementation is launched and requests are sent to the server destination.</description>
  <variables>
    <variable name="custom_header_id" value="123456789"/>
  </variables>
  <actions>
    <http client="httpStandaloneClient">
      <send-request>
        <POST>
          <headers>
            <header name="CustomHeaderId" value="${custom_header_id}"/>
          </headers>
          <body>
            <data><![CDATA[<testRequestMessage>
                    <text>Hello HttpServer</text>
                  </testRequestMessage>]]></data>
          </body>
        </POST>
      </send-request>
    </http>
    <http client="httpStandaloneClient">
      <receive-response>
        <response reason-phrase="OK" status="200" version="HTTP/1.1">
          <body>
            <data><![CDATA[<testResponseMessage>
                <text>Hello TestFramework</text>
                </testResponseMessage>]]></data>
          </body>
        </response>
      </receive-response>
    </http>
    <http client="httpStandaloneClient">
      <send-request>
        <POST>
          <headers>
            <header name="CustomHeaderId" value="${custom_header_id}"/>
          </headers>
          <body>
            <data><![CDATA[<moreRequestMessage>
                    <text>Hello HttpServer</text>
                  </moreRequestMessage>]]></data>
          </body>
        </POST>
      </send-request>
    </http>
    <http client="httpStandaloneClient">
      <receive-response>
        <response reason-phrase="OK" status="200" version="HTTP/1.1">
          <body>
            <data><![CDATA[<testResponseMessage>
                <text>Hello TestFramework</text>
                </testResponseMessage>]]></data>
          </body>
        </response>
      </receive-response>
    </http>
  </actions>
</test>
