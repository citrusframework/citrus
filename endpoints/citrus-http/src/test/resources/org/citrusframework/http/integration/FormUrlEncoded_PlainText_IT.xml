<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Citrus" name="FormUrlEncoded_PlainText_IT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>This test sends a x-www-form-urlencoded HTML form data content to Http server for validation.
      The form data is validated using plain text validation</description>
  <variables>
    <variable name="username" value="test"/>
    <variable name="password" value="s!cr!t"/>
  </variables>
  <actions>
    <echo>
      <message>Send Http client form data request</message>
    </echo>
    <send endpoint="echoHttpClient" fork="true">
      <message>
        <headers>
          <header name="Content-Type" value="application/x-www-form-urlencoded"/>
          <header name="citrus_endpoint_uri" value="http://localhost:12080/form-test"/>
        </headers>
        <body>
          <data><![CDATA[password=${password}&username=${username}]]></data>
        </body>
      </message>
    </send>
    <echo>
      <message>Receive form data as plain text</message>
    </echo>
    <receive endpoint="echoHttpServer">
      <message type="plaintext">
        <headers>
          <header name="citrus_http_method" value="POST"/>
          <header name="citrus_http_request_uri" value="/form-test"/>
          <header name="Content-Type" value="application/x-www-form-urlencoded"/>
        </headers>
        <body>
          <data>{password=[${password}], username=[${username}]}</data>
        </body>
      </message>
    </receive>
    <send endpoint="echoHttpServer">
      <message>
        <headers>
          <header name="citrus_http_status_code" value="200"/>
          <header name="citrus_http_reason_phrase" value="OK"/>
          <header name="Content-Type" value="text/html"/>
        </headers>
        <body>
          <data/>
        </body>
      </message>
    </send>
  </actions>
</test>
