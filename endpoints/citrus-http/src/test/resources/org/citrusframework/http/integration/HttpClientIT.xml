<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="HttpClientIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test send messages to some Http server instance that automatically responds with static message data.</description>
  <variables>
    <variable name="correlationId" value="1000000001"/>
    <variable name="messageId" value="1234567890"/>
    <variable name="user" value="User"/>
  </variables>
  <actions>
    <echo>
      <message>Test: Send Http request and receive sync response</message>
    </echo>
    <http client="helloHttpClient">
      <send-request>
        <POST>
          <headers>
            <header name="Operation" value="sayHello"/>
            <header name="CorrelationId" value="${correlationId}"/>
          </headers>
          <body>
            <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                  <MessageId>${messageId}</MessageId>
                  <CorrelationId>${correlationId}</CorrelationId>
                  <User>${user}</User>
                  <Text>Hello Citrus</Text>
                </HelloRequest>]]></data>
          </body>
        </POST>
      </send-request>
    </http>
    <http client="helloHttpClient">
      <receive-response>
        <response reason-phrase="OK" status="200" version="HTTP/1.1">
          <headers>
            <header name="Operation" value="sayHello"/>
            <header name="CorrelationId" value="${correlationId}"/>
          </headers>
          <body>
            <data><![CDATA[<HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageId}</MessageId>
                <CorrelationId>${correlationId}</CorrelationId>
                <User>HelloService</User>
                <Text>Hello ${user}</Text>
              </HelloResponse>]]></data>
          </body>
        </response>
      </receive-response>
    </http>
    <echo>
      <message>Test pure Http status code validation</message>
    </echo>
    <http client="helloHttpClient">
      <send-request>
        <POST>
          <headers>
            <header name="Operation" value="sayHello"/>
            <header name="CorrelationId" value="${correlationId}"/>
          </headers>
          <body>
            <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                  <MessageId>${messageId}</MessageId>
                  <CorrelationId>${correlationId}</CorrelationId>
                  <User>${user}</User>
                  <Text>Hello Citrus</Text>
                </HelloRequest>]]></data>
          </body>
        </POST>
      </send-request>
    </http>
    <http client="helloHttpClient">
      <receive-response>
        <response reason-phrase="OK" status="200"/>
      </receive-response>
    </http>
    <echo>
      <message>Test header validation error</message>
    </echo>
    <http client="helloHttpClient">
      <send-request>
        <POST>
          <headers>
            <header name="Operation" value="sayHello"/>
            <header name="CorrelationId" value="${correlationId}"/>
          </headers>
          <body>
            <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                  <MessageId>${messageId}</MessageId>
                  <CorrelationId>${correlationId}</CorrelationId>
                  <User>${user}</User>
                  <Text>Hello Citrus</Text>
                </HelloRequest>]]></data>
          </body>
        </POST>
      </send-request>
    </http>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <http client="helloHttpClient">
          <receive-response>
            <response reason-phrase="NOT_FOUND" status="400"/>
          </receive-response>
        </http>
      </when>
    </assert>
  </actions>
</test>
