<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Unknown" name="HttpServerJmsIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>The simple HttpServer implementation is launched and requests are sent to the server destination.</description>
  <variables>
    <variable name="custom_header_id" value="123456789"/>
  </variables>
  <actions>
    <echo>
      <message>Send Http message and respond with 200 OK</message>
    </echo>
    <parallel>
      <actions>
        <http actor="helloClient" client="httpClient">
          <send-request>
            <POST accept="application/xml" content-type="application/xml">
              <headers>
                <header name="CustomHeaderId" value="${custom_header_id}"/>
                <header name="EmptyHeader" value=""/>
              </headers>
              <body>
                <data><![CDATA[<testRequestMessage>
                          <text>Hello HttpServer</text>
                        </testRequestMessage>]]></data>
              </body>
            </POST>
          </send-request>
        </http>
        <sequential>
          <actions>
            <http actor="helloClient" server="httpServerRequestEndpoint">
              <receive-request>
                <POST accept="application/xml" path="/test">
                  <headers>
                    <header name="contentType" value="application/xml"/>
                    <header name="CustomHeaderId" value="${custom_header_id}"/>
                    <header name="EmptyHeader" value=""/>
                    <header name="Authorization" value="Basic c29tZVVzZXJuYW1lOnNvbWVQYXNzd29yZA=="/>
                  </headers>
                  <body>
                    <data><![CDATA[<testRequestMessage>
                                      <text>Hello HttpServer</text>
                                  </testRequestMessage>]]></data>
                  </body>
                </POST>
                <extract>
                  <header name="citrus_jms_messageId" variable="correlation_id"/>
                </extract>
              </receive-request>
            </http>
            <http actor="helloServer" server="httpServerResponseEndpoint">
              <send-response>
                <response reason-phrase="OK" status="200" version="HTTP/1.1">
                  <headers>
                    <header name="CustomHeaderId" value="${custom_header_id}"/>
                    <header name="Content-Type" value="application/xml"/>
                    <header name="citrus_jms_correlationId" value="${correlation_id}"/>
                  </headers>
                  <body>
                    <data><![CDATA[<testResponseMessage>
                            <text>Hello Citrus</text>
                          </testResponseMessage>]]></data>
                  </body>
                </response>
              </send-response>
            </http>
          </actions>
        </sequential>
      </actions>
    </parallel>
    <http actor="helloServer" client="httpClient">
      <receive-response>
        <response reason-phrase="OK" status="200" version="HTTP/1.1">
          <headers>
            <header name="CustomHeaderId" value="${custom_header_id}"/>
          </headers>
          <body>
            <data><![CDATA[<testResponseMessage>
                      <text>Hello Citrus</text>
                    </testResponseMessage>]]></data>
          </body>
        </response>
      </receive-response>
    </http>
    <echo>
      <message>Send Http request and respond with 404 status code</message>
    </echo>
    <parallel>
      <actions>
        <http actor="helloClient" client="httpClient">
          <send-request>
            <POST accept="application/xml" content-type="application/xml">
              <headers>
                <header name="CustomHeaderId" value="${custom_header_id}"/>
              </headers>
              <body>
                <data><![CDATA[<testRequestMessage>
                                  <text>Hello HttpServer</text>
                              </testRequestMessage>]]></data>
              </body>
            </POST>
          </send-request>
        </http>
        <sequential>
          <actions>
            <http actor="helloClient" server="httpServerRequestEndpoint">
              <receive-request>
                <POST accept="application/xml" path="/test">
                  <headers>
                    <header name="contentType" value="application/xml"/>
                    <header name="CustomHeaderId" value="${custom_header_id}"/>
                  </headers>
                  <body>
                    <data><![CDATA[<testRequestMessage>
                                        <text>Hello HttpServer</text>
                                    </testRequestMessage>]]></data>
                  </body>
                </POST>
                <extract>
                  <header name="citrus_jms_messageId" variable="correlation_id"/>
                </extract>
              </receive-request>
            </http>
            <http actor="helloServer" server="httpServerResponseEndpoint">
              <send-response>
                <response reason-phrase="NOT_FOUND" status="404" version="HTTP/1.1">
                  <headers>
                    <header name="CustomHeaderId" value="${custom_header_id}"/>
                    <header name="Content-Type" value="text/plain"/>
                    <header name="citrus_jms_correlationId" value="${correlation_id}"/>
                  </headers>
                  <body>
                    <data/>
                  </body>
                </response>
              </send-response>
            </http>
          </actions>
        </sequential>
      </actions>
    </parallel>
    <http actor="helloServer" client="httpClient">
      <receive-response>
        <response reason-phrase="NOT_FOUND" status="404" version="HTTP/1.1">
          <headers>
            <header name="contentType" value="text/plain"/>
          </headers>
        </response>
      </receive-response>
    </http>
    <echo>
      <message>Skip response and use fallback endpoint adapter</message>
    </echo>
    <http client="httpClient">
      <send-request>
        <POST>
          <headers>
            <header name="CustomHeaderId" value="${custom_header_id}"/>
          </headers>
          <body>
            <data><![CDATA[<testRequestMessage>
                        <text>Hello HttpServer</text>
                      </testRequestMessage>]]></data>
          </body>
        </POST>
      </send-request>
    </http>
    <http client="httpClient">
      <receive-response timeout="2000">
        <response reason-phrase="OK" status="200" version="HTTP/1.1"/>
      </receive-response>
    </http>
  </actions>
</test>
