<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="HttpServerIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test receives messages as Http server instance and sends proper response back to client.</description>
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Christoph"/>
  </variables>
  <actions>
    <echo>
      <message>Test: Receive Http request via server instance and send back response.</message>
    </echo>
    <http client="echoHttpClient">
      <send-request fork="true">
        <POST>
          <headers>
            <header name="Operation" value="sayHello"/>
            <header name="CorrelationId" value="${correlationId}"/>
          </headers>
          <body>
            <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                  <MessageId>${messageId}</MessageId>
                  <CorrelationId>${correlationId}</CorrelationId>
                  <User>${user}</User>
                  <Text>Hello Citrus</Text>
                </HelloRequest>]]></data>
          </body>
        </POST>
      </send-request>
    </http>
    <http server="echoHttpServer">
      <receive-request>
        <POST>
          <headers>
            <header name="Operation" value="sayHello"/>
            <header name="CorrelationId" value="${correlationId}"/>
          </headers>
          <body>
            <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                  <MessageId>${messageId}</MessageId>
                  <CorrelationId>${correlationId}</CorrelationId>
                  <User>${user}</User>
                  <Text>Hello Citrus</Text>
                </HelloRequest>]]></data>
          </body>
        </POST>
      </receive-request>
    </http>
    <http server="echoHttpServer">
      <send-response>
        <response reason-phrase="OK" status="200" version="HTTP/1.1">
          <headers>
            <header name="Operation" value="sayHello"/>
            <header name="CorrelationId" value="${correlationId}"/>
          </headers>
          <body>
            <data><![CDATA[<HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageId}</MessageId>
                <CorrelationId>${correlationId}</CorrelationId>
                <User>HelloService</User>
                <Text>Hello ${user}</Text>
              </HelloResponse>]]></data>
          </body>
        </response>
      </send-response>
    </http>
    <http client="echoHttpClient">
      <receive-response>
        <response reason-phrase="OK" status="200" version="HTTP/1.1">
          <headers>
            <header name="Operation" value="sayHello"/>
            <header name="CorrelationId" value="${correlationId}"/>
          </headers>
          <body>
            <data><![CDATA[<HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageId}</MessageId>
                <CorrelationId>${correlationId}</CorrelationId>
                <User>HelloService</User>
                <Text>Hello ${user}</Text>
              </HelloResponse>]]></data>
          </body>
        </response>
      </receive-response>
    </http>
    <echo>
      <message>Test: Receive Http request via server instance and send back response.</message>
    </echo>
    <http client="echoHttpClient">
      <send-request fork="true">
        <PATCH>
          <headers>
            <header name="Operation" value="sayHello"/>
            <header name="CorrelationId" value="${correlationId}"/>
          </headers>
          <body>
            <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                  <MessageId>${messageId}</MessageId>
                  <CorrelationId>${correlationId}</CorrelationId>
                  <User>${user}</User>
                  <Text>Hello Citrus</Text>
                </HelloRequest>]]></data>
          </body>
        </PATCH>
      </send-request>
    </http>
    <http server="echoHttpServer">
      <receive-request>
        <PATCH>
          <headers>
            <header name="Operation" value="sayHello"/>
            <header name="CorrelationId" value="${correlationId}"/>
          </headers>
          <body>
            <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                  <MessageId>${messageId}</MessageId>
                  <CorrelationId>${correlationId}</CorrelationId>
                  <User>${user}</User>
                  <Text>Hello Citrus</Text>
                </HelloRequest>]]></data>
          </body>
        </PATCH>
      </receive-request>
    </http>
    <http server="echoHttpServer">
      <send-response>
        <response reason-phrase="OK" status="200" version="HTTP/1.1">
          <headers>
            <header name="Operation" value="sayHello"/>
            <header name="CorrelationId" value="${correlationId}"/>
          </headers>
          <body>
            <data><![CDATA[<HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageId}</MessageId>
                <CorrelationId>${correlationId}</CorrelationId>
                <User>HelloService</User>
                <Text>Hello ${user}</Text>
              </HelloResponse>]]></data>
          </body>
        </response>
      </send-response>
    </http>
    <http client="echoHttpClient">
      <receive-response>
        <response reason-phrase="OK" status="200" version="HTTP/1.1">
          <headers>
            <header name="Operation" value="sayHello"/>
            <header name="CorrelationId" value="${correlationId}"/>
          </headers>
          <body>
            <data><![CDATA[<HelloResponse xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageId}</MessageId>
                <CorrelationId>${correlationId}</CorrelationId>
                <User>HelloService</User>
                <Text>Hello ${user}</Text>
              </HelloResponse>]]></data>
          </body>
        </response>
      </receive-response>
    </http>
  </actions>
</test>
