<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Thorsten Schlathoelter" name="HttpClientWithRedirectDisabledIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Tests sending messages to an HTTP server instance that issues a redirect.
            The HTTP client used for the request has redirectDisabled enabled, preventing
            automatic redirection. This allows direct assertion of the response.</description>
  <variables>
    <variable name="correlationId" value="1000000001"/>
    <variable name="messageId" value="@randomNumber(10)@"/>
    <variable name="user" value="User"/>
  </variables>
  <actions>
    <echo>
      <message>Test: Send Http request and receive redirect</message>
    </echo>
    <http client="helloHttpClientWithRedirectDisabled">
      <send-request>
        <POST>
          <headers>
            <header name="Operation" value="sayHello"/>
            <header name="CorrelationId" value="${correlationId}"/>
          </headers>
          <body>
            <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                <MessageId>${messageId}</MessageId>
                <CorrelationId>${correlationId}</CorrelationId>
                <User>${user}</User>
                <Text>Hello Citrus</Text>
              </HelloRequest>]]></data>
          </body>
        </POST>
      </send-request>
    </http>
    <http client="helloHttpClientWithRedirectDisabled">
      <receive-response>
        <response reason-phrase="FOUND" status="302" version="HTTP/1.1">
          <headers>
            <header name="Location" value="http://localhost:11080/hello"/>
          </headers>
        </response>
      </receive-response>
    </http>
  </actions>
</test>
