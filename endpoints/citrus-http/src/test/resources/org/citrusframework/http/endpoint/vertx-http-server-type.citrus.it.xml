<test name="VertxHttpServerTypeEndpointIT" author="Citrus" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <endpoints>
    <endpoint type="http.vertx-server" name="xmlVertxTypeServer">
      <property name="port" value="0"/>
      <property name="autoStart" value="true"/>
      <property name="timeout" value="5000"/>
    </endpoint>
    <http>
      <client name="xmlVertxTypeClient" request-url="http://localhost" timeout="5000"/>
    </http>
  </endpoints>
  <actions>
    <http client="xmlVertxTypeClient">
      <send-request uri="http://localhost:citrus:serverPort('xmlVertxTypeServer')" fork="true">
        <GET path="/orders/42"/>
      </send-request>
    </http>
    <http server="xmlVertxTypeServer">
      <receive-request timeout="5000">
        <GET path="/orders/42"/>
      </receive-request>
    </http>
    <http server="xmlVertxTypeServer">
      <send-response>
        <response status="200" reason-phrase="OK" version="HTTP/1.1" content-type="text/plain">
          <body>
            <data>Vert.x server response</data>
          </body>
        </response>
      </send-response>
    </http>
    <http client="xmlVertxTypeClient">
      <receive-response timeout="5000">
        <response status="200"/>
      </receive-response>
    </http>
  </actions>
</test>
