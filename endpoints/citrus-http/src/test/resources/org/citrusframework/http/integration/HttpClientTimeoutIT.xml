<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="HttpClientTimeoutIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test tries to receive message from Http server instance but gets timeout.</description>
  <actions>
    <echo>
      <message>Test: Receive Http message timeout</message>
    </echo>
    <create-variables>
      <variable name="citrus_message_correlator_helloHttpClient" value="1"/>
    </create-variables>
    <assert exception="org.citrusframework.exceptions.ActionTimeoutException" message="Action timeout after 5000 milliseconds. Failed to receive message on endpoint: 'helloHttpClient'">
      <when>
        <receive endpoint="helloHttpClient">
          <message>
            <headers>
              <header name="Operation" value="sayHello"/>
            </headers>
            <body>
              <data/>
            </body>
          </message>
        </receive>
      </when>
    </assert>
  </actions>
</test>
