<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Citrus" name="HttpGzipEncodedIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>This test sends a x-www-form-urlencoded HTML form data content to Http server for validation.
      The form data is validated using plain text validation</description>
  <variables>
    <variable name="text" value="This is the text"/>
  </variables>
  <actions>
    <echo>
      <message>Send Http client request for gzip compressed data</message>
    </echo>
    <http client="echoHttpClient">
      <send-request fork="true">
        <POST content-type="text/html">
          <headers>
            <header name="Accept-Encoding" value="gzip"/>
            <header name="Accept" value="text/plain"/>
          </headers>
        </POST>
      </send-request>
    </http>
    <echo>
      <message>Receive gzip compressed text</message>
    </echo>
    <http server="echoHttpServer">
      <receive-request>
        <POST path="/echo">
          <headers>
            <header name="Content-Type" value="text/html"/>
            <header name="Accept-Encoding" value="gzip"/>
            <header name="Accept" value="text/plain"/>
          </headers>
        </POST>
      </receive-request>
    </http>
    <echo>
      <message>Send Http server gzip compressed response</message>
    </echo>
    <http server="echoHttpServer">
      <send-response>
        <response reason-phrase="OK" status="200">
          <headers>
            <header name="Content-Encoding" value="gzip"/>
            <header name="Content-Type" value="text/plain"/>
          </headers>
          <body>
            <data>${text}</data>
          </body>
        </response>
      </send-response>
    </http>
    <echo>
      <message>Receive gzip compressed text</message>
    </echo>
    <http client="echoHttpClient">
      <receive-response>
        <response reason-phrase="OK" status="200" type="plaintext">
          <headers>
            <header name="Content-Type" value="@startsWith(text/plain)@"/>
          </headers>
          <body>
            <data>${text}</data>
          </body>
        </response>
      </receive-response>
    </http>
    <echo>
      <message>Send Http client request with gzip compressed data</message>
    </echo>
    <http client="echoHttpClient">
      <send-request fork="true">
        <POST content-type="text/html" type="gzip">
          <headers>
            <header name="Content-Encoding" value="gzip"/>
          </headers>
          <body>
            <data>${text}</data>
          </body>
        </POST>
      </send-request>
    </http>
    <echo>
      <message>Receive gzip compressed data</message>
    </echo>
    <http server="echoHttpServer">
      <receive-request>
        <POST path="/echo" type="plaintext">
          <headers>
            <header name="Content-Encoding" value="gzip"/>
          </headers>
          <body>
            <data>${text}</data>
          </body>
        </POST>
      </receive-request>
    </http>
    <echo>
      <message>Send Http server response</message>
    </echo>
    <http server="echoHttpServer">
      <send-response>
        <response reason-phrase="OK" status="200">
          <headers>
            <header name="Content-Encoding" value="gzip"/>
            <header name="Content-Type" value="text/plain"/>
          </headers>
        </response>
      </send-response>
    </http>
    <echo>
      <message>Receive server response</message>
    </echo>
    <http client="echoHttpClient">
      <receive-response>
        <response reason-phrase="OK" status="200"/>
      </receive-response>
    </http>
  </actions>
</test>
