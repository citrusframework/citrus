<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Sven Hettwer" name="HttpJsonSchemaValidationIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Tests whether the client/server is able to detect invalid json objects defined by a given json schema</description>
  <actions>
    <echo>
      <message>Test: Send a request to the server and detect the invalid server response</message>
    </echo>
    <http client="echoHttpClient">
      <send-request fork="true">
        <GET/>
      </send-request>
    </http>
    <http server="echoHttpServer">
      <receive-request>
        <GET/>
      </receive-request>
    </http>
    <http server="echoHttpServer">
      <send-response>
        <response>
          <body>
            <data>[{}]</data>
          </body>
        </response>
      </send-response>
    </http>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <http client="echoHttpClient">
          <receive-response>
            <response schema-validation="true" type="json">
              <body>
                <data>[{}]</data>
              </body>
            </response>
          </receive-response>
        </http>
      </when>
    </assert>
    <echo>
      <message>Test: Send a valid request to the server which is successfully validated against the schema</message>
    </echo>
    <http client="echoHttpClient">
      <send-request fork="true">
        <GET/>
      </send-request>
    </http>
    <http server="echoHttpServer">
      <receive-request>
        <GET/>
      </receive-request>
    </http>
    <http server="echoHttpServer">
      <send-response>
        <response>
          <body>
            <data>[
              {
                "id": 2,
                "name": "An ice sculpture",
                "price": 12.50,
                "tags": ["cold", "ice"],
                "dimensions": {
                  "length": 7.0,
                  "width": 12.0,
                  "height": 9.5
                 }
              }
            ]</data>
          </body>
        </response>
      </send-response>
    </http>
    <http client="echoHttpClient">
      <receive-response>
        <response schema-validation="true" type="json">
          <body>
            <data>[
                  {
                    "id": 2,
                    "name": "An ice sculpture",
                    "price": 12.50,
                    "tags": ["cold", "ice"],
                    "dimensions": {
                      "length": 7.0,
                      "width": 12.0,
                      "height": 9.5
                    }
                  }
                ]</data>
          </body>
        </response>
      </receive-response>
    </http>
    <echo>
      <message>Test: Detect the invalid request send to the server</message>
    </echo>
    <http client="echoHttpClient">
      <send-request fork="true">
        <POST type="json">
          <body>
            <data>[{}]</data>
          </body>
        </POST>
      </send-request>
    </http>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <http server="echoHttpServer">
          <receive-request>
            <POST schema-validation="true" type="json">
              <body>
                <data>[{}]</data>
              </body>
            </POST>
          </receive-request>
        </http>
      </when>
    </assert>
    <echo>
      <message>Test: Successfully accept the valid massage on the server</message>
    </echo>
    <http client="echoHttpClient">
      <send-request fork="true">
        <POST type="json">
          <body>
            <data>[
                {
                  "id": 2,
                  "name": "An ice sculpture",
                  "price": 12.50,
                  "tags": ["cold", "ice"],
                  "dimensions": {
                    "length": 7.0,
                    "width": 12.0,
                    "height": 9.5
                  }
                }
              ]</data>
          </body>
        </POST>
      </send-request>
    </http>
    <http server="echoHttpServer">
      <receive-request>
        <POST schema-validation="true" type="json">
          <body>
            <data>[
                {
                  "id": 2,
                  "name": "An ice sculpture",
                  "price": 12.50,
                  "tags": ["cold", "ice"],
                  "dimensions": {
                    "length": 7.0,
                    "width": 12.0,
                    "height": 9.5
                  }
                }
              ]</data>
          </body>
        </POST>
      </receive-request>
    </http>
    <echo>
      <message>Test: Error is thrown if a non existing schema was referenced</message>
    </echo>
    <http client="echoHttpClient">
      <send-request fork="true">
        <POST type="json">
          <body>
            <data>{}</data>
          </body>
        </POST>
      </send-request>
    </http>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException">
      <when>
        <http server="echoHttpServer">
          <receive-request>
            <POST schema="notExisting" schema-validation="true" type="json">
              <body>
                <data>{}</data>
              </body>
            </POST>
          </receive-request>
        </http>
      </when>
    </assert>
    <echo>
      <message>Test: Error is thrown if a non existing repository was referenced</message>
    </echo>
    <http client="echoHttpClient">
      <send-request fork="true">
        <POST type="json">
          <body>
            <data>{}</data>
          </body>
        </POST>
      </send-request>
    </http>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException">
      <when>
        <http server="echoHttpServer">
          <receive-request>
            <POST schema-repository="notExistingRepo" schema-validation="true" type="json">
              <body>
                <data>{}</data>
              </body>
            </POST>
          </receive-request>
        </http>
      </when>
    </assert>
    <echo>
      <message>Test: Successfully accept valid message with specified schema repository</message>
    </echo>
    <http client="echoHttpClient">
      <send-request fork="true">
        <POST type="json">
          <body>
            <data>{
                "isbn" : "0345391802",
                "title": "The Hitchhiker's Guide to the Galaxy",
                "author": "Douglas Adams"
              }</data>
          </body>
        </POST>
      </send-request>
    </http>
    <http server="echoHttpServer">
      <receive-request>
        <POST schema-repository="jsonBookStoreRepository" schema-validation="true" type="json">
          <body>
            <data>{
                "isbn" : "0345391802",
                "title": "The Hitchhiker's Guide to the Galaxy",
                "author": "Douglas Adams"
              }</data>
          </body>
        </POST>
      </receive-request>
    </http>
    <echo>
      <message>Test: Successfully accept valid message with specified schema</message>
    </echo>
    <http client="echoHttpClient">
      <send-request fork="true">
        <POST type="json">
          <body>
            <data>{
                "isbn" : "0345391802",
                "title": "The Hitchhiker's Guide to the Galaxy",
                "author": "Douglas Adams"
              }</data>
          </body>
        </POST>
      </send-request>
    </http>
    <http server="echoHttpServer">
      <receive-request>
        <POST schema="bookStore" schema-validation="true" type="json">
          <body>
            <data>{
                "isbn" : "0345391802",
                "title": "The Hitchhiker's Guide to the Galaxy",
                "author": "Douglas Adams"
              }</data>
          </body>
        </POST>
      </receive-request>
    </http>
    <echo>
      <message>Test: The correct repository has been chosen but the message was invalid</message>
    </echo>
    <http client="echoHttpClient">
      <send-request fork="true">
        <POST type="json">
          <body>
            <data>[
                            {
                                "id": 2,
                                "name": "An ice sculpture",
                                "price": 12.50,
                                "tags": ["cold", "ice"],
                                "dimensions": {
                                    "length": 7.0,
                                    "width": 12.0,
                                    "height": 9.5
                                }
                            }
                        ]</data>
          </body>
        </POST>
      </send-request>
    </http>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <http server="echoHttpServer">
          <receive-request>
            <POST schema-repository="jsonBookStoreRepository" schema-validation="true" type="json">
              <body>
                <data>[
                                    {
                                        "id": 2,
                                        "name": "An ice sculpture",
                                        "price": 12.50,
                                        "tags": ["cold", "ice"],
                                        "dimensions": {
                                            "length": 7.0,
                                            "width": 12.0,
                                            "height": 9.5
                                        }
                                    }
                                ]</data>
              </body>
            </POST>
          </receive-request>
        </http>
      </when>
    </assert>
    <echo>
      <message>Test: The correct schema was chosen but the message was invalid</message>
    </echo>
    <http client="echoHttpClient">
      <send-request fork="true">
        <POST type="json">
          <body>
            <data>[
                            {
                                "id": 2,
                                "name": "An ice sculpture",
                                "price": 12.50,
                                "tags": ["cold", "ice"],
                                "dimensions": {
                                    "length": 7.0,
                                    "width": 12.0,
                                    "height": 9.5
                                }
                            }
                        ]</data>
          </body>
        </POST>
      </send-request>
    </http>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <http server="echoHttpServer">
          <receive-request>
            <POST schema="bookStore" schema-validation="true" type="json">
              <body>
                <data>[
                                    {
                                        "id": 2,
                                        "name": "An ice sculpture",
                                        "price": 12.50,
                                        "tags": ["cold", "ice"],
                                        "dimensions": {
                                            "length": 7.0,
                                            "width": 12.0,
                                            "height": 9.5
                                        }
                                    }
                                ]</data>
              </body>
            </POST>
          </receive-request>
        </http>
      </when>
    </assert>
  </actions>
</test>
