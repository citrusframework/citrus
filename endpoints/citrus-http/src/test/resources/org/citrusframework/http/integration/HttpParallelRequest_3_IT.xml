<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="HttpParallelRequest_3_IT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>The simple HttpServer implementation is launched and requests are sent in parallel to the server destination.</description>
  <variables>
    <variable name="custom_header_id" value="123456789"/>
  </variables>
  <actions>
    <parallel>
      <actions>
        <sequential>
          <actions>
            <echo>
              <message>Sending request message #1</message>
            </echo>
            <http client="httpStandaloneClient">
              <send-request fork="true">
                <POST>
                  <headers>
                    <header name="CustomHeaderId" value="${custom_header_id}"/>
                  </headers>
                  <body>
                    <data><![CDATA[<testRequestMessage>
                        <text>Hello HttpServer</text>
                      </testRequestMessage>]]></data>
                  </body>
                </POST>
                <extract>
                  <header name="citrus_message_id" variable="request#1"/>
                </extract>
              </send-request>
            </http>
          </actions>
        </sequential>
        <sequential>
          <actions>
            <echo>
              <message>Sending request message #2</message>
            </echo>
            <http client="httpStandaloneClient">
              <send-request fork="true">
                <POST>
                  <headers>
                    <header name="CustomHeaderId" value="${custom_header_id}"/>
                  </headers>
                  <body>
                    <data><![CDATA[<testRequestMessage>
                        <text>Hello HttpServer</text>
                      </testRequestMessage>]]></data>
                  </body>
                </POST>
                <extract>
                  <header name="citrus_message_id" variable="request#2"/>
                </extract>
              </send-request>
            </http>
          </actions>
        </sequential>
      </actions>
    </parallel>
    <http client="httpStandaloneClient">
      <receive-response>
        <selector>
          <element name="citrus_message_id" value="${request#1}"/>
        </selector>
        <response reason-phrase="OK" status="200" version="HTTP/1.1">
          <body>
            <data><![CDATA[<testResponseMessage>
                <text>Hello TestFramework</text>
                </testResponseMessage>]]></data>
          </body>
        </response>
      </receive-response>
    </http>
    <echo>
      <message>Successfully received response message #1</message>
    </echo>
    <http client="httpStandaloneClient">
      <receive-response>
        <selector>
          <element name="citrus_message_id" value="${request#2}"/>
        </selector>
        <response reason-phrase="OK" status="200" version="HTTP/1.1">
          <body>
            <data><![CDATA[<testResponseMessage>
                <text>Hello TestFramework</text>
                </testResponseMessage>]]></data>
          </body>
        </response>
      </receive-response>
    </http>
    <echo>
      <message>Successfully received response message #2</message>
    </echo>
  </actions>
</test>
