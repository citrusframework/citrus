<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="HttpMessageControllerIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>The Http message client sends multiple requests to REST message controller with various Http methods, query params and context path variables. Server
            side controller needs to take care on these items so tester can validate those in receiving action.</description>
  <variables>
    <variable name="id" value="123456789"/>
  </variables>
  <actions>
    <echo>
      <message>First request without query parameter and context path variables.</message>
    </echo>
    <parallel>
      <actions>
        <http client="httpClient">
          <send-request uri="http://localhost:11082">
            <GET accept="application/xml;charset=UTF-8" content-type="text/html"/>
          </send-request>
        </http>
        <sequential>
          <actions>
            <http server="httpServerRequestEndpoint">
              <receive-request>
                <GET accept="application/xml;charset=UTF-8" context-path="" path="/" version="HTTP/1.1">
                  <headers>
                    <header name="contentType" value="text/html"/>
                    <header name="Host" value="localhost:11082"/>
                  </headers>
                </GET>
              </receive-request>
            </http>
          </actions>
        </sequential>
      </actions>
    </parallel>
    <http client="httpClient">
      <receive-response timeout="2000">
        <response reason-phrase="OK" status="200" version="HTTP/1.1"/>
      </receive-response>
    </http>
    <echo>
      <message>Use context path variables.</message>
    </echo>
    <parallel>
      <actions>
        <http client="httpClient">
          <send-request>
            <GET accept="application/xml;charset=UTF-8" content-type="text/html" path="/user/${id}"/>
          </send-request>
        </http>
        <sequential>
          <actions>
            <http server="httpServerRequestEndpoint">
              <receive-request>
                <GET accept="application/xml;charset=UTF-8" context-path="" path="/test/user/${id}">
                  <headers>
                    <header name="contentType" value="text/html"/>
                    <header name="Host" value="localhost:11082"/>
                  </headers>
                  <body>
                    <data/>
                  </body>
                </GET>
              </receive-request>
            </http>
          </actions>
        </sequential>
      </actions>
    </parallel>
    <http client="httpClient">
      <receive-response timeout="2000">
        <response reason-phrase="OK" status="200" version="HTTP/1.1"/>
      </receive-response>
    </http>
    <echo>
      <message>Use query parameter and context path variables.</message>
    </echo>
    <parallel>
      <actions>
        <http client="httpClient">
          <send-request>
            <GET accept="application/xml;charset=UTF-8" content-type="text/html" path="/user">
              <param name="id" value="${id}"/>
              <param name="name" value="TestUser"/>
            </GET>
          </send-request>
        </http>
        <sequential>
          <actions>
            <http server="httpServerRequestEndpoint">
              <receive-request>
                <GET accept="application/xml;charset=UTF-8" context-path="" path="/test/user">
                  <headers>
                    <header name="contentType" value="text/html"/>
                    <header name="Host" value="localhost:11082"/>
                  </headers>
                  <body>
                    <data/>
                  </body>
                  <param name="id" value="${id}"/>
                  <param name="name" value="TestUser"/>
                </GET>
              </receive-request>
            </http>
          </actions>
        </sequential>
      </actions>
    </parallel>
    <http client="httpClient">
      <receive-response timeout="2000">
        <response reason-phrase="OK" status="200" version="HTTP/1.1"/>
      </receive-response>
    </http>
  </actions>
</test>
