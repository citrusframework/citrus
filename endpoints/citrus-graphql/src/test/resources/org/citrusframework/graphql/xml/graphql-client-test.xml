<test name="GraphQlClientTest" author="Citrus" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <variables>
    <variable name="id" value="42"/>
  </variables>
  <actions>
    <graphql client="graphQlClient">
      <send-request operation-name="Book">
        <query>query Book($id: ID!) { book(id: $id) { title } }</query>
        <variable name="id" value="${id}"/>
      </send-request>
    </graphql>

    <graphql client="graphQlClient">
      <receive-response status="200">
        <data path="$.book.title" value="Dune"/>
      </receive-response>
    </graphql>

    <graphql client="graphQlClient">
      <send-request method="GET" strict="false">
        <query file="classpath:org/citrusframework/graphql/actions/book.graphql"/>
        <variables>{"id": "7"}</variables>
      </send-request>
    </graphql>

    <graphql client="graphQlClient">
      <receive-response>
        <expect-error code="NOT_FOUND" message="@contains('not found')@" path="book"/>
        <data>{"book": null}</data>
      </receive-response>
    </graphql>
  </actions>
</test>
