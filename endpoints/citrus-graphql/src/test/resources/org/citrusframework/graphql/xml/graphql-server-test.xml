<test name="GraphQlServerTest" author="Citrus" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <actions>
    <graphql server="graphQlServer">
      <receive-request operation-name="Book" method="POST">
        <query>query Book($id:ID!){book(id:$id){title}}</query>
        <variable name="id" value="@isNumber()@"/>
        <extract>
          <header name="citrus_graphql_operation_type" variable="operationType"/>
        </extract>
      </receive-request>
    </graphql>

    <graphql server="graphQlServer">
      <send-response status="200">
        <data>{"book":{"title":"Dune","author":null}}</data>
        <error message="Author unavailable (${operationType})" path="book.author" code="PARTIAL"/>
      </send-response>
    </graphql>

    <graphql server="graphQlServer">
      <send-response strict="false">
        <message>
          <body>
            <data>{"unexpected":true}</data>
          </body>
        </message>
      </send-response>
    </graphql>
  </actions>
</test>
