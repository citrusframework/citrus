<test name="GraphQlZeroTodosXmlIT" author="Citrus" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>GraphQLZero todos: get, list, create, update and delete (XML DSL).</description>
  <endpoints>
    <graphql>
      <client name="zeroTodos" request-url="http://localhost:19380" schema="classpath:org/citrusframework/graphql/integration/zero/graphqlzero.graphqls" timeout="5000"/>
    </graphql>
  </endpoints>
  <actions>
    <!-- query GetTodo -->
    <graphql client="zeroTodos">
      <send-request>
        <query>
          query GetTodo($id: ID!) {
            todo(id: $id) {
              id
              title
              completed
              user { id }
            }
          }
        </query>
        <variables>{&quot;id&quot;: &quot;1&quot;}</variables>
      </send-request>
    </graphql>
    <graphql client="zeroTodos">
      <receive-response status="200">
        <data path="$.todo.title" value="delectus aut autem"/>
        <data path="$.todo.completed" value="false"/>
        <data path="$.todo.user.id" value="1"/>
      </receive-response>
    </graphql>

    <!-- query ListTodos -->
    <graphql client="zeroTodos">
      <send-request>
        <query>
          query ListTodos($options: PageQueryOptions) {
            todos(options: $options) {
              data { id }
              meta { totalCount }
            }
          }
        </query>
        <variables>{&quot;options&quot;: {&quot;paginate&quot;: {&quot;page&quot;: 1, &quot;limit&quot;: 2}}}</variables>
      </send-request>
    </graphql>
    <graphql client="zeroTodos">
      <receive-response status="200">
        <data path="$.todos.meta.totalCount" value="200"/>
        <data path="$.todos.data.length()" value="2"/>
        <data path="$.todos.data[0].id" value="1"/>
      </receive-response>
    </graphql>

    <!-- mutation CreateTodo -->
    <graphql client="zeroTodos">
      <send-request>
        <query>
          mutation CreateTodo($input: CreateTodoInput!) {
            createTodo(input: $input) { id title completed }
          }
        </query>
        <variables>{&quot;input&quot;: {&quot;title&quot;: &quot;Write GraphQL tests&quot;, &quot;completed&quot;: false}}</variables>
      </send-request>
    </graphql>
    <graphql client="zeroTodos">
      <receive-response status="200">
        <data path="$.createTodo.id" value="201"/>
        <data path="$.createTodo.title" value="Write GraphQL tests"/>
        <data path="$.createTodo.completed" value="false"/>
      </receive-response>
    </graphql>

    <!-- mutation UpdateTodo -->
    <graphql client="zeroTodos">
      <send-request>
        <query>
          mutation UpdateTodo($id: ID!, $input: UpdateTodoInput!) {
            updateTodo(id: $id, input: $input) { id completed }
          }
        </query>
        <variables>{&quot;id&quot;: &quot;1&quot;, &quot;input&quot;: {&quot;completed&quot;: true}}</variables>
      </send-request>
    </graphql>
    <graphql client="zeroTodos">
      <receive-response status="200">
        <data path="$.updateTodo.id" value="1"/>
        <data path="$.updateTodo.completed" value="true"/>
      </receive-response>
    </graphql>

    <!-- mutation DeleteTodo -->
    <graphql client="zeroTodos">
      <send-request>
        <query>
          mutation DeleteTodo($id: ID!) {
            deleteTodo(id: $id)
          }
        </query>
        <variables>{&quot;id&quot;: &quot;1&quot;}</variables>
      </send-request>
    </graphql>
    <graphql client="zeroTodos">
      <receive-response status="200">
        <data path="$.deleteTodo" value="true"/>
      </receive-response>
    </graphql>

  </actions>
</test>
