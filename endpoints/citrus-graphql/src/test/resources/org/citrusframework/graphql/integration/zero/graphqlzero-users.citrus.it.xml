<test name="GraphQlZeroUsersXmlIT" author="Citrus" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>GraphQLZero users: get, list, create, update and delete (XML DSL).</description>
  <endpoints>
    <graphql>
      <client name="zeroUsers" request-url="http://localhost:19380" schema="classpath:org/citrusframework/graphql/integration/zero/graphqlzero.graphqls" timeout="5000"/>
    </graphql>
  </endpoints>
  <actions>
    <!-- query GetUser -->
    <graphql client="zeroUsers">
      <send-request>
        <query>
          query GetUser($id: ID!) {
            user(id: $id) {
              id
              name
              username
              email
              address { city }
            }
          }
        </query>
        <variables>{&quot;id&quot;: &quot;1&quot;}</variables>
      </send-request>
    </graphql>
    <graphql client="zeroUsers">
      <receive-response status="200">
        <data path="$.user.name" value="Leanne Graham"/>
        <data path="$.user.username" value="Bret"/>
        <data path="$.user.email" value="Sincere@april.biz"/>
        <data path="$.user.address.city" value="Gwenborough"/>
      </receive-response>
    </graphql>

    <!-- query ListUsers -->
    <graphql client="zeroUsers">
      <send-request>
        <query>
          query ListUsers($options: PageQueryOptions) {
            users(options: $options) {
              data { id name }
              meta { totalCount }
            }
          }
        </query>
        <variables>{&quot;options&quot;: {&quot;paginate&quot;: {&quot;page&quot;: 1, &quot;limit&quot;: 2}}}</variables>
      </send-request>
    </graphql>
    <graphql client="zeroUsers">
      <receive-response status="200">
        <data path="$.users.meta.totalCount" value="10"/>
        <data path="$.users.data.length()" value="2"/>
        <data path="$.users.data[0].id" value="1"/>
        <data path="$.users.data[1].name" value="Ervin Howell"/>
      </receive-response>
    </graphql>

    <!-- mutation CreateUser -->
    <graphql client="zeroUsers">
      <send-request>
        <query>
          mutation CreateUser($input: CreateUserInput!) {
            createUser(input: $input) { id name username email }
          }
        </query>
        <variables>{&quot;input&quot;: {&quot;name&quot;: &quot;Citrus Tester&quot;, &quot;username&quot;: &quot;citrus&quot;, &quot;email&quot;: &quot;citrus@example.org&quot;}}</variables>
      </send-request>
    </graphql>
    <graphql client="zeroUsers">
      <receive-response status="200">
        <data path="$.createUser.id" value="11"/>
        <data path="$.createUser.username" value="citrus"/>
        <data path="$.createUser.email" value="citrus@example.org"/>
      </receive-response>
    </graphql>

    <!-- mutation UpdateUser -->
    <graphql client="zeroUsers">
      <send-request>
        <query>
          mutation UpdateUser($id: ID!, $input: UpdateUserInput!) {
            updateUser(id: $id, input: $input) { id name }
          }
        </query>
        <variables>{&quot;id&quot;: &quot;1&quot;, &quot;input&quot;: {&quot;name&quot;: &quot;Leanne Citrus&quot;}}</variables>
      </send-request>
    </graphql>
    <graphql client="zeroUsers">
      <receive-response status="200">
        <data path="$.updateUser.id" value="1"/>
        <data path="$.updateUser.name" value="Leanne Citrus"/>
      </receive-response>
    </graphql>

    <!-- mutation DeleteUser -->
    <graphql client="zeroUsers">
      <send-request>
        <query>
          mutation DeleteUser($id: ID!) {
            deleteUser(id: $id)
          }
        </query>
        <variables>{&quot;id&quot;: &quot;1&quot;}</variables>
      </send-request>
    </graphql>
    <graphql client="zeroUsers">
      <receive-response status="200">
        <data path="$.deleteUser" value="true"/>
      </receive-response>
    </graphql>

  </actions>
</test>
