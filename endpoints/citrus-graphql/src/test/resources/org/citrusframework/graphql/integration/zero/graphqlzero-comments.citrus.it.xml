<test name="GraphQlZeroCommentsXmlIT" author="Citrus" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>GraphQLZero comments: get, list, create, update and delete (XML DSL).</description>
  <endpoints>
    <graphql>
      <client name="zeroComments" request-url="http://localhost:19380" schema="classpath:org/citrusframework/graphql/integration/zero/graphqlzero.graphqls" timeout="5000"/>
    </graphql>
  </endpoints>
  <actions>
    <!-- query GetComment -->
    <graphql client="zeroComments">
      <send-request>
        <query>
          query GetComment($id: ID!) {
            comment(id: $id) {
              id
              name
              email
              post { id }
            }
          }
        </query>
        <variables>{&quot;id&quot;: &quot;1&quot;}</variables>
      </send-request>
    </graphql>
    <graphql client="zeroComments">
      <receive-response status="200">
        <data path="$.comment.name" value="id labore ex et quam laborum"/>
        <data path="$.comment.email" value="Eliseo@gardner.biz"/>
        <data path="$.comment.post.id" value="1"/>
      </receive-response>
    </graphql>

    <!-- query ListComments -->
    <graphql client="zeroComments">
      <send-request>
        <query>
          query ListComments($options: PageQueryOptions) {
            comments(options: $options) {
              data { id }
              meta { totalCount }
            }
          }
        </query>
        <variables>{&quot;options&quot;: {&quot;paginate&quot;: {&quot;page&quot;: 1, &quot;limit&quot;: 2}}}</variables>
      </send-request>
    </graphql>
    <graphql client="zeroComments">
      <receive-response status="200">
        <data path="$.comments.meta.totalCount" value="500"/>
        <data path="$.comments.data.length()" value="2"/>
        <data path="$.comments.data[0].id" value="1"/>
      </receive-response>
    </graphql>

    <!-- mutation CreateComment -->
    <graphql client="zeroComments">
      <send-request>
        <query>
          mutation CreateComment($input: CreateCommentInput!) {
            createComment(input: $input) { id name email body }
          }
        </query>
        <variables>{&quot;input&quot;: {&quot;name&quot;: &quot;Citrus&quot;, &quot;email&quot;: &quot;citrus@example.org&quot;, &quot;body&quot;: &quot;Nice post&quot;}}</variables>
      </send-request>
    </graphql>
    <graphql client="zeroComments">
      <receive-response status="200">
        <data path="$.createComment.id" value="501"/>
        <data path="$.createComment.body" value="Nice post"/>
      </receive-response>
    </graphql>

    <!-- mutation UpdateComment -->
    <graphql client="zeroComments">
      <send-request>
        <query>
          mutation UpdateComment($id: ID!, $input: UpdateCommentInput!) {
            updateComment(id: $id, input: $input) { id body }
          }
        </query>
        <variables>{&quot;id&quot;: &quot;1&quot;, &quot;input&quot;: {&quot;body&quot;: &quot;Edited by Citrus&quot;}}</variables>
      </send-request>
    </graphql>
    <graphql client="zeroComments">
      <receive-response status="200">
        <data path="$.updateComment.id" value="1"/>
        <data path="$.updateComment.body" value="Edited by Citrus"/>
      </receive-response>
    </graphql>

    <!-- mutation DeleteComment -->
    <graphql client="zeroComments">
      <send-request>
        <query>
          mutation DeleteComment($id: ID!) {
            deleteComment(id: $id)
          }
        </query>
        <variables>{&quot;id&quot;: &quot;1&quot;}</variables>
      </send-request>
    </graphql>
    <graphql client="zeroComments">
      <receive-response status="200">
        <data path="$.deleteComment" value="true"/>
      </receive-response>
    </graphql>

  </actions>
</test>
