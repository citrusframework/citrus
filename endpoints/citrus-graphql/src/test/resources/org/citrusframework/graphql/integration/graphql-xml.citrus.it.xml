<test name="GraphQlXmlIT" author="Citrus" status="FINAL" xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <endpoints>
    <graphql>
      <server name="xmlGraphQlServer" port="19180" auto-start="true" timeout="5000"/>
    </graphql>
    <graphql>
      <client name="xmlGraphQlClient" request-url="http://localhost:19180" timeout="5000"/>
    </graphql>
  </endpoints>
  <variables>
    <variable name="id" value="42"/>
  </variables>
  <actions>
    <graphql client="xmlGraphQlClient">
      <send-request operation-name="Book" fork="true">
        <query>query Book($id: ID!) { book(id: $id) { title } }</query>
        <variable name="id" value="${id}"/>
      </send-request>
    </graphql>
    <graphql server="xmlGraphQlServer">
      <receive-request operation-name="Book" method="POST">
        <query>query Book($id:ID!){book(id:$id){title}}</query>
        <variable name="id" value="${id}"/>
      </receive-request>
    </graphql>
    <graphql server="xmlGraphQlServer">
      <send-response>
        <data>{"book":{"title":"Dune"}}</data>
      </send-response>
    </graphql>
    <graphql client="xmlGraphQlClient">
      <receive-response status="200">
        <data path="$.book.title" value="Dune"/>
      </receive-response>
    </graphql>

    <graphql client="xmlGraphQlClient">
      <send-request method="GET" fork="true">
        <query>{ book(id: "7") { title } }</query>
      </send-request>
    </graphql>
    <graphql server="xmlGraphQlServer">
      <receive-request method="GET"/>
    </graphql>
    <graphql server="xmlGraphQlServer">
      <send-response>
        <error message="Book 7 not found" path="book" code="NOT_FOUND"/>
      </send-response>
    </graphql>
    <graphql client="xmlGraphQlClient">
      <receive-response>
        <expect-error code="NOT_FOUND" message="@contains('not found')@" path="book"/>
      </receive-response>
    </graphql>
  </actions>
</test>
