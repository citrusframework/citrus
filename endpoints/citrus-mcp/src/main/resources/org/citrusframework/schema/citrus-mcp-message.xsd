<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.citrusframework.org/schema/mcp/message"
           targetNamespace="http://www.citrusframework.org/schema/mcp/message"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

    <xs:element name="tool-invocation">
      <xs:annotation>
        <xs:documentation>Mcp tool invocation specifies the tool name and optional arguments.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
        <xs:sequence>
          <xs:element name="args" minOccurs="0">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="arg" maxOccurs="unbounded">
                  <xs:complexType>
                    <xs:attribute name="name" use="required" type="xs:string"/>
                    <xs:attribute name="value" use="required" type="xs:string"/>
                  </xs:complexType>
                </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required"/>
      </xs:complexType>
    </xs:element>

    <xs:element name="tool-response">
      <xs:annotation>
        <xs:documentation>Mcp tool response marks success or failure when processing the tool invocation.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
        <xs:sequence>
          <xs:element name="content" type="xs:string"/>
        </xs:sequence>
        <xs:attribute name="error" type="xs:boolean" default="false"/>
      </xs:complexType>
    </xs:element>
</xs:schema>
