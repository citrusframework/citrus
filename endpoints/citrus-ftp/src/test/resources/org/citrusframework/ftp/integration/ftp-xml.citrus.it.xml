<test name="FtpXmlIT" author="Christoph" status="FINAL"
      xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase
                          http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test sends and receives messages as Ftp client and server in XML.</description>

  <endpoints>
    <ftp>
      <server name="ftpXmlServer" port="22225" auto-start="true"
              user-manager-properties="classpath:ftp.server.properties"/>
    </ftp>
    <ftp>
      <client name="ftpXmlClient" host="localhost" port="22225" username="admin" password="admin" timeout="10000"/>
    </ftp>
  </endpoints>

  <actions>
    <echo message="Test: Receive Ftp request via server instance and send back response."/>

    <echo message="Sending PWD command to FTP server"/>

    <send endpoint="ftpXmlClient" fork="true">
      <message>
        <body>
          <data>
            <![CDATA[
            <command xmlns="http://www.citrusframework.org/schema/ftp/message">
              <signal>PWD</signal>
              <arguments>test</arguments>
            </command>
            ]]>
          </data>
        </body>
      </message>
    </send>

    <receive endpoint="ftpXmlServer">
      <message>
        <body>
          <data>
            <![CDATA[
            <command xmlns="http://www.citrusframework.org/schema/ftp/message">
              <signal>PWD</signal>
              <arguments>test</arguments>
            </command>
            ]]>
          </data>
        </body>
      </message>
    </receive>

    <send endpoint="ftpXmlServer">
      <message>
        <body>
          <data>
            <![CDATA[
            <command-result xmlns="http://www.citrusframework.org/schema/ftp/message">
              <reply-code>257</reply-code>
              <reply-string>"/" is current directory</reply-string>
            </command-result>
            ]]>
          </data>
        </body>
      </message>
    </send>

    <receive endpoint="ftpXmlClient">
      <message>
        <body>
          <data>
            <![CDATA[
            <command-result xmlns="http://www.citrusframework.org/schema/ftp/message">
              <success>true</success>
              <reply-code>257</reply-code>
              <reply-string>@contains('is current directory')@</reply-string>
            </command-result>
            ]]>
          </data>
        </body>
      </message>
    </receive>
  </actions>
</test>
