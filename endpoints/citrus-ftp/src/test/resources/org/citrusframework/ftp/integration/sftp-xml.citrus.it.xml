<test name="SftpXmlIT" author="Christoph" status="FINAL"
      xmlns="http://citrusframework.org/schema/xml/testcase"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase
      http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Sample test in XML</description>
  <endpoints>
    <sftp>
      <server name="sftpXmlServer" port="22227"
              host-key-path="classpath:org/citrusframework/ssh/citrus.pem"
              user="admin" password="admin"
              user-home-path="target/sftp/user/admin"
              auto-connect="true"
              timeout="1000"
              auto-start="true"/>
    </sftp>
    <sftp>
      <client name="sftpXmlClient" host="localhost" port="22227"
              username="admin" password="admin"
              strict-host-checking="false"/>
    </sftp>
  </endpoints>
  <actions>
    <echo>
      <message>Test 1: Upload file to SFTP server</message>
    </echo>
    <send endpoint="sftpXmlClient" fork="true">
      <message>
        <body>
          <data><![CDATA[
            <command xmlns="http://www.citrusframework.org/schema/ftp/message">
              <signal>STOR</signal>
              <arguments>classpath:org/citrusframework/ftp/integration/hello.txt</arguments>
            </command>
          ]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="sftpXmlClient">
      <message>
        <body>
          <data><![CDATA[
            <put-command-result xmlns="http://www.citrusframework.org/schema/ftp/message">
              <success>true</success>
              <reply-code>226</reply-code>
              <reply-string>Transfer complete</reply-string>
            </put-command-result>
          ]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
