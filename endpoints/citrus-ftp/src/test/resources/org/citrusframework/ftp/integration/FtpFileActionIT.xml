<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="FtpFileActionIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test stores, retrieves and deletes files as Ftp client and server.</description>
  <actions>
    <echo>
      <message>Test: Receive Ftp request via server instance and send back response.</message>
    </echo>
    <echo>
      <message>Sending MKD command to FTP server</message>
    </echo>
    <send endpoint="ftpClient" fork="true">
      <message>
        <body>
          <payload>
            <ftp:command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:signal>MKD</ftp:signal>
              <ftp:arguments>test</ftp:arguments>
            </ftp:command>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:signal>MKD</ftp:signal>
              <ftp:arguments>test</ftp:arguments>
            </ftp:command>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
            </ftp:command-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpClient">
      <message>
        <body>
          <payload>
            <ftp:command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
              <ftp:reply-code>257</ftp:reply-code>
              <ftp:reply-string>257 "/test" created.</ftp:reply-string>
            </ftp:command-result>
          </payload>
        </body>
      </message>
    </receive>
    <echo>
      <message>Directory 'test' created on FTP server</message>
    </echo>
    <echo>
      <message>Sending store file command to FTP server</message>
    </echo>
    <send endpoint="ftpClient" fork="true">
      <message>
        <body>
          <payload>
            <ftp:put-command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:file path="ftp/hello.txt" type="ASCII"/>
              <ftp:target path="/test/hello.txt"/>
            </ftp:put-command>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:signal>PASV</ftp:signal>
            </ftp:command>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
            </ftp:command-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:signal>STOR</ftp:signal>
              <ftp:arguments>/test/hello.txt</ftp:arguments>
            </ftp:command>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
            </ftp:command-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpClient">
      <message>
        <body>
          <payload>
            <ftp:put-command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
              <ftp:reply-code>226</ftp:reply-code>
              <ftp:reply-string>@contains('Transfer complete')@</ftp:reply-string>
            </ftp:put-command-result>
          </payload>
        </body>
      </message>
    </receive>
    <echo>
      <message>Testing of store file command finished successfully</message>
    </echo>
    <echo>
      <message>Sending LIST command to FTP server</message>
    </echo>
    <send endpoint="ftpClient" fork="true">
      <message>
        <body>
          <payload>
            <ftp:list-command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:target path="/test"/>
            </ftp:list-command>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:signal>PASV</ftp:signal>
            </ftp:command>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
            </ftp:command-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:signal>LIST</ftp:signal>
              <ftp:arguments>/test</ftp:arguments>
            </ftp:command>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
            </ftp:command-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpClient">
      <message>
        <body>
          <payload>
            <ftp:list-command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
              <ftp:reply-code>226</ftp:reply-code>
              <ftp:reply-string>@contains('Closing data connection')@</ftp:reply-string>
              <ftp:files>
                <ftp:file path="hello.txt"/>
              </ftp:files>
            </ftp:list-command-result>
          </payload>
        </body>
      </message>
    </receive>
    <echo>
      <message>Testing of LIST command finished successfully</message>
    </echo>
    <echo>
      <message>Sending retrieve file command to FTP server</message>
    </echo>
    <send endpoint="ftpClient" fork="true">
      <message>
        <body>
          <payload>
            <ftp:get-command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:file path="/test/hello.txt" type="ASCII"/>
              <ftp:target path="target/ftp/hello.txt"/>
            </ftp:get-command>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:signal>PASV</ftp:signal>
            </ftp:command>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
            </ftp:command-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:signal>RETR</ftp:signal>
              <ftp:arguments>/test/hello.txt</ftp:arguments>
            </ftp:command>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
            </ftp:command-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpClient">
      <message>
        <body>
          <payload>
            <ftp:get-command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
              <ftp:reply-code>226</ftp:reply-code>
              <ftp:reply-string>@contains('Transfer complete')@</ftp:reply-string>
              <ftp:file path="target/ftp/hello.txt">
                <ftp:data>Hello FTP server!</ftp:data>
              </ftp:file>
            </ftp:get-command-result>
          </payload>
        </body>
      </message>
    </receive>
    <echo>
      <message>Testing of retrieve file command finished successfully</message>
    </echo>
    <echo>
      <message>Sending delete command to FTP server</message>
    </echo>
    <send endpoint="ftpClient" fork="true">
      <message>
        <body>
          <payload>
            <ftp:delete-command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:target path="/test"/>
            </ftp:delete-command>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:signal>CWD</ftp:signal>
              <ftp:arguments>/test</ftp:arguments>
            </ftp:command>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
            </ftp:command-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:signal>CWD</ftp:signal>
              <ftp:arguments>/test</ftp:arguments>
            </ftp:command>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
            </ftp:command-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:signal>PASV</ftp:signal>
            </ftp:command>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
            </ftp:command-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:signal>LIST</ftp:signal>
            </ftp:command>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
            </ftp:command-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:signal>CWD</ftp:signal>
              <ftp:arguments>/test/hello.txt</ftp:arguments>
            </ftp:command>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
            </ftp:command-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:signal>PASV</ftp:signal>
            </ftp:command>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
            </ftp:command-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:signal>LIST</ftp:signal>
              <ftp:arguments>/test/hello.txt</ftp:arguments>
            </ftp:command>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
            </ftp:command-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:signal>DELE</ftp:signal>
              <ftp:arguments>/test/hello.txt</ftp:arguments>
            </ftp:command>
          </payload>
        </body>
      </message>
    </receive>
    <send endpoint="ftpServer">
      <message>
        <body>
          <payload>
            <ftp:command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
            </ftp:command-result>
          </payload>
        </body>
      </message>
    </send>
    <receive endpoint="ftpClient">
      <message>
        <body>
          <payload>
            <ftp:delete-command-result xmlns:ftp="http://www.citrusframework.org/schema/ftp/message">
              <ftp:success>true</ftp:success>
              <ftp:reply-code>250</ftp:reply-code>
              <ftp:reply-string>@contains('250 Requested file action okay, deleted /test/hello.txt.')@</ftp:reply-string>
            </ftp:delete-command-result>
          </payload>
        </body>
      </message>
    </receive>
    <echo>
      <message>Testing of delete file command finished successfully</message>
    </echo>
  </actions>
</test>
