<extensions xmlns="http://maven.apache.org/EXTENSIONS/1.0.0"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://maven.apache.org/EXTENSIONS/1.0.0 http://maven.apache.org/xsd/core-extensions-1.0.0.xsd">
  <!--
    Restricts the reactor to modules touched by the current branch plus everything
    downstream of them. Inactive unless the `gib` profile is active, so local
    builds and `./mvnw clean install` keep building the full reactor.
  -->
  <extension>
    <groupId>io.github.gitflow-incremental-builder</groupId>
    <artifactId>gitflow-incremental-builder</artifactId>
    <version>4.5.1</version>
  </extension>
</extensions>
