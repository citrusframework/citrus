<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Jan Lipphaus" name="ScriptVariablesIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>This test shows the usage of inline scripts (e.g. groovy) for the creation of variable values.
      The result of the last operation in the script (e.g. return) will be the value for the variable.</description>
  <variables>
    <variable name="avg">
      <value>
        <script type="groovy">
            
                a = 4
                b = 6
                return (a + b) / 2
            
          </script>
      </value>
    </variable>
    <variable name="hello">
      <value>
        <script type="groovy">
            
                return "Hello Citrus"
            
          </script>
      </value>
    </variable>
    <variable name="sum">
      <value>
        <script type="groovy">
            
                (5 + 6)
            
          </script>
      </value>
    </variable>
  </variables>
  <actions>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="operation" value="Greetings"/>
        </headers>
        <body>
          <data><![CDATA[<xml>
              <message>${avg}</message>
              <message>${hello}</message>
              <message>${sum}</message>
              <message>${hello} ${avg}</message>
            </xml>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="operation" value="Greetings"/>
        </headers>
        <body>
          <data><![CDATA[<xml>
              <message>5</message>
              <message>Hello Citrus</message>
              <message>11</message>
              <message>Hello Citrus 5</message>
            </xml>]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
