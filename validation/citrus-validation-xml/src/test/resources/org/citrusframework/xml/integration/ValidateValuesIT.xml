<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="ValidateValuesIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Citrus"/>
  </variables>
  <actions>
    <send endpoint="helloEndpoint">
      <description>Send asynchronous hello request: Citrus -&gt; HelloService</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                   <MessageId>${messageId}</MessageId>
                   <CorrelationId>${correlationId}</CorrelationId>
                   <User>${user}</User>
                   <Text>Hello Citrus</Text>
               </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
      </message>
      <validate path="HelloRequest.MessageId" value="${messageId}"/>
      <validate path="HelloRequest.CorrelationId" value="${correlationId}"/>
      <validate path="HelloRequest.Text" value="citrus:concat('Hello ', ${user})"/>
    </receive>
  </actions>
</test>
