<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Simon Hofmann" name="UseXPathVariablesIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>This test shows how to extract variables using XPath expression stored in test variables.

            In this test a Citrus test variable is used to store an XPath expression.
            This variable is used to extract values from received payload.

            Using Citrus test variables to hold XPath expressions allows to define the XPath expression once and use it
            in several test cases.</description>
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="extractFromPath" value="//:HelloRequest/:User"/>
  </variables>
  <actions>
    <send endpoint="helloEndpoint">
      <description>Send asynchronous hello request: Citrus -&gt; HelloService</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                           <MessageId>${messageId}</MessageId>
                           <CorrelationId>${correlationId}</CorrelationId>
                           <User>Citrus</User>
                           <Text>Hello Citrus</Text>
                       </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message/>
      <validate path="HelloRequest.CorrelationId" value="${correlationId}"/>
      <extract>
        <header name="Operation" variable="${operation}"/>
        <header name="CorrelationId" variable="${id}"/>
        <body path="${extractFromPath}" variable="${user}"/>
      </extract>
    </receive>
    <echo>
      <message>${operation}</message>
    </echo>
    <trace-variables>
      <variable name="${id}"/>
      <variable name="${correlationId}"/>
      <variable name="${operation}"/>
      <variable name="${messageId}"/>
      <variable name="${user}"/>
    </trace-variables>
  </actions>
</test>
