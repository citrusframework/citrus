<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="ValidateXmlCombinedIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Citrus"/>
  </variables>
  <actions>
    <echo>
      <message>Test: Success with multiple validation mechanisms all together</message>
    </echo>
    <send endpoint="helloEndpoint">
      <description>Send asynchronous hello request: Citrus -&gt; HelloService</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                               <MessageId>${messageId}</MessageId>
                               <CorrelationId>${correlationId}</CorrelationId>
                               <User>${user}</User>
                               <Text>Hello Citrus</Text>
                           </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                               <MessageId>${messageId}</MessageId>
                               <CorrelationId>${correlationId}</CorrelationId>
                               <User>Citrus</User>
                               <Text>Hello ${user}</Text>
                           </HelloRequest>]]></data>
        </body>
      </message>
      <namespace prefix="pfx" value="http://citrusframework.org/schemas/samples/HelloService.xsd"/>
      <validate>
        <script type="groovy">
                            assert root.Text == 'Hello ${user}'
                        </script>
        <xpath expression="/pfx:HelloRequest/pfx:MessageId" value="${messageId}"/>
        <xpath expression="/pfx:HelloRequest/pfx:CorrelationId" value="${correlationId}"/>
        <xpath expression="/pfx:HelloRequest/pfx:Text" value="citrus:concat('Hello ', ${user})"/>
      </validate>
    </receive>
    <echo>
      <message>Test: Failure because of XML template data validation</message>
    </echo>
    <send endpoint="helloEndpoint">
      <description>Send asynchronous hello request: Citrus -&gt; HelloService</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                               <MessageId>${messageId}</MessageId>
                               <CorrelationId>${correlationId}</CorrelationId>
                               <User>${user}</User>
                               <Text>Hello Citrus</Text>
                           </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <receive endpoint="helloEndpoint">
          <message>
            <headers>
              <header name="Operation" value="sayHello"/>
              <header name="CorrelationId" value="${correlationId}"/>
            </headers>
            <body>
              <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                                     <MessageId>${messageId}</MessageId>
                                     <CorrelationId>${correlationId}</CorrelationId>
                                     <User>Wrong User</User>
                                     <Text>Hello ${user}</Text>
                                 </HelloRequest>]]></data>
            </body>
          </message>
          <namespace prefix="pfx" value="http://citrusframework.org/schemas/samples/HelloService.xsd"/>
          <validate>
            <script type="groovy">
                                  assert root.Text == 'Hello ${user}'
                              </script>
            <xpath expression="/pfx:HelloRequest/pfx:MessageId" value="${messageId}"/>
            <xpath expression="/pfx:HelloRequest/pfx:CorrelationId" value="${correlationId}"/>
            <xpath expression="/pfx:HelloRequest/pfx:Text" value="citrus:concat('Hello ', ${user})"/>
          </validate>
        </receive>
      </when>
    </assert>
    <echo>
      <message>Test: Failure because of XML groovy script validation</message>
    </echo>
    <send endpoint="helloEndpoint">
      <description>Send asynchronous hello request: Citrus -&gt; HelloService</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                               <MessageId>${messageId}</MessageId>
                               <CorrelationId>${correlationId}</CorrelationId>
                               <User>${user}</User>
                               <Text>Hello Citrus</Text>
                           </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException">
      <when>
        <receive endpoint="helloEndpoint">
          <message>
            <headers>
              <header name="Operation" value="sayHello"/>
              <header name="CorrelationId" value="${correlationId}"/>
            </headers>
            <body>
              <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                                     <MessageId>${messageId}</MessageId>
                                     <CorrelationId>${correlationId}</CorrelationId>
                                     <User>Citrus</User>
                                     <Text>Hello ${user}</Text>
                                 </HelloRequest>]]></data>
            </body>
          </message>
          <namespace prefix="pfx" value="http://citrusframework.org/schemas/samples/HelloService.xsd"/>
          <validate>
            <script type="groovy">
                                  assert root.Text == 'Something else'
                              </script>
            <xpath expression="/pfx:HelloRequest/pfx:MessageId" value="${messageId}"/>
            <xpath expression="/pfx:HelloRequest/pfx:CorrelationId" value="${correlationId}"/>
            <xpath expression="/pfx:HelloRequest/pfx:Text" value="citrus:concat('Hello ', ${user})"/>
          </validate>
        </receive>
      </when>
    </assert>
    <echo>
      <message>Test: Failure because of XML xpath validation</message>
    </echo>
    <send endpoint="helloEndpoint">
      <description>Send asynchronous hello request: Citrus -&gt; HelloService</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                               <MessageId>${messageId}</MessageId>
                               <CorrelationId>${correlationId}</CorrelationId>
                               <User>${user}</User>
                               <Text>Hello Citrus</Text>
                           </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <receive endpoint="helloEndpoint">
          <message>
            <headers>
              <header name="Operation" value="sayHello"/>
              <header name="CorrelationId" value="${correlationId}"/>
            </headers>
            <body>
              <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                                     <MessageId>${messageId}</MessageId>
                                     <CorrelationId>${correlationId}</CorrelationId>
                                     <User>Citrus</User>
                                     <Text>Hello ${user}</Text>
                                 </HelloRequest>]]></data>
            </body>
          </message>
          <namespace prefix="pfx" value="http://citrusframework.org/schemas/samples/HelloService.xsd"/>
          <validate>
            <script type="groovy">
                                  assert root.Text == 'Hello ${user}'
                              </script>
            <xpath expression="/pfx:HelloRequest/pfx:MessageId" value="${messageId}"/>
            <xpath expression="/pfx:HelloRequest/pfx:CorrelationId" value="${correlationId}"/>
            <xpath expression="/pfx:HelloRequest/pfx:Text" value="Something else"/>
          </validate>
        </receive>
      </when>
    </assert>
    <echo>
      <message>Test: Failure because of message header validation</message>
    </echo>
    <send endpoint="helloEndpoint">
      <description>Send asynchronous hello request: Citrus -&gt; HelloService</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                         <MessageId>${messageId}</MessageId>
                         <CorrelationId>${correlationId}</CorrelationId>
                         <User>${user}</User>
                         <Text>Hello Citrus</Text>
                     </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <receive endpoint="helloEndpoint">
          <message>
            <headers>
              <header name="Operation" value="wrongOperation"/>
              <header name="CorrelationId" value="${correlationId}"/>
            </headers>
            <body>
              <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                               <MessageId>${messageId}</MessageId>
                               <CorrelationId>${correlationId}</CorrelationId>
                               <User>Citrus</User>
                               <Text>Hello ${user}</Text>
                           </HelloRequest>]]></data>
            </body>
          </message>
          <namespace prefix="pfx" value="http://citrusframework.org/schemas/samples/HelloService.xsd"/>
          <validate>
            <script type="groovy">
                          assert root.Text == 'Hello ${user}'
                        </script>
            <xpath expression="/pfx:HelloRequest/pfx:MessageId" value="${messageId}"/>
            <xpath expression="/pfx:HelloRequest/pfx:CorrelationId" value="${correlationId}"/>
            <xpath expression="/pfx:HelloRequest/pfx:Text" value="citrus:concat('Hello ', ${user})"/>
          </validate>
        </receive>
      </when>
    </assert>
  </actions>
</test>
