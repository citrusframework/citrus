<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Thorsten Schlathoelter" name="XpathSegmentVariableExtractorIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Extract value from a xml stored as variable and send it with a different payload.</description>
  <variables>
    <variable name="xmlVar" value="&lt;Person&gt;&lt;Name&gt;Peter&lt;/Name&gt;&lt;/Person&gt;"/>
  </variables>
  <actions>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data><![CDATA[<OtherPerson><Name>${xmlVar.xpath(//Person/Name)}</Name></OtherPerson>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message>
        <body>
          <data><![CDATA[<OtherPerson><Name>Peter</Name></OtherPerson>]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
