<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="XMLValidationMatcherIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <variables>
    <variable name="greetingText" value="Hello Citrus"/>
  </variables>
  <actions>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data><![CDATA[<testRequestMessage>
                <text>citrus:cdataSection('<data>
                  <greeting>Hello Citrus</greeting>
                  <timestamp>2012-07-01T00:00:00</timestamp>
                </data>')</text>
              </testRequestMessage>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message>
        <body>
          <data><![CDATA[<testRequestMessage>
                <text>citrus:cdataSection('@matchesXml('<data>
                  <greeting>${greetingText}</greeting>
                  <timestamp>@ignore@</timestamp>
                </data>')@')</text>
              </testRequestMessage>]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
