<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="ValidateXMLDataIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <variables>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
    <variable name="user" value="Citrus"/>
  </variables>
  <actions>
    <send endpoint="helloEndpoint">
      <description>Send asynchronous hello request: Citrus -&gt; HelloService</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                               <MessageId>${messageId}</MessageId>
                               <CorrelationId>${correlationId}</CorrelationId>
                               <User>${user}</User>
                               <Text>Hello Citrus</Text>
                           </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                                <MessageId>_</MessageId>
                                <CorrelationId>_</CorrelationId>
                                <User>@equalsIgnoreCase('Citrus')@</User>
                                <Text>xxx</Text>
                            </HelloRequest>]]></data>
        </body>
        <expression path="HelloRequest.MessageId" value="${messageId}"/>
        <expression path="CorrelationId" value="${correlationId}"/>
      </message>
      <ignore path="HelloRequest.Text"/>
    </receive>
    <send endpoint="helloEndpoint">
      <description>Send asynchronous hello request: Citrus -&gt; HelloService</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                               <MessageId>${messageId}</MessageId>
                               <CorrelationId>${correlationId}</CorrelationId>
                               <User>${user}</User>
                               <Text>Hello Citrus</Text>
                           </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<ns0:HelloRequest xmlns:ns0="http://citrusframework.org/schemas/samples/HelloService.xsd">
                                <ns0:MessageId>_</ns0:MessageId>
                                <ns0:CorrelationId>_</ns0:CorrelationId>
                                <ns0:User>@containsIgnoreCase('ITRU')@</ns0:User>
                                <ns0:Text>xxx</ns0:Text>
                            </ns0:HelloRequest>]]></data>
        </body>
        <expression path="//ns0:HelloRequest/ns0:MessageId" value="${messageId}"/>
        <expression path="//ns0:HelloRequest/ns0:CorrelationId" value="${correlationId}"/>
      </message>
      <ignore path="//ns0:HelloRequest/ns0:Text"/>
      <namespace prefix="ns0" value="http://citrusframework.org/schemas/samples/HelloService.xsd"/>
    </receive>
    <send endpoint="helloEndpoint">
      <description>Send asynchronous hello request: Citrus -&gt; HelloService</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                               <MessageId>${messageId}</MessageId>
                               <CorrelationId>${correlationId}</CorrelationId>
                               <User>${user}</User>
                               <Text>Hello Citrus</Text>
                           </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message schema="helloSchema">
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                                <MessageId>${messageId}</MessageId>
                                <CorrelationId>${correlationId}</CorrelationId>
                                <User>@equalsIgnoreCase('Citrus')@</User>
                                <Text>@ignore@</Text>
                            </HelloRequest>]]></data>
        </body>
      </message>
    </receive>
    <send endpoint="helloEndpoint">
      <description>Send asynchronous hello request: Citrus -&gt; HelloService</description>
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                               <MessageId>${messageId}</MessageId>
                               <CorrelationId>${correlationId}</CorrelationId>
                               <User>${user}</User>
                               <Text>Hello Citrus</Text>
                           </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message schema-repository="helloSchemaRepository">
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                                <MessageId>${messageId}</MessageId>
                                <CorrelationId>${correlationId}</CorrelationId>
                                <User>@equalsIgnoreCase('Citrus')@</User>
                                <Text>@ignore@</Text>
                            </HelloRequest>]]></data>
        </body>
      </message>
    </receive>
  </actions>
</test>
