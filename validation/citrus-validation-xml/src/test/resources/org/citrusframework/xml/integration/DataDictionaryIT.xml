<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="DataDictionaryIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>This test shows how to use data dictionaries.</description>
  <variables>
    <variable name="user" value="Citrus"/>
    <variable name="correlationId" value="citrus:randomNumber(10)"/>
    <variable name="messageId" value="citrus:randomNumber(10)"/>
  </variables>
  <actions>
    <send endpoint="helloEndpoint">
      <description>Send asynchronous hello request: Citrus -&gt; HelloService</description>
      <message data-dictionary="helloServiceDataDictionary">
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="CorrelationId" value="${correlationId}"/>
        </headers>
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                   <MessageId>0</MessageId>
                   <CorrelationId>0</CorrelationId>
                   <User></User>
                   <Text></Text>
               </HelloRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message data-dictionary="helloServiceDataDictionary">
        <body>
          <data><![CDATA[<HelloRequest xmlns="http://citrusframework.org/schemas/samples/HelloService.xsd">
                   <MessageId>0</MessageId>
                   <CorrelationId>0</CorrelationId>
                   <User></User>
                   <Text></Text>
               </HelloRequest>]]></data>
        </body>
      </message>
      <extract>
        <header name="Operation" variable="${operation}"/>
        <header name="CorrelationId" variable="${id}"/>
        <body path="//:HelloRequest/:User" variable="${user}"/>
      </extract>
    </receive>
    <echo>
      <message>${operation}</message>
    </echo>
    <trace-variables>
      <variable name="${id}"/>
      <variable name="${correlationId}"/>
      <variable name="${operation}"/>
      <variable name="${messageId}"/>
      <variable name="${user}"/>
    </trace-variables>
  </actions>
</test>
