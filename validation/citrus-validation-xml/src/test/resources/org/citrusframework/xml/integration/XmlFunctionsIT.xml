<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Unknown" name="XmlFunctionsIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>This test shows the usage of xml functions as variable values</description>
  <variables>
    <variable name="cdata" value="citrus:cdataSection('Hallo Test Framework')"/>
  </variables>
  <actions>
    <echo>
      <message>
          
              citrus:escapeXml('&lt;!-- This is a XML comment --&gt;&lt;Message&gt;Hallo Test Framework&lt;/Message&gt;')
          
        </message>
    </echo>
    <trace-variables/>
  </actions>
</test>
