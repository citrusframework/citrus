<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="ValidateNamespacesIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <actions>
    <echo>
      <message>Test: Success with single namespace validation</message>
    </echo>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data><![CDATA[<trq:TestRequest xmlns:trq="http://citrusframework.org/schemas/test">
                            <Message>Hello</Message>
                        </trq:TestRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint" timeout="5000">
      <message schema-validation="false">
        <body>
          <data><![CDATA[<trq:TestRequest xmlns:trq="http://citrusframework.org/schemas/test">
                            <Message>Hello</Message>
                        </trq:TestRequest>]]></data>
        </body>
      </message>
      <validate>
        <namespace prefix="trq" value="http://citrusframework.org/schemas/test"/>
      </validate>
    </receive>
    <echo>
      <message>Test: Success with multiple namespace validations</message>
    </echo>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data><![CDATA[<trq:TestRequest xmlns:trq="http://citrusframework.org/schemas/test"
                                         xmlns:msg="http://citrusframework.org/schemas/message">
                            <msg:Message>Hello</msg:Message>
                        </trq:TestRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint" timeout="5000">
      <message schema-validation="false">
        <body>
          <data><![CDATA[<trq:TestRequest xmlns:trq="http://citrusframework.org/schemas/test"
                                         xmlns:msg="http://citrusframework.org/schemas/message">
                            <msg:Message>Hello</msg:Message>
                        </trq:TestRequest>]]></data>
        </body>
      </message>
      <validate>
        <namespace prefix="trq" value="http://citrusframework.org/schemas/test"/>
        <namespace prefix="msg" value="http://citrusframework.org/schemas/message"/>
      </validate>
    </receive>
    <echo>
      <message>Test: Success with multiple nested namespace validations</message>
    </echo>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data><![CDATA[<trq:TestRequest xmlns:trq="http://citrusframework.org/schemas/test">
                            <msg:Message xmlns:msg="http://citrusframework.org/schemas/message">Hello</msg:Message>
                        </trq:TestRequest>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint" timeout="5000">
      <message schema-validation="false">
        <body>
          <data><![CDATA[<trq:TestRequest xmlns:trq="http://citrusframework.org/schemas/test">
                            <msg:Message xmlns:msg="http://citrusframework.org/schemas/message">Hello</msg:Message>
                        </trq:TestRequest>]]></data>
        </body>
      </message>
      <validate>
        <namespace prefix="trq" value="http://citrusframework.org/schemas/test"/>
        <namespace prefix="msg" value="http://citrusframework.org/schemas/message"/>
      </validate>
    </receive>
    <echo>
      <message>Test: Failure because of missing namespace</message>
    </echo>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data><![CDATA[<trq:TestRequest xmlns:trq="http://citrusframework.org/schemas/test">
                            <Message>Hello</Message>
                        </trq:TestRequest>]]></data>
        </body>
      </message>
    </send>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <receive endpoint="helloEndpoint" timeout="5000">
          <message schema-validation="false"/>
          <validate>
            <namespace prefix="trq" value="http://citrusframework.org/schemas/test"/>
            <namespace prefix="missing" value="http://citrusframework.org/schemas/missing"/>
          </validate>
        </receive>
      </when>
    </assert>
    <echo>
      <message>Test: Failure because of wrong namespace prefix</message>
    </echo>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data><![CDATA[<wrong:TestRequest xmlns:wrong="http://citrusframework.org/schemas/test">
                            <Message>Hello</Message>
                        </wrong:TestRequest>]]></data>
        </body>
      </message>
    </send>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <receive endpoint="helloEndpoint" timeout="5000">
          <message schema-validation="false"/>
          <validate>
            <namespace prefix="trq" value="http://citrusframework.org/schemas/test"/>
          </validate>
        </receive>
      </when>
    </assert>
    <echo>
      <message>Test: Failure because of wrong namespace uri</message>
    </echo>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data><![CDATA[<trq:TestRequest xmlns:trq="http://citrusframework.org/schemas/wrong">
                            <Message>Hello</Message>
                        </trq:TestRequest>]]></data>
        </body>
      </message>
    </send>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <receive endpoint="helloEndpoint" timeout="5000">
          <message schema-validation="false"/>
          <validate>
            <namespace prefix="trq" value="http://citrusframework.org/schemas/test"/>
          </validate>
        </receive>
      </when>
    </assert>
  </actions>
</test>
