<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="PlainTextValidationIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Send plain text as message payload. Here we use custom data format to send it over
			HTTP to a server and receive simple plain text as response.</description>
  <actions>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data>Hello, World!</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message type="plaintext">
        <body>
          <data>Hello, World!</data>
        </body>
      </message>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data>Hello, World!</data>
        </body>
      </message>
    </send>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <receive endpoint="helloEndpoint">
          <message type="plaintext">
            <body>
              <data>Hello Citrus!</data>
            </body>
          </message>
        </receive>
      </when>
    </assert>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data/>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message type="plaintext">
        <body>
          <data/>
        </body>
      </message>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data/>
        </body>
      </message>
    </send>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <receive endpoint="helloEndpoint">
          <message type="plaintext">
            <body>
              <data>Hello Citrus!</data>
            </body>
          </message>
        </receive>
      </when>
    </assert>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
        </headers>
        <body>
          <data>Hello, Citrus!</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message type="plaintext">
        <headers>
          <header name="Operation" value="sayHello"/>
        </headers>
      </message>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
        </headers>
        <body>
          <data>Hello, Citrus!</data>
        </body>
      </message>
    </send>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <receive endpoint="helloEndpoint">
          <message type="plaintext">
            <headers>
              <header name="Operation" value="sayHi"/>
            </headers>
          </message>
        </receive>
      </when>
    </assert>
  </actions>
</test>
