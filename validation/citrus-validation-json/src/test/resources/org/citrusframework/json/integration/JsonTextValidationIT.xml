<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="JsonTextValidationIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Send plain text as message payload. Here we use custom data format to send it over
      HTTP to a server and receive simple plain text as response.</description>
  <actions>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data>{
              "type" : "read",
              "mbean" : "java.lang:type=Memory",
              "attribute" : "HeapMemoryUsage",
              "path" : "used"
            }</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message>
        <body>
          <data>{
              "type" : "read",
              "mbean" : "java.lang:type=Memory",
              "attribute" : "HeapMemoryUsage",
              "path" : "@equalsIgnoreCase('USED')@"
            }</data>
        </body>
      </message>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data>{
              "timestamp" : "2011-01-01",
              "status" : 200,
              "request" :
                {
                  "mbean" : "java.lang:type=Memory",
                  "path" : "used",
                  "attribute" : "HeapMemoryUsage",
                  "type" : "read"
                },
              "value" : "512"
            }</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message>
        <body>
          <data>{
              "timestamp" : "@matchesDatePattern('yyyy-MM-dd')@",
              "status" : 200,
              "request" :
                {
                  "mbean" : "java.lang:type=Memory",
                  "path" : "@matches('u*s*e*d*')@",
                  "attribute" : "HeapMemoryUsage",
                  "type" : "read"
                },
              "value" : "@isNumber()@"
            }</data>
        </body>
      </message>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data/>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message type="json">
        <body>
          <data/>
        </body>
      </message>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
        </headers>
        <body>
          <data>{
              "type" : "read",
              "mbean" : "java.lang:type=Memory",
              "attribute" : "HeapMemoryUsage",
              "path" : "used"
            }</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message type="json">
        <headers>
          <header name="Operation" value="sayHello"/>
        </headers>
      </message>
    </receive>
  </actions>
</test>
