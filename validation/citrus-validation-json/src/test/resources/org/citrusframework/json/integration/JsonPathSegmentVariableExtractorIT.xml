<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Thorsten Schlathoelter" name="JsonPathSegmentVariableExtractorIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Extract value from a json stored as variable and send it with a different payload.</description>
  <variables>
    <variable name="jsonVar" value="{&quot;Person&quot; : &quot;Peter&quot;}"/>
  </variables>
  <actions>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data>{
                           "Friend" : "${jsonVar.jsonPath($.Person)}"
                        }</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message>
        <body>
          <data>{
                        "Friend" : "Peter"
                        }</data>
        </body>
      </message>
    </receive>
  </actions>
</test>
