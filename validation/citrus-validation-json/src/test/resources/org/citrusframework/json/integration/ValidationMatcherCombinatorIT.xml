<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Citrus" name="ValidationMatcherCombinatorIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Integration tests for allOf, anyOf, not combinator validation matchers in YAML and XML DSL.</description>
  <actions>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data>{
                "value": "hello world"
              }</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message>
        <body>
          <data>{
                "value": "@allOf(startsWith('hello'), endsWith('world'), contains('lo wo'))@"
              }</data>
        </body>
      </message>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data>{
                "status": "success"
              }</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message>
        <body>
          <data>{
                "status": "@anyOf(equalsIgnoreCase('ok'), equalsIgnoreCase('success'))@"
              }</data>
        </body>
      </message>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data>{
                "msg": "hello citrus"
              }</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message>
        <body>
          <data>{
                "msg": "@not(contains('error'))@"
              }</data>
        </body>
      </message>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data>{
                "result": "foo-ok"
              }</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message>
        <body>
          <data>{
                "result": "@allOf(anyOf(startsWith('foo'), startsWith('bar')), not(contains('error')))@"
              }</data>
        </body>
      </message>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <body>
          <data>{
                "code": "200",
                "message": "Request processed successfully"
              }</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message/>
      <validate path="$.code" value="@allOf(notEmpty(), matches('[0-9]+'))@"/>
      <validate path="$.message" value="@anyOf(startsWith('Request'), startsWith('Response'))@"/>
    </receive>
  </actions>
</test>
