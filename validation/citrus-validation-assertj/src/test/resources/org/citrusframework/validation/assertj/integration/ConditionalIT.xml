<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Citrus" name="ConditionalIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Conditional with @assertj()@ expressions</description>
  <variables>
    <variable name="failMessage" value="Something went wrong!"/>
    <variable name="shouldExecute" value="true"/>
    <variable name="number" value="10"/>
  </variables>
  <actions>
    <conditional when="@assertj('${shouldExecute}', 'asBoolean().isFalse()')@">
      <actions>
        <fail message="${failMessage}"/>
      </actions>
    </conditional>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException">
      <when>
        <conditional when="@assertj('${number}', 'asInt().isEqualTo(10)')@">
          <actions>
            <fail message="${failMessage}"/>
          </actions>
        </conditional>
      </when>
    </assert>
  </actions>
</test>
