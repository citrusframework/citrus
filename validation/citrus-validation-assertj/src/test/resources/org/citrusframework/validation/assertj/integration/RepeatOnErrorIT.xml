<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Citrus" name="RepeatOnErrorIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Repeat on error until an @assertj()@ condition holds</description>
  <variables>
    <variable name="message" value="Hello TestFramework"/>
  </variables>
  <actions>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException">
      <when>
        <repeat-on-error auto-sleep="50" index="i" until="@assertj(asInt().isEqualTo(3))@">
          <actions>
            <echo>
              <message>${i}. attempt: ${message}</message>
            </echo>
            <fail/>
          </actions>
        </repeat-on-error>
      </when>
    </assert>
  </actions>
</test>
