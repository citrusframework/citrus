<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Citrus" name="AssertIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Assert an exception message with @assertj()@</description>
  <actions>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException" message="@assertj(startsWith('Something').contains('went wrong'))@">
      <when>
        <fail message="Something went wrong!"/>
      </when>
    </assert>
  </actions>
</test>
