<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Citrus" name="AssertJValidationMatcherIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Tests the @assertj()@ validation matcher on headers, XPath and JSONPath values</description>
  <variables>
    <variable name="prefix" value="OK"/>
  </variables>
  <actions>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
          <header name="Count" value="42"/>
        </headers>
        <body>
          <data><![CDATA[<Order><Status>OK-123</Status><Item>a</Item><Item>b</Item><Item>c</Item></Order>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="@assertj(isIn('sayHello', 'sayHi'))@"/>
          <header name="Count" value="@assertj(asInt().isBetween(40, 50))@"/>
        </headers>
      </message>
      <validate>
        <xpath expression="/Order/Status" value="@assertj(isNotBlank().startsWith('${prefix}').endsWith('123'))@"/>
        <xpath expression="/Order/Item" result-type="node-set" value="@assertj(asList().hasSize(3).contains('b'))@"/>
        <xpath expression="count(/Order/Item)" result-type="number" value="@assertj(asDouble().isEqualTo(3))@"/>
      </validate>
    </receive>
    <send endpoint="helloEndpoint">
      <message type="json">
        <body>
          <data>{ "qty": 7, "status": "OK-1", "tags": ["a", "b"] }</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message type="json"/>
      <validate>
        <json-path expression="$.qty" value="@assertj(asInt().isBetween(1, 10))@"/>
        <json-path expression="$.status" value="@assertj('${prefix}-1', 'startsWith('OK').endsWith('1')')@"/>
        <json-path expression="$.tags" value="@assertj(asList().containsExactly('a', 'b'))@"/>
      </validate>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHowdy"/>
        </headers>
        <body>
          <data>Hello Citrus!</data>
        </body>
      </message>
    </send>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <receive endpoint="helloEndpoint">
          <message type="plaintext">
            <headers>
              <header name="Operation" value="@assertj(isIn('sayHello', 'sayHi'))@"/>
            </headers>
            <body>
              <data>Hello Citrus!</data>
            </body>
          </message>
        </receive>
      </when>
    </assert>
  </actions>
</test>
