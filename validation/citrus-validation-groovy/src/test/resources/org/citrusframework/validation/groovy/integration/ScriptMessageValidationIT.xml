<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="ScriptMessageValidationIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test sends messages to a message channel and receives these messages performing script validation.</description>
  <actions>
    <echo>
      <message>Test script validation success</message>
    </echo>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
        </headers>
        <body>
          <data>Hello Citrus</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message type="plaintext"/>
      <validate>
        <script type="groovy">
              assert receivedMessage.payload.equals("Hello Citrus");
              assert receivedMessage.headers.get("Operation").equals("sayHello");
            </script>
      </validate>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
        </headers>
        <body>
          <data><![CDATA[<Text>Hello Citrus</Text>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message type="xml"/>
      <validate>
        <script type="groovy"><![CDATA[
            
              assert receivedMessage.payload.equals("<Text>Hello Citrus</Text>");
              assert receivedMessage.headers.get("Operation").equals("sayHello");
            
            ]]></script>
      </validate>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
        </headers>
        <body>
          <data>{"text": "Hello Citrus"}</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message type="json"/>
      <validate>
        <script type="groovy">
              
                assert receivedMessage.payload.equals('{"text": "Hello Citrus"}');
                assert receivedMessage.headers.get("Operation").equals("sayHello");
              
            </script>
      </validate>
    </receive>
    <echo>
      <message>Test script validation success - auto select message type</message>
    </echo>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
        </headers>
        <body>
          <data/>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message/>
      <validate>
        <script type="groovy">
              assert receivedMessage.payload.equals("");
              assert receivedMessage.headers.get("Operation").equals("sayHello");
            </script>
      </validate>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
        </headers>
        <body>
          <data>Hello Citrus</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message/>
      <validate>
        <script type="groovy">
              assert receivedMessage.payload.equals("Hello Citrus");
              assert receivedMessage.headers.get("Operation").equals("sayHello");
            </script>
      </validate>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
        </headers>
        <body>
          <data><![CDATA[<Text>Hello Citrus</Text>]]></data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message/>
      <validate>
        <script type="groovy"><![CDATA[
              
              assert receivedMessage.payload.equals("<Text>Hello Citrus</Text>");
              assert receivedMessage.headers.get("Operation").equals("sayHello");
            
            ]]></script>
      </validate>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
        </headers>
        <body>
          <data>{"text": "Hello Citrus"}</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message/>
      <validate>
        <script type="groovy">
              
                assert receivedMessage.payload.equals('{"text": "Hello Citrus"}');
                assert receivedMessage.headers.get("Operation").equals("sayHello");
              
            </script>
      </validate>
    </receive>
    <echo>
      <message>Test script validation errors</message>
    </echo>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
        </headers>
        <body>
          <data>Hello Citrus</data>
        </body>
      </message>
    </send>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <receive endpoint="helloEndpoint">
          <message type="plaintext"/>
          <validate>
            <script type="groovy">
                  assert receivedMessage.payload.equals("Goodbye Citrus");
                  assert receivedMessage.headers.get("Operation").equals("sayHello");
                </script>
          </validate>
        </receive>
      </when>
    </assert>
    <send endpoint="helloEndpoint">
