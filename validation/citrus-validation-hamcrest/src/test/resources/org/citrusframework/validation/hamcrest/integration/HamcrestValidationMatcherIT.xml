<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Christoph Deppisch" name="HamcrestValidationMatcherIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Tests the @assertThat()@ validator</description>
  <actions>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHello"/>
        </headers>
        <body>
          <data>Hello Citrus!</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message type="plaintext">
        <headers>
          <header name="Operation" value="@assertThat(endsWith(Hello))@"/>
        </headers>
        <body>
          <data>Hello Citrus!</data>
        </body>
      </message>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHi"/>
        </headers>
        <body>
          <data>Hello Citrus!</data>
        </body>
      </message>
    </send>
    <receive endpoint="helloEndpoint">
      <message type="plaintext">
        <headers>
          <header name="Operation" value="@assertThat(anyOf(is(sayHello), is(sayHi)))@"/>
        </headers>
        <body>
          <data>Hello Citrus!</data>
        </body>
      </message>
    </receive>
    <send endpoint="helloEndpoint">
      <message>
        <headers>
          <header name="Operation" value="sayHowdy"/>
        </headers>
        <body>
          <data>Hello Citrus!</data>
        </body>
      </message>
    </send>
    <assert exception="org.citrusframework.exceptions.ValidationException">
      <when>
        <receive endpoint="helloEndpoint">
          <message type="plaintext">
            <headers>
              <header name="Operation" value="@assertThat(anyOf(is(sayHello), is(sayHi)))@"/>
            </headers>
            <body>
              <data>Hello Citrus!</data>
            </body>
          </message>
        </receive>
      </when>
    </assert>
  </actions>
</test>
