<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Unknown" name="RepeatOnErrorIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test of repeat-on-error iteration</description>
  <variables>
    <variable name="message" value="Hello TestFramework"/>
  </variables>
  <actions>
    <assert exception="org.citrusframework.exceptions.CitrusRuntimeException">
      <when>
        <repeat-on-error auto-sleep="250" index="i" until="@assertThat(is(3))@">
          <actions>
            <echo>
              <message>${i}. Versuch: ${message}</message>
            </echo>
            <fail/>
          </actions>
        </repeat-on-error>
      </when>
    </assert>
  </actions>
</test>
