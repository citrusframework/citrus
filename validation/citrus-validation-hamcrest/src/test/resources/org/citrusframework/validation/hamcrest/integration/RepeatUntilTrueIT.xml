<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Unknown" name="RepeatUntilTrueIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test of repeating loops</description>
  <variables>
    <variable name="max" value="3"/>
  </variables>
  <actions>
    <repeat index="i" until="@assertThat(greaterThanOrEqualTo(5))@">
      <actions>
        <echo>
          <message>index is: ${i}</message>
        </echo>
      </actions>
    </repeat>
    <repeat index="i" until="@assertThat('${i}', 'greaterThanOrEqualTo(5)')@">
      <actions>
        <echo>
          <message>index is: ${i}</message>
        </echo>
      </actions>
    </repeat>
  </actions>
</test>
