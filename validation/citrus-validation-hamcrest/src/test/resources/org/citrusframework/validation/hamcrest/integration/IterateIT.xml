<?xml version="1.0" encoding="UTF-8"?>
<test xmlns="http://citrusframework.org/schema/xml/testcase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" author="Unknown" name="IterateIT" status="FINAL" xsi:schemaLocation="http://citrusframework.org/schema/xml/testcase http://citrusframework.org/schema/xml/testcase/citrus-testcase.xsd">
  <description>Test of iterating loops</description>
  <variables>
    <variable name="max" value="3"/>
  </variables>
  <actions>
    <iterate condition="@assertThat(lessThan(5))@" index="i">
      <actions>
        <echo>
          <message>index is: ${i}</message>
        </echo>
      </actions>
    </iterate>
    <iterate condition="@assertThat('${i}', 'lessThan(5)')@" index="i">
      <actions>
        <echo>
          <message>index is: ${i}</message>
        </echo>
      </actions>
    </iterate>
  </actions>
</test>
